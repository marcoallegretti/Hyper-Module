import { Button, ComboBox, LineEdit, ListView, Slider } from "std-widgets.slint";

export enum AppMode {
    discovering,
    closed,
    selecting,
    creating,
    opening,
    starting-output-test,
    output-testing,
    stopping-output-test,
    running,
    adding-track,
    removing-track,
    renaming-track,
    changing-track-activation,
    adding-arrangement-placement,
    duplicating-arrangement-placement,
    splitting-arrangement-placement,
    changing-arrangement-activation,
    moving-arrangement-placement,
    trimming-arrangement-placement,
    removing-arrangement-placement,
    renaming-clip,
    duplicating-clip,
    changing-clip-activation,
    changing-clip-gain,
    changing-clip-fades,
    changing-clip-loop,
    changing-clip-reverse,
    changing-clip-source,
    creating-clip,
    preparing-preview,
    previewing,
    saving,
    preparing-recording,
    recording,
    finalizing-recording,
    closing,
    unavailable,
}

export struct SceneRow {
    index: int,
    name: string,
    display-name: string,
    availability: string,
    launchable: bool,
}

export struct MixerChannelRow {
    index: int,
    track-id: string,
    name: string,
    display-name: string,
    kind: string,
    state-available: bool,
    gain-percent: float,
    pan-percent: float,
    muted: bool,
    solo: bool,
    solo-available: bool,
    renameable: bool,
    removable: bool,
    active: bool,
    activation-toggleable: bool,
}

export struct MixerSendRow {
    index: int,
    channel-index: int,
    send-index: int,
    source-name: string,
    target-name: string,
    tap: string,
    state-available: bool,
    gain-percent: float,
    pan-percent: float,
    enabled: bool,
}

export struct TakeRow {
    index: int,
    track-name: string,
    captured-at: string,
    detail: string,
    timeline-start: string,
    active: bool,
    state: string,
}

export struct ArrangementRow {
    index: int,
    id: string,
    track-name: string,
    clip-name: string,
    start-tick: string,
    clip-start-tick: string,
    duration-ticks: string,
    start-clock: string,
    end-clock: string,
    start-percent: float,
    width-percent: float,
    enabled: bool,
    active: bool,
}

export struct ClipRow {
    id: string,
    name: string,
    track-name: string,
    duration-ticks: string,
    source-start-edit: string,
    source-frame-count: string,
    active: bool,
    gain-label: string,
    gain-edit: string,
    loop-enabled: bool,
    loop-label: string,
    loop-start-edit: string,
    loop-end-edit: string,
    reverse: bool,
    direction-label: string,
    fade-label: string,
    fade-in-edit: string,
    fade-out-edit: string,
}

export global IdeActions {
    callback retry-discovery();
    callback refresh-outputs();
    callback select-output(int);
    callback start-output-test();
    callback stop-output-test();
    callback refresh-inputs();
    callback select-input(int);
    callback monitor-gain(float);
    callback monitor-mute();
    callback create-project(string);
    callback choose-project();
    callback transport-start();
    callback transport-stop();
    callback transport-return-start();
    callback transport-seek(float);
    callback locate-placement(int);
    callback set-arrangement-placement-active(int, bool);
    callback move-arrangement-placement(string, string);
    callback set-arrangement-placement-duration(string, string);
    callback trim-arrangement-placement-front(string, string);
    callback remove-arrangement-placement(string);
    callback add-arrangement-placement(string, string);
    callback duplicate-arrangement-placement(string, string);
    callback split-arrangement-placement(string, string);
    callback rename-audio-clip(string, string);
    callback duplicate-audio-clip(string, string);
    callback set-audio-clip-active(string, bool);
    callback set-audio-clip-gain(string, string);
    callback set-audio-clip-fades(string, string, string);
    callback set-audio-clip-loop(string, bool, string, string);
    callback set-audio-clip-reverse(string, bool);
    callback set-audio-clip-source-start(string, string);
    callback loudness-run();
    callback loudness-standby();
    callback loudness-reset();
    callback launch-scene(int);
    callback mixer-channel-gain(int, float);
    callback mixer-channel-pan(int, float);
    callback mixer-channel-mute(int);
    callback mixer-channel-solo(int);
    callback mixer-main-gain(float);
    callback mixer-main-mute();
    callback mixer-send-gain(int, float);
    callback mixer-send-pan(int, float);
    callback mixer-send-enabled(int);
    callback save-project();
    callback add-audio-track(string);
    callback remove-audio-track(string);
    callback rename-audio-track(int, string);
    callback set-audio-track-active(int, bool);
    callback start-recording();
    callback stop-recording();
    callback abort-recording();
    callback toggle-take-preview(int);
    callback create-audio-clip-from-take(int, string);
    callback preview-gain(float);
    callback preview-mute();
    callback close-project();
}

component Panel inherits Rectangle {
    background: #141a22;
    border-color: #27313d;
    border-width: 1px;
    border-radius: 8px;
}

component Meter inherits Rectangle {
    in property <float> level: 0;
    in property <string> channel-name;
    in property <string> reading: "—";

    background: #090d12;
    border-color: #27313d;
    border-width: 1px;
    border-radius: 5px;

    Rectangle {
        x: 5px;
        y: 5px + (parent.height - 34px) * (1 - root.level);
        width: parent.width - 10px;
        height: (parent.height - 34px) * root.level;
        border-radius: 3px;
        background: root.level > 0.92 ? #ff5a55 : root.level > 0.72 ? #f5b83d : #3ddc97;
    }

    Text {
        x: 0;
        y: parent.height - 25px;
        width: parent.width;
        text: root.channel-name;
        color: #95a3b5;
        font-size: 11px;
        horizontal-alignment: center;
    }

    Text {
        x: 0;
        y: 8px;
        width: parent.width;
        text: root.reading;
        color: #e7edf5;
        font-size: 11px;
        horizontal-alignment: center;
    }
}

component LoudnessCard inherits Rectangle {
    in property <string> label;
    in property <string> value: "—";
    in property <string> detail;
    in property <bool> primary: false;

    background: root.primary ? #102536 : #0e141b;
    border-color: root.primary ? #37769a : #27313d;
    border-width: 1px;
    border-radius: 6px;

    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        Text { text: root.label; color: #65758a; font-size: 9px; font-weight: 700; letter-spacing: 0.6px; }
        Text { text: root.value; color: root.primary ? #edf2f8 : #dce5ef; font-size: root.primary ? 23px : 18px; font-weight: 600; overflow: elide; }
        Text { text: root.detail; color: #8290a2; font-size: 9px; overflow: elide; }
    }
}

export component MainWindow inherits Window {
    title: "Hyper Module — Desktop IDE";
    width: 1180px;
    height: 800px;
    background: #0b0f14;

    in property <AppMode> app-mode: AppMode.discovering;
    in property <[string]> output-names: [];
    in-out property <int> selected-output-index: 0;
    in property <[string]> input-names: ["Input cue off"];
    in-out property <int> selected-input-index: 0;
    in property <bool> input-discovery-available: false;
    in property <bool> monitoring-active: false;
    in property <float> monitoring-gain-percent: 0;
    in property <bool> monitoring-muted: false;
    in property <string> monitoring-state: "Off";
    in property <string> monitoring-frame-count: "0";
    in property <string> monitoring-drop-count: "0";
    in property <string> monitoring-underflow-count: "0";
    in property <string> project-location: "No project selected";
    in property <string> project-name: "No project open";
    in-out property <bool> new-project-visible: false;
    in-out property <string> new-project-name: "Untitled Project";
    in property <string> project-id: "—";
    in property <string> sample-rate: "—";
    in property <string> scene-count: "—";
    in property <int> track-count: 0;
    in property <[SceneRow]> scenes: [];
    in-out property <bool> mixer-visible: false;
    in-out property <bool> new-track-visible: false;
    in-out property <string> new-track-name: "Audio 2";
    in-out property <bool> rename-track-visible: false;
    in-out property <int> rename-track-index: -1;
    in-out property <string> rename-track-original-name: "";
    in-out property <string> rename-track-name: "";
    in-out property <bool> remove-track-visible: false;
    in-out property <string> remove-track-id: "";
    in-out property <string> remove-track-name: "";
    in-out property <bool> mixer-sends-visible: false;
    in-out property <bool> takes-visible: false;
    in-out property <bool> take-clip-visible: false;
    in-out property <int> take-clip-index: -1;
    in-out property <string> take-clip-track-name: "";
    in-out property <string> take-clip-name: "";
    in-out property <bool> arrangement-visible: false;
    in-out property <bool> remove-arrangement-placement-visible: false;
    in-out property <string> remove-arrangement-placement-id: "";
    in-out property <string> remove-arrangement-placement-clip-name: "";
    in-out property <string> remove-arrangement-placement-track-name: "";
    in-out property <bool> clips-visible: false;
    in-out property <bool> clip-rename-visible: false;
    in-out property <string> clip-rename-id: "";
    in-out property <string> clip-rename-original: "";
    in-out property <string> clip-rename-name: "";
    in-out property <bool> clip-duplicate-visible: false;
    in-out property <string> clip-duplicate-id: "";
    in-out property <string> clip-duplicate-source-name: "";
    in-out property <string> clip-duplicate-name: "";
    in-out property <bool> clip-gain-visible: false;
    in-out property <string> clip-gain-id: "";
    in-out property <string> clip-gain-name: "";
    in-out property <string> clip-gain-original: "";
    in-out property <string> clip-gain-value: "";
    in-out property <bool> clip-fades-visible: false;
    in-out property <string> clip-fades-id: "";
    in-out property <string> clip-fades-name: "";
    in-out property <string> clip-fades-duration: "";
    in-out property <string> clip-fades-original-in: "";
    in-out property <string> clip-fades-original-out: "";
    in-out property <string> clip-fades-in: "";
    in-out property <string> clip-fades-out: "";
    in-out property <bool> clip-loop-visible: false;
    in-out property <string> clip-loop-id: "";
    in-out property <string> clip-loop-name: "";
    in-out property <string> clip-loop-duration: "";
    in-out property <bool> clip-loop-original-enabled: false;
    in-out property <string> clip-loop-original-start: "";
    in-out property <string> clip-loop-original-end: "";
    in-out property <bool> clip-loop-enabled: false;
    in-out property <string> clip-loop-start: "";
    in-out property <string> clip-loop-end: "";
    in-out property <bool> clip-source-slip-visible: false;
    in-out property <string> clip-source-slip-id: "";
    in-out property <string> clip-source-slip-name: "";
    in-out property <string> clip-source-slip-frame-count: "";
    in-out property <string> clip-source-slip-original: "";
    in-out property <string> clip-source-slip-start: "";
    in-out property <bool> add-arrangement-placement-visible: false;
    in-out property <string> add-arrangement-placement-clip-id: "";
    in-out property <string> add-arrangement-placement-clip-name: "";
    in-out property <string> add-arrangement-placement-track-name: "";
    in-out property <string> add-arrangement-placement-duration-ticks: "";
    in-out property <string> add-arrangement-placement-start-tick: "0";
    in-out property <bool> loudness-visible: false;
    in-out property <bool> loudness-wide-scale: false;
    in-out property <bool> loudness-relative: false;
    in-out property <bool> loudness-reset-confirming: false;
    in-out property <bool> output-test-confirming: false;
    in property <string> output-test-signal: "1 kHz · −18 dBFS · stereo";
    in property <string> output-test-detail: "Digital output check; not physical calibration";
    in property <bool> loudness-available: false;
    in property <string> loudness-scale-name: "EBU +9";
    in property <string> loudness-state: "UNAVAILABLE";
    in property <string> loudness-momentary: "— LUFS";
    in property <string> loudness-short-term: "— LUFS";
    in property <string> loudness-integrated: "— LUFS";
    in property <string> loudness-maximum-momentary: "— LUFS";
    in property <string> loudness-maximum-short-term: "— LUFS";
    in property <string> loudness-range: "— LU";
    in property <string> loudness-maximum-true-peak: "— dBTP";
    in property <string> loudness-programme-time: "00:00:00.000";
    in property <string> loudness-lra-status: "Waiting for final-output meter evidence";
    in property <[MixerChannelRow]> mixer-channels: [];
    in property <[MixerSendRow]> mixer-sends: [];
    in property <bool> mixer-main-state-available: false;
    in property <float> mixer-main-gain-percent: 0;
    in property <bool> mixer-main-muted: false;
    in property <[string]> recording-target-names: [];
    in-out property <int> selected-recording-target-index: 0;
    in property <string> recording-target: "—";
    in property <string> recording-frame-count: "0";
    in property <string> recording-drop-count: "0";
    in property <[TakeRow]> recording-takes: [];
    in property <[ArrangementRow]> arrangement-placements: [];
    in property <[ClipRow]> audio-clips: [];
    in property <string> arrangement-span-clock: "—";
    in property <bool> preview-active: false;
    in property <float> preview-gain-percent: 25;
    in property <bool> preview-muted: false;
    in property <string> preview-state: "Idle";
    in property <string> preview-progress: "—";
    in property <string> transport-state: "Stopped";
    in property <string> stream-state: "No stream";
    in property <string> frame-position: "0";
    in property <string> transport-clock: "00:00:00.000";
    in property <bool> transport-extent-bounded: false;
    in property <bool> transport-seek-available: false;
    in property <float> transport-progress-percent: 0;
    in property <string> transport-end-clock: "—";
    in property <string> callback-count: "0";
    in property <string> xrun-count: "Unavailable";
    in property <float> left-meter: 0;
    in property <float> right-meter: 0;
    in property <string> left-reading: "—";
    in property <string> right-reading: "—";
    in property <string> status-text: "Discovering desktop audio outputs…";
    in property <string> error-text: "";

    VerticalLayout {
        padding-left: 22px;
        padding-right: 22px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 10px;

        HorizontalLayout {
            height: 58px;

            VerticalLayout {
                spacing: 1px;
                Text {
                    text: "HYPER MODULE";
                    color: #f2f6fb;
                    font-size: 23px;
                    font-weight: 700;
                }
                Text {
                    text: "DESKTOP IDE  /  PLAYBACK CONTROL";
                    color: #65758a;
                    font-size: 11px;
                    letter-spacing: 1.4px;
                }
            }

            Rectangle { horizontal-stretch: 1; background: transparent; }

            Rectangle {
                width: 144px;
                height: 31px;
                border-radius: 16px;
                background: root.app-mode == AppMode.recording ? #542126
                    : root.app-mode == AppMode.previewing ? #173447
                    : root.app-mode == AppMode.output-testing ? #4a3514
                    : root.app-mode == AppMode.running ? #173d31
                    : root.app-mode == AppMode.unavailable ? #492323 : #222b36;
                Text {
                    text: root.app-mode == AppMode.recording ? "●  RECORDING"
                        : root.app-mode == AppMode.previewing ? "▶  AUDITION"
                        : root.app-mode == AppMode.preparing-preview ? "◌  PREPARING"
                        : root.app-mode == AppMode.preparing-recording ? "◌  PREPARING"
                        : root.app-mode == AppMode.finalizing-recording ? "◌  FINALIZING"
                        : root.app-mode == AppMode.starting-output-test ? "◌  STARTING TEST"
                        : root.app-mode == AppMode.output-testing ? "●  OUTPUT TEST"
                        : root.app-mode == AppMode.stopping-output-test ? "◌  STOPPING TEST"
                        : root.app-mode == AppMode.running ? "●  RUNNING"
                        : root.app-mode == AppMode.creating ? "◌  CREATING"
                        : root.app-mode == AppMode.opening ? "◌  OPENING"
                        : root.app-mode == AppMode.saving ? "◌  SAVING"
                        : root.app-mode == AppMode.adding-track ? "◌  ADDING TRACK"
                        : root.app-mode == AppMode.removing-track ? "◌  REMOVING TRACK"
                        : root.app-mode == AppMode.renaming-track ? "◌  RENAMING TRACK"
                        : root.app-mode == AppMode.changing-track-activation ? "◌  UPDATING TRACK"
                        : root.app-mode == AppMode.adding-arrangement-placement ? "◌  PLACING CLIP"
                        : root.app-mode == AppMode.duplicating-arrangement-placement ? "◌  COPYING PLACEMENT"
                        : root.app-mode == AppMode.changing-arrangement-activation ? "◌  UPDATING CLIP"
                        : root.app-mode == AppMode.moving-arrangement-placement ? "◌  MOVING CLIP"
                        : root.app-mode == AppMode.trimming-arrangement-placement ? "◌  TRIMMING CLIP"
                        : root.app-mode == AppMode.removing-arrangement-placement ? "◌  REMOVING CLIP"
                        : root.app-mode == AppMode.changing-clip-activation ? "◌  UPDATING CLIP"
                        : root.app-mode == AppMode.changing-clip-gain ? "◌  UPDATING GAIN"
                        : root.app-mode == AppMode.changing-clip-fades ? "◌  UPDATING FADES"
                        : root.app-mode == AppMode.changing-clip-loop ? "◌  UPDATING LOOP"
                        : root.app-mode == AppMode.changing-clip-reverse ? "◌  UPDATING DIRECTION"
                        : root.app-mode == AppMode.changing-clip-source ? "◌  SLIPPING SOURCE"
                        : root.app-mode == AppMode.creating-clip ? "◌  CREATING CLIP"
                        : root.app-mode == AppMode.selecting ? "◌  SELECTING"
                        : root.app-mode == AppMode.closing ? "◌  CLOSING"
                        : root.app-mode == AppMode.closed ? "●  READY"
                        : root.app-mode == AppMode.unavailable ? "●  UNAVAILABLE"
                        : "◌  DISCOVERING";
                    color: root.app-mode == AppMode.recording ? #ff8b87
                        : root.app-mode == AppMode.previewing ? #7dcfff
                        : root.app-mode == AppMode.output-testing ? #ffd166
                        : root.app-mode == AppMode.running ? #63e6b5
                        : root.app-mode == AppMode.unavailable ? #ff8b87 : #a9b5c4;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            spacing: 16px;
            horizontal-stretch: 1;
            vertical-stretch: 1;

            VerticalLayout {
                width: 330px;
                spacing: 16px;

                Panel {
                    height: 298px;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 6px;
                        Text { text: "AUDIO I/O"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: "Playback output"; color: #edf2f8; font-size: 14px; font-weight: 600; }
                        output-selector := ComboBox {
                            model: root.output-names;
                            current-index <=> root.selected-output-index;
                            enabled: root.app-mode == AppMode.closed;
                            selected(_) => {
                                root.output-test-confirming = false;
                                IdeActions.select-output(self.current-index);
                            }
                        }
                        if root.app-mode == AppMode.unavailable : HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Retry discovery";
                                clicked => { IdeActions.retry-discovery(); }
                            }
                        }

                        if root.app-mode == AppMode.closed && !root.output-test-confirming : HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Refresh output"; clicked => { IdeActions.refresh-outputs(); } }
                            Button {
                                text: "Test output";
                                clicked => { root.output-test-confirming = true; }
                            }
                        }

                        if root.app-mode == AppMode.closed && root.output-test-confirming : HorizontalLayout {
                            spacing: 6px;
                            Text { horizontal-stretch: 1; text: "Lower monitors first · 1 kHz / −18 dBFS"; color: #ffbf9b; font-size: 9px; vertical-alignment: center; wrap: word-wrap; }
                            Button { text: "Cancel"; clicked => { root.output-test-confirming = false; } }
                            Button { text: "Start"; clicked => { IdeActions.start-output-test(); } }
                        }

                        if root.app-mode == AppMode.starting-output-test || root.app-mode == AppMode.output-testing || root.app-mode == AppMode.stopping-output-test : HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: root.output-test-signal; color: #ffd166; font-size: 9px; font-weight: 600; }
                                Text { text: root.output-test-detail; color: #8290a2; font-size: 8px; overflow: elide; }
                            }
                            Button {
                                text: root.app-mode == AppMode.stopping-output-test ? "Stopping…" : "Stop";
                                enabled: root.app-mode == AppMode.output-testing;
                                clicked => { IdeActions.stop-output-test(); }
                            }
                        }

                        Rectangle { height: 1px; background: #27313d; }

                        HorizontalLayout {
                            Text { text: "INPUT CUE"; color: #edf2f8; font-size: 14px; font-weight: 600; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text {
                                text: root.monitoring-active ? root.monitoring-state : "OFF";
                                color: root.monitoring-active ? #63e6b5 : #728196;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                        }
                        input-selector := ComboBox {
                            model: root.input-names;
                            current-index <=> root.selected-input-index;
                            enabled: root.app-mode == AppMode.closed;
                            selected(_) => { IdeActions.select-input(self.current-index); }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Refresh input";
                                enabled: root.app-mode == AppMode.closed;
                                clicked => { IdeActions.refresh-inputs(); }
                            }
                            Text {
                                text: root.input-discovery-available ? "Ready" : "Unavailable";
                                color: root.input-discovery-available ? #63e6b5 : #ff9d76;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: "GAIN  " + Math.round(root.monitoring-gain-percent) + "%"; color: #8fa0b4; font-size: 9px; }
                                Slider {
                                    minimum: 0;
                                    maximum: 100;
                                    value: root.monitoring-gain-percent;
                                    enabled: (root.app-mode == AppMode.running || root.app-mode == AppMode.recording) && root.monitoring-active;
                                    accessible-label: "Input cue gain";
                                    released(value) => { IdeActions.monitor-gain(value); }
                                }
                            }
                            Button {
                                width: 72px;
                                text: root.monitoring-muted ? "MUTED" : "MUTE";
                                enabled: (root.app-mode == AppMode.running || root.app-mode == AppMode.recording) && root.monitoring-active;
                                clicked => { IdeActions.monitor-mute(); }
                            }
                        }
                        Text { text: "Global post-main cue only; this does not arm or route a track."; color: #728196; font-size: 9px; wrap: word-wrap; }
                    }
                }

                Panel {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        Text { text: "PROJECT"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        if root.new-project-visible : VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 6px;
                            Text { text: "NEW PROJECT NAME"; color: #65758a; font-size: 9px; font-weight: 700; letter-spacing: 0.6px; }
                            LineEdit {
                                text <=> root.new-project-name;
                                enabled: root.app-mode == AppMode.closed;
                                accessible-label: "New project name";
                            }
                            Text {
                                text: "48 kHz · 120 BPM · 4/4 · one audio track";
                                color: #728196;
                                font-size: 9px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: "Cancel";
                                    enabled: root.app-mode == AppMode.closed;
                                    clicked => { root.new-project-visible = false; }
                                }
                                Button {
                                    horizontal-stretch: 1;
                                    text: root.app-mode == AppMode.selecting ? "Selecting location…"
                                        : root.app-mode == AppMode.creating ? "Creating project…"
                                        : "Choose location & create";
                                    enabled: root.app-mode == AppMode.closed && root.new-project-name != "";
                                    clicked => { IdeActions.create-project(root.new-project-name); }
                                }
                            }
                        }
                        if !root.new-project-visible : VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 8px;
                            if root.new-track-visible : VerticalLayout {
                                vertical-stretch: 1;
                                spacing: 6px;
                                Text { text: "NEW AUDIO TRACK"; color: #65758a; font-size: 9px; font-weight: 700; letter-spacing: 0.6px; }
                                LineEdit {
                                    text <=> root.new-track-name;
                                    enabled: root.app-mode == AppMode.running;
                                    accessible-label: "New audio track name";
                                }
                                Text {
                                    text: "Appended after the current tracks with a unity-gain main mix channel.";
                                    color: #728196;
                                    font-size: 9px;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: "Cancel";
                                        enabled: root.app-mode == AppMode.running;
                                        clicked => { root.new-track-visible = false; }
                                    }
                                    Button {
                                        horizontal-stretch: 1;
                                        text: root.app-mode == AppMode.adding-track ? "Adding track…" : "Add audio track";
                                        enabled: root.app-mode == AppMode.running && root.new-track-name != "" && root.track-count < 8;
                                        clicked => { IdeActions.add-audio-track(root.new-track-name); }
                                    }
                                }
                                Text {
                                    text: root.track-count >= 8
                                        ? "Version 1 supports at most eight structural tracks."
                                        : "The current live mixer state is saved before the project is reopened.";
                                    color: root.track-count >= 8 ? #ffaaa6 : #728196;
                                    font-size: 9px;
                                    wrap: word-wrap;
                                }
                            }
                            if !root.new-track-visible : VerticalLayout {
                                spacing: 8px;
                            Text { text: root.project-name; color: #edf2f8; font-size: 18px; font-weight: 600; overflow: elide; }
                            Text { text: root.project-location; color: #8290a2; font-size: 11px; wrap: word-wrap; vertical-stretch: 1; }
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: root.app-mode == AppMode.running ? "Add audio track" : "New project";
                                    enabled: (root.app-mode == AppMode.running && root.track-count < 8) || root.app-mode == AppMode.closed;
                                    clicked => {
                                        if root.app-mode == AppMode.running {
                                            root.new-track-visible = true;
                                        } else {
                                            root.new-project-visible = true;
                                        }
                                    }
                                }
                                Button {
                                    horizontal-stretch: 1;
                                    text: root.app-mode == AppMode.selecting ? "Selecting project…"
                                        : root.app-mode == AppMode.opening ? "Opening project…" : "Open project folder";
                                    enabled: root.app-mode == AppMode.closed;
                                    clicked => { IdeActions.choose-project(); }
                                }
                            }
                            }
                        }
                        if !root.new-project-visible && !root.new-track-visible : HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: root.app-mode == AppMode.saving ? "Saving…" : "Save project";
                                enabled: root.app-mode == AppMode.running && root.mixer-main-state-available;
                                clicked => { IdeActions.save-project(); }
                            }
                            Button {
                                text: "Close";
                                enabled: root.app-mode == AppMode.running || root.app-mode == AppMode.previewing;
                                clicked => { IdeActions.close-project(); }
                            }
                        }
                        if !root.new-project-visible && !root.new-track-visible : Text { text: "Verified identity"; color: #65758a; font-size: 10px; }
                        if !root.new-project-visible && !root.new-track-visible : Text { text: root.project-id; color: #b9c5d3; font-size: 11px; overflow: elide; }
                        if !root.new-track-visible : VerticalLayout {
                        spacing: 8px;
                        Rectangle { height: 1px; background: #27313d; }
                        Text { text: "CAPTURE TAKE"; color: #6f8197; font-size: 10px; font-weight: 700; letter-spacing: 1px; }
                        ComboBox {
                            model: root.recording-target-names;
                            current-index <=> root.selected-recording-target-index;
                            enabled: root.app-mode == AppMode.running && root.monitoring-active && root.recording-target-names.length > 0;
                            accessible-label: "Recording target audio track";
                        }
                        if root.app-mode == AppMode.recording : HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Stop & import"; clicked => { IdeActions.stop-recording(); } }
                            Button { text: "Abort"; clicked => { IdeActions.abort-recording(); } }
                        }
                        if root.app-mode != AppMode.recording : Button {
                            text: root.app-mode == AppMode.preparing-recording ? "Preparing capture…"
                                : root.app-mode == AppMode.finalizing-recording ? "Finalizing capture…"
                                : "Record take";
                            enabled: root.app-mode == AppMode.running && root.monitoring-active && root.recording-target-names.length > 0;
                            clicked => { IdeActions.start-recording(); }
                        }
                        Text {
                            text: root.app-mode == AppMode.recording
                                ? root.recording-target + "  ·  " + root.recording-frame-count + " frames  ·  " + root.recording-drop-count + " rejected"
                                : "Takes must stay under 15 minutes; overruns retain recovery data. Playback pauses; no synchronized overdub.";
                            color: root.app-mode == AppMode.recording ? #ffaaa6 : #728196;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                        }
                    }
                }
            }

            right-pane := Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: transparent;

                if !root.mixer-visible && !root.takes-visible && !root.arrangement-visible && !root.clips-visible && !root.loudness-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                    padding: 22px;
                    spacing: 18px;

                    HorizontalLayout {
                        height: 62px;
                        VerticalLayout {
                            Text { text: "PERFORMANCE"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                            Text { text: root.transport-state; color: #edf2f8; font-size: 24px; font-weight: 650; }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Button {
                            text: "Arrangement (" + root.arrangement-placements.length + ")";
                            enabled: root.app-mode == AppMode.running;
                            clicked => { root.clips-visible = false; root.loudness-visible = false; root.arrangement-visible = true; }
                        }
                        Button {
                            text: "Clips (" + root.audio-clips.length + ")";
                            enabled: root.app-mode == AppMode.running;
                            clicked => { root.arrangement-visible = false; root.loudness-visible = false; root.clips-visible = true; }
                        }
                        Button {
                            text: "Loudness";
                            enabled: root.app-mode == AppMode.running;
                            clicked => { root.arrangement-visible = false; root.clips-visible = false; root.loudness-visible = true; }
                        }
                        Button {
                            text: "Takes (" + root.recording-takes.length + ")";
                            enabled: root.app-mode == AppMode.running || root.app-mode == AppMode.previewing;
                            clicked => { root.arrangement-visible = false; root.clips-visible = false; root.loudness-visible = false; root.takes-visible = true; }
                        }
                        Button {
                            text: "Mixer";
                            enabled: root.app-mode == AppMode.running;
                            clicked => { root.arrangement-visible = false; root.clips-visible = false; root.loudness-visible = false; root.mixer-visible = true; }
                        }
                        Text { text: root.stream-state; color: #8fa0b4; font-size: 12px; vertical-alignment: center; }
                    }

                    Rectangle { height: 1px; background: #27313d; }

                    HorizontalLayout {
                        height: 146px;
                        spacing: 18px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 14px;
                            HorizontalLayout {
                                alignment: center;
                                spacing: 10px;
                                Button {
                                    text: "▶  Start";
                                    enabled: root.app-mode == AppMode.running;
                                    clicked => { IdeActions.transport-start(); }
                                }
                                Button {
                                    text: "■  Stop";
                                    enabled: root.app-mode == AppMode.running;
                                    clicked => { IdeActions.transport-stop(); }
                                }
                                Button {
                                    text: "|◀  Return";
                                    accessible-label: "Return transport to start";
                                    enabled: root.app-mode == AppMode.running;
                                    clicked => { IdeActions.transport-return-start(); }
                                }
                            }
                            Text { text: root.transport-clock; color: #dce5ef; font-size: 18px; font-weight: 600; horizontal-alignment: center; }
                            Text { text: "Frame  " + root.frame-position; color: #8fa0b4; font-size: 11px; horizontal-alignment: center; }
                            VerticalLayout {
                                spacing: 2px;
                                Slider {
                                    minimum: 0;
                                    maximum: 100;
                                    value: root.transport-progress-percent;
                                    enabled: root.app-mode == AppMode.running && root.transport-seek-available;
                                    accessible-label: "Locate within finite compiled playback range";
                                    released(value) => { IdeActions.transport-seek(value); }
                                }
                                Text {
                                    text: root.transport-extent-bounded ? "0:00  ·  COMPILED PLAYBACK RANGE  ·  " + root.transport-end-clock : "OPEN-ENDED RECORDED SCENE AUTHORITY · SEEK RANGE UNAVAILABLE";
                                    color: root.transport-extent-bounded ? #65758a : #b58a67;
                                    font-size: 9px;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                        Meter { width: 64px; level: root.left-meter; channel-name: "LEFT"; reading: root.left-reading; }
                        Meter { width: 64px; level: root.right-meter; channel-name: "RIGHT"; reading: root.right-reading; }
                    }

                    Rectangle { height: 1px; background: #27313d; }

                    VerticalLayout {
                        height: 110px;
                        spacing: 8px;
                        Text { text: "SCENE LAUNCHER"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        GridLayout {
                            spacing: 6px;
                            for scene[index] in root.scenes : VerticalLayout {
                                row: index / 4;
                                col: Math.mod(index, 4);
                                min-width: 170px;
                                max-width: 170px;
                                spacing: 2px;
                                Button {
                                    min-width: 0px;
                                    max-width: 170px;
                                    text: scene.display-name;
                                    accessible-label: scene.name + ", " + scene.availability;
                                    enabled: root.app-mode == AppMode.running && scene.launchable;
                                    clicked => { IdeActions.launch-scene(scene.index); }
                                }
                                Text {
                                    text: scene.availability;
                                    color: scene.launchable ? #63e6b5 : #8fa0b4;
                                    font-size: 9px;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: #27313d; }

                    Text { text: "RUNTIME EVIDENCE"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }

                    GridLayout {
                        spacing: 10px;
                        Rectangle {
                            row: 0; col: 0; height: 78px; background: #0e141b; border-radius: 6px;
                            VerticalLayout { padding: 12px; Text { text: "SAMPLE RATE"; color: #65758a; font-size: 10px; } Text { text: root.sample-rate; color: #dce5ef; font-size: 18px; } }
                        }
                        Rectangle {
                            row: 0; col: 1; height: 78px; background: #0e141b; border-radius: 6px;
                            VerticalLayout { padding: 12px; Text { text: "SCENES"; color: #65758a; font-size: 10px; } Text { text: root.scene-count; color: #dce5ef; font-size: 18px; } }
                        }
                        Rectangle {
                            row: 0; col: 2; height: 78px; background: #0e141b; border-radius: 6px;
                            VerticalLayout { padding: 12px; Text { text: "CALLBACKS"; color: #65758a; font-size: 10px; } Text { text: root.callback-count; color: #dce5ef; font-size: 18px; } }
                        }
                        Rectangle {
                            row: 0; col: 3; height: 78px; background: #0e141b; border-radius: 6px;
                            VerticalLayout { padding: 12px; Text { text: "NATIVE XRUNS"; color: #65758a; font-size: 10px; } Text { text: root.xrun-count; color: #dce5ef; font-size: 18px; } }
                        }
                        Rectangle {
                            row: 1; col: 0; height: 64px; background: #0e141b; border-radius: 6px;
                            VerticalLayout { padding: 10px; Text { text: "INPUT CUE"; color: #65758a; font-size: 9px; } Text { text: root.monitoring-state; color: root.monitoring-active ? #63e6b5 : #8fa0b4; font-size: 15px; } }
                        }
                        Rectangle {
                            row: 1; col: 1; height: 64px; background: #0e141b; border-radius: 6px;
                            VerticalLayout { padding: 10px; Text { text: "CUE FRAMES"; color: #65758a; font-size: 9px; } Text { text: root.monitoring-frame-count; color: #dce5ef; font-size: 15px; } }
                        }
                        Rectangle {
                            row: 1; col: 2; height: 64px; background: #0e141b; border-radius: 6px;
                            VerticalLayout { padding: 10px; Text { text: "DROPPED FRAMES"; color: #65758a; font-size: 9px; } Text { text: root.monitoring-drop-count; color: root.monitoring-drop-count == "0" ? #dce5ef : #ff9d76; font-size: 15px; } }
                        }
                        Rectangle {
                            row: 1; col: 3; height: 64px; background: #0e141b; border-radius: 6px;
                            VerticalLayout { padding: 10px; Text { text: "UNDERFLOWS"; color: #65758a; font-size: 9px; } Text { text: root.monitoring-underflow-count; color: root.monitoring-underflow-count == "0" ? #dce5ef : #ff9d76; font-size: 15px; } }
                        }
                    }
                    }
                }

                if root.mixer-visible && root.remove-track-visible && !root.mixer-sends-visible && !root.takes-visible && !root.arrangement-visible && !root.clips-visible && !root.loudness-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 22px;
                        spacing: 14px;
                        Text { text: "REMOVE EMPTY AUDIO TRACK"; color: #ff9d76; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: root.remove-track-name; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                        Rectangle { height: 1px; background: #27313d; }
                        Text { text: "This cannot be undone. Removal is accepted only when no clips, child tracks, scenes, arrangement placements, control mappings, recordings, or mixer routes reference this track, and while the project contains no automation."; color: #aebccc; font-size: 11px; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Cancel";
                                enabled: root.app-mode == AppMode.running;
                                clicked => {
                                    root.remove-track-visible = false;
                                    root.remove-track-id = "";
                                    root.remove-track-name = "";
                                }
                            }
                            Button {
                                horizontal-stretch: 1;
                                text: root.app-mode == AppMode.removing-track ? "Removing track..." : "Remove empty track";
                                enabled: root.app-mode == AppMode.running && root.remove-track-id != "";
                                clicked => { IdeActions.remove-audio-track(root.remove-track-id); }
                            }
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }

                if root.mixer-visible && root.rename-track-visible && !root.remove-track-visible && !root.mixer-sends-visible && !root.takes-visible && !root.arrangement-visible && !root.clips-visible && !root.loudness-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 22px;
                        spacing: 14px;
                        Text { text: "RENAME AUDIO TRACK"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: root.rename-track-original-name; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                        Rectangle { height: 1px; background: #27313d; }
                        Text { text: "New display name"; color: #aebccc; font-size: 12px; }
                        LineEdit {
                            text <=> root.rename-track-name;
                            enabled: root.app-mode == AppMode.running;
                            accessible-label: "New audio track name";
                        }
                        Text {
                            text: "The committed live mixer is preserved first. The structural track is then replaced through a recoverable project transaction.";
                            color: #728196;
                            font-size: 10px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Cancel";
                                enabled: root.app-mode == AppMode.running;
                                clicked => { root.rename-track-visible = false; }
                            }
                            Button {
                                horizontal-stretch: 1;
                                text: root.app-mode == AppMode.renaming-track ? "Renaming track..." : "Rename audio track";
                                enabled: root.app-mode == AppMode.running
                                    && root.rename-track-index >= 0
                                    && root.rename-track-name != ""
                                    && root.rename-track-name != root.rename-track-original-name;
                                clicked => { IdeActions.rename-audio-track(root.rename-track-index, root.rename-track-name); }
                            }
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }

                if root.mixer-visible && !root.rename-track-visible && !root.remove-track-visible && !root.mixer-sends-visible && !root.takes-visible && !root.arrangement-visible && !root.clips-visible && !root.loudness-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        height: 48px;
                        spacing: 8px;
                        VerticalLayout {
                            Text { text: "BASE MIXER"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                            Text { text: "Automation may override base values"; color: #aebccc; font-size: 12px; }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Button { text: "Performance"; clicked => { root.mixer-visible = false; } }
                        Button { text: "Sends"; enabled: root.mixer-sends.length > 0; clicked => { root.mixer-sends-visible = true; } }
                        Text { text: root.stream-state; color: #8fa0b4; font-size: 12px; vertical-alignment: center; }
                    }

                    Rectangle { height: 1px; background: #27313d; }

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for channel in root.mixer-channels : Rectangle {
                            width: 72px;
                            vertical-stretch: 1;
                            background: #0e141b;
                            border-color: #27313d;
                            border-width: 1px;
                            border-radius: 6px;
                            VerticalLayout {
                                padding: 7px;
                                spacing: 5px;
                                Text { text: channel.display-name; accessible-label: channel.name; color: channel.active ? #dce5ef : #8290a2; font-size: 10px; font-weight: 600; horizontal-alignment: center; overflow: elide; }
                                Text { text: channel.kind; color: #65758a; font-size: 8px; horizontal-alignment: center; }
                                Button {
                                    text: "Rename";
                                    enabled: root.app-mode == AppMode.running && channel.renameable;
                                    clicked => {
                                        root.rename-track-index = channel.index;
                                        root.rename-track-original-name = channel.name;
                                        root.rename-track-name = channel.name;
                                        root.rename-track-visible = true;
                                    }
                                }
                                Button {
                                    text: channel.active ? "Disable" : "Enable";
                                    accessible-label: (channel.active ? "Disable " : "Enable ") + channel.name;
                                    enabled: root.app-mode == AppMode.running && channel.activation-toggleable;
                                    clicked => { IdeActions.set-audio-track-active(channel.index, !channel.active); }
                                }
                                Button {
                                    text: "Remove";
                                    enabled: root.app-mode == AppMode.running && channel.removable;
                                    clicked => {
                                        root.remove-track-id = channel.track-id;
                                        root.remove-track-name = channel.name;
                                        root.remove-track-visible = true;
                                    }
                                }
                                Slider {
                                    min-width: 28px;
                                    max-width: 28px;
                                    vertical-stretch: 1;
                                    orientation: Orientation.vertical;
                                    minimum: 0;
                                    maximum: 200;
                                    value: channel.gain-percent;
                                    enabled: root.app-mode == AppMode.running && channel.state-available;
                                    accessible-label: channel.name + " base gain";
                                    released(value) => { IdeActions.mixer-channel-gain(channel.index, value); }
                                }
                                Text { text: Math.round(channel.gain-percent) + "%"; color: channel.state-available ? #aebccc : #65758a; font-size: 9px; horizontal-alignment: center; }
                                Slider {
                                    height: 24px;
                                    minimum: -100;
                                    maximum: 100;
                                    value: channel.pan-percent;
                                    enabled: root.app-mode == AppMode.running && channel.state-available;
                                    accessible-label: channel.name + " base pan";
                                    released(value) => { IdeActions.mixer-channel-pan(channel.index, value); }
                                }
                                Text { text: "PAN " + Math.round(channel.pan-percent); color: channel.state-available ? #aebccc : #65758a; font-size: 8px; horizontal-alignment: center; }
                                HorizontalLayout {
                                    spacing: 3px;
                                    Button { text: channel.muted ? "M*" : "M"; accessible-label: channel.name + (channel.muted ? " muted" : " not muted"); enabled: root.app-mode == AppMode.running && channel.state-available; clicked => { IdeActions.mixer-channel-mute(channel.index); } }
                                    Button { text: channel.solo ? "S*" : "S"; accessible-label: channel.name + (channel.solo ? " soloed" : " not soloed"); enabled: root.app-mode == AppMode.running && channel.state-available && channel.solo-available; clicked => { IdeActions.mixer-channel-solo(channel.index); } }
                                }
                                Text { text: !channel.active ? "DISABLED" : channel.state-available ? "BASE" : "UNAVAILABLE"; color: !channel.active ? #8290a2 : channel.state-available ? #63e6b5 : #ff9d76; font-size: 7px; horizontal-alignment: center; }
                            }
                        }
                        Rectangle {
                            width: 76px;
                            vertical-stretch: 1;
                            background: #18202a;
                            border-color: #3a4858;
                            border-width: 1px;
                            border-radius: 6px;
                            VerticalLayout {
                                padding: 7px;
                                spacing: 5px;
                                Text { text: "MAIN"; color: #edf2f8; font-size: 10px; font-weight: 700; horizontal-alignment: center; }
                                Text { text: "OUTPUT"; color: #65758a; font-size: 8px; horizontal-alignment: center; }
                                Slider {
                                    min-width: 28px;
                                    max-width: 28px;
                                    vertical-stretch: 1;
                                    orientation: Orientation.vertical;
                                    minimum: 0;
                                    maximum: 200;
                                    value: root.mixer-main-gain-percent;
                                    enabled: root.app-mode == AppMode.running && root.mixer-main-state-available;
                                    accessible-label: "Main base gain";
                                    released(value) => { IdeActions.mixer-main-gain(value); }
                                }
                                Text { text: Math.round(root.mixer-main-gain-percent) + "%"; color: root.mixer-main-state-available ? #aebccc : #65758a; font-size: 9px; horizontal-alignment: center; }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                                Button { text: root.mixer-main-muted ? "MUTE ON" : "MUTE"; enabled: root.app-mode == AppMode.running && root.mixer-main-state-available; clicked => { IdeActions.mixer-main-mute(); } }
                                Text { text: root.mixer-main-state-available ? "BASE" : "UNAVAILABLE"; color: root.mixer-main-state-available ? #63e6b5 : #ff9d76; font-size: 7px; horizontal-alignment: center; }
                            }
                        }
                    }
                    }
                }

                if root.mixer-visible && root.mixer-sends-visible && !root.takes-visible && !root.arrangement-visible && !root.clips-visible && !root.loudness-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    HorizontalLayout {
                        height: 48px;
                        VerticalLayout {
                            Text { text: "BASE SENDS"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                            Text { text: "Compiled routes · automation may override base values"; color: #aebccc; font-size: 12px; }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Button { text: "Channels"; clicked => { root.mixer-sends-visible = false; } }
                        Button { text: "Performance"; clicked => { root.mixer-sends-visible = false; root.mixer-visible = false; } }
                    }

                    Rectangle { height: 1px; background: #27313d; }

                    if root.mixer-sends.length == 0 : Text {
                        text: "This compiled mixer has no sends.";
                        color: #8fa0b4;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        vertical-stretch: 1;
                    }

                    GridLayout {
                        spacing: 7px;
                        for send[index] in root.mixer-sends : Rectangle {
                            row: index / 2;
                            col: Math.mod(index, 2);
                            height: 48px;
                            background: #0e141b;
                            border-color: #27313d;
                            border-width: 1px;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding: 4px;
                                spacing: 5px;
                                VerticalLayout {
                                    width: 104px;
                                    Text { text: send.source-name + " → " + send.target-name; accessible-label: send.source-name + " send to " + send.target-name; color: #dce5ef; font-size: 9px; overflow: elide; }
                                    Text { text: send.tap; color: #65758a; font-size: 7px; }
                                }
                                Button { width: 48px; text: send.enabled ? "ON" : "OFF"; enabled: root.app-mode == AppMode.running && send.state-available; clicked => { IdeActions.mixer-send-enabled(send.index); } }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    Text { text: "GAIN " + Math.round(send.gain-percent) + "%"; color: #8fa0b4; font-size: 8px; }
                                    Slider { minimum: 0; maximum: 200; value: send.gain-percent; enabled: root.app-mode == AppMode.running && send.state-available; accessible-label: send.source-name + " send gain to " + send.target-name; released(value) => { IdeActions.mixer-send-gain(send.index, value); } }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    Text { text: "PAN " + Math.round(send.pan-percent); color: #8fa0b4; font-size: 8px; }
                                    Slider { minimum: -100; maximum: 100; value: send.pan-percent; enabled: root.app-mode == AppMode.running && send.state-available; accessible-label: send.source-name + " send pan to " + send.target-name; released(value) => { IdeActions.mixer-send-pan(send.index, value); } }
                                }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }

                if root.takes-visible && !root.arrangement-visible && !root.clips-visible && !root.loudness-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        HorizontalLayout {
                            height: 48px;
                            VerticalLayout {
                                Text { text: "RECORDED TAKES"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                                Text { text: "Verified whole-file recordings · dry audition only"; color: #aebccc; font-size: 12px; }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Performance";
                                clicked => { root.takes-visible = false; root.take-clip-visible = false; root.mixer-visible = false; root.mixer-sends-visible = false; }
                            }
                            Button {
                                text: "Mixer";
                                enabled: !root.preview-active;
                                clicked => { root.takes-visible = false; root.take-clip-visible = false; root.mixer-visible = true; root.mixer-sends-visible = false; }
                            }
                        }

                        Rectangle { height: 1px; background: #27313d; }

                        if root.take-clip-visible : Rectangle {
                            vertical-stretch: 1;
                            background: #0e141b;
                            border-color: #37769a;
                            border-width: 1px;
                            border-radius: 6px;
                            VerticalLayout {
                                padding: 18px;
                                spacing: 12px;
                                Text { text: "CREATE REUSABLE AUDIO CLIP"; color: #7dcfff; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                                Text { text: "Source take on " + root.take-clip-track-name; color: #edf2f8; font-size: 15px; font-weight: 600; overflow: elide; }
                                Text {
                                    text: "This preserves the verified whole recording and its exact frame-derived duration. The new clip belongs to the take's track; it is not placed in the arrangement.";
                                    color: #aebccc;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                Text { text: "CLIP NAME"; color: #65758a; font-size: 9px; }
                                LineEdit {
                                    text <=> root.take-clip-name;
                                    accessible-label: "Reusable audio clip name";
                                }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Button {
                                        width: 86px;
                                        text: "Cancel";
                                        enabled: root.app-mode == AppMode.running;
                                        clicked => { root.take-clip-visible = false; }
                                    }
                                    Button {
                                        width: 116px;
                                        text: root.app-mode == AppMode.creating-clip ? "Creating…" : "Create clip";
                                        enabled: root.app-mode == AppMode.running && root.take-clip-name != "";
                                        clicked => { IdeActions.create-audio-clip-from-take(root.take-clip-index, root.take-clip-name); }
                                    }
                                }
                            }
                        }

                        if !root.take-clip-visible && root.recording-takes.length == 0 : Text {
                            text: "No verified recorded takes are present in this project.";
                            color: #8fa0b4;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            vertical-stretch: 1;
                        }

                        if !root.take-clip-visible && root.recording-takes.length > 0 : ListView {
                            vertical-stretch: 1;
                            for take in root.recording-takes : Rectangle {
                                height: 74px;
                                width: parent.width;
                                background: take.active ? #102536 : #0e141b;
                                border-color: take.active ? #37769a : #27313d;
                                border-width: 1px;
                                border-radius: 6px;
                                HorizontalLayout {
                                    padding: 9px;
                                    spacing: 12px;
                                    VerticalLayout {
                                        width: 164px;
                                        spacing: 2px;
                                        Text { text: take.track-name; color: #edf2f8; font-size: 13px; font-weight: 600; overflow: elide; }
                                        Text { text: take.captured-at; color: #8290a2; font-size: 9px; overflow: elide; }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: take.detail; color: #b9c5d3; font-size: 11px; overflow: elide; }
                                        Text { text: take.timeline-start; color: #65758a; font-size: 9px; overflow: elide; }
                                    }
                                    Text {
                                        width: 74px;
                                        text: take.state;
                                        color: take.active ? #7dcfff : #65758a;
                                        font-size: 9px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    Button {
                                        width: 86px;
                                        text: take.active && root.preview-active ? "Stop" : "Preview";
                                        accessible-label: (take.active && root.preview-active ? "Stop preview of " : "Preview ") + take.track-name;
                                        enabled: root.app-mode == AppMode.running || (root.app-mode == AppMode.previewing && take.active);
                                        clicked => { IdeActions.toggle-take-preview(take.index); }
                                    }
                                    Button {
                                        width: 92px;
                                        text: "Create clip";
                                        accessible-label: "Create a reusable audio clip from the recorded take on " + take.track-name;
                                        enabled: root.app-mode == AppMode.running;
                                        clicked => {
                                            root.take-clip-index = take.index;
                                            root.take-clip-track-name = take.track-name;
                                            root.take-clip-name = take.track-name;
                                            root.take-clip-visible = true;
                                        }
                                    }
                                }
                            }
                        }

                        if !root.take-clip-visible : Rectangle { height: 1px; background: #27313d; }
                        if !root.take-clip-visible : HorizontalLayout {
                            height: 58px;
                            spacing: 10px;
                            VerticalLayout {
                                width: 130px;
                                Text { text: "AUDITION"; color: #65758a; font-size: 9px; }
                                Text { text: root.preview-state; color: root.preview-active ? #7dcfff : #aebccc; font-size: 14px; font-weight: 600; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: "GAIN  " + Math.round(root.preview-gain-percent) + "%"; color: #8fa0b4; font-size: 9px; }
                                Slider {
                                    minimum: 0;
                                    maximum: 100;
                                    value: root.preview-gain-percent;
                                    enabled: root.app-mode == AppMode.running || root.app-mode == AppMode.previewing;
                                    accessible-label: "Recorded take audition gain";
                                    released(value) => { IdeActions.preview-gain(value); }
                                }
                            }
                            Button {
                                width: 72px;
                                text: root.preview-muted ? "MUTED" : "MUTE";
                                enabled: root.app-mode == AppMode.running || root.app-mode == AppMode.previewing;
                                clicked => { IdeActions.preview-mute(); }
                            }
                            Text {
                                width: 126px;
                                text: root.preview-progress;
                                color: #aebccc;
                                font-size: 10px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                        if !root.take-clip-visible : Text {
                            text: "Audition is dry. Creating a reusable clip still does not place it in the arrangement.";
                            color: #65758a;
                            font-size: 9px;
                        }
                    }
                }

                if root.arrangement-visible && !root.clips-visible && !root.loudness-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        HorizontalLayout {
                            height: 48px;
                            VerticalLayout {
                                Text { text: "ARRANGEMENT"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                                Text { text: "Verified compiled placements · span " + root.arrangement-span-clock; color: #aebccc; font-size: 12px; }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Performance";
                                clicked => { root.arrangement-visible = false; root.mixer-visible = false; root.mixer-sends-visible = false; root.takes-visible = false; }
                            }
                            Button {
                                text: "Mixer";
                                enabled: root.app-mode == AppMode.running;
                                clicked => { root.arrangement-visible = false; root.mixer-visible = true; root.mixer-sends-visible = false; root.takes-visible = false; }
                            }
                        }

                        Rectangle { height: 1px; background: #27313d; }

                        if root.remove-arrangement-placement-visible : VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 14px;
                            Text { text: "REMOVE ARRANGEMENT PLACEMENT"; color: #ff9d76; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                            Text { text: root.remove-arrangement-placement-clip-name; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                            Text { text: "Track: " + root.remove-arrangement-placement-track-name; color: #8fa0b4; font-size: 12px; overflow: elide; }
                            Rectangle { height: 1px; background: #27313d; }
                            Text {
                                text: "This cannot be undone. Only this arrangement placement is removed. The reusable clip, source audio, track, mixer state, later placement positions, and recorded takes remain unchanged.";
                                color: #aebccc;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "This is a non-ripple edit. The project is reopened and verified before the removal is reported as complete.";
                                color: #728196;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: "Cancel";
                                    enabled: root.app-mode == AppMode.running;
                                    clicked => {
                                        root.remove-arrangement-placement-visible = false;
                                        root.remove-arrangement-placement-id = "";
                                        root.remove-arrangement-placement-clip-name = "";
                                        root.remove-arrangement-placement-track-name = "";
                                    }
                                }
                                Button {
                                    horizontal-stretch: 1;
                                    text: root.app-mode == AppMode.removing-arrangement-placement ? "Removing placement..." : "Remove placement";
                                    enabled: root.app-mode == AppMode.running && root.remove-arrangement-placement-id != "";
                                    clicked => { IdeActions.remove-arrangement-placement(root.remove-arrangement-placement-id); }
                                }
                            }
                            Rectangle { vertical-stretch: 1; background: transparent; }
                        }

                        if !root.remove-arrangement-placement-visible && root.arrangement-placements.length == 0 : Text {
                            text: "This project has no linear arrangement placements.";
                            color: #8fa0b4;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            vertical-stretch: 1;
                        }

                        if !root.remove-arrangement-placement-visible && root.arrangement-placements.length > 0 : ListView {
                            vertical-stretch: 1;
                            for placement in root.arrangement-placements : Rectangle {
                                height: 112px;
                                width: parent.width;
                                background: placement.enabled ? #0e141b : #11151a;
                                border-color: placement.enabled ? #27313d : #3a3330;
                                border-width: 1px;
                                border-radius: 6px;
                                HorizontalLayout {
                                    padding: 9px;
                                    spacing: 6px;
                                    VerticalLayout {
                                        width: 110px;
                                        spacing: 2px;
                                        Text { text: placement.clip-name; color: placement.enabled ? #edf2f8 : #8c929a; font-size: 13px; font-weight: 600; overflow: elide; }
                                        Text { text: placement.track-name; color: #8290a2; font-size: 9px; overflow: elide; }
                                        Text { text: "SOURCE +" + placement.clip-start-tick + " TICKS"; color: #65758a; font-size: 8px; overflow: elide; }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 5px;
                                        Text {
                                            text: placement.start-clock + "  →  " + placement.end-clock;
                                            color: #b9c5d3;
                                            font-size: 10px;
                                        }
                                        Rectangle {
                                            height: 16px;
                                            clip: true;
                                            background: #090d12;
                                            border-color: #202a35;
                                            border-width: 1px;
                                            border-radius: 3px;
                                            Rectangle {
                                                x: parent.width * placement.start-percent / 100;
                                                width: Math.max(2px, parent.width * placement.width-percent / 100);
                                                height: parent.height;
                                                background: placement.active ? #245d78 : placement.enabled ? #34404d : #4a3c34;
                                                border-radius: 3px;
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        width: 64px;
                                        alignment: center;
                                        Text {
                                            text: placement.enabled ? "ENABLED" : "DISABLED";
                                            color: placement.enabled ? #63e6b5 : #b58a67;
                                            font-size: 9px;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            text: placement.active ? "PLAYBACK ACTIVE" : "PLAYBACK BLOCKED";
                                            color: placement.active ? #6f8197 : #65758a;
                                            font-size: 7px;
                                            horizontal-alignment: center;
                                        }
                                    }
                                    VerticalLayout {
                                        width: 244px;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            height: 44px;
                                            spacing: 4px;
                                            VerticalLayout {
                                                width: 82px;
                                                spacing: 2px;
                                                Text {
                                                    text: "START TICK";
                                                    color: #6f8197;
                                                    font-size: 8px;
                                                }
                                                start-tick-input := LineEdit {
                                                    width: 82px;
                                                    horizontal-stretch: 0;
                                                    text: placement.start-tick;
                                                    accessible-label: "Start tick for " + placement.clip-name + " on " + placement.track-name;
                                                    accepted => { IdeActions.move-arrangement-placement(placement.id, self.text); }
                                                }
                                            }
                                            Button {
                                                width: 50px;
                                                text: "Move";
                                                accessible-label: "Move " + placement.clip-name + " on " + placement.track-name + " to entered start tick";
                                                enabled: root.app-mode == AppMode.running && start-tick-input.text != placement.start-tick;
                                                clicked => { IdeActions.move-arrangement-placement(placement.id, start-tick-input.text); }
                                            }
                                            Button {
                                                width: 50px;
                                                text: "Left";
                                                accessible-label: "Trim the left edge of " + placement.clip-name + " on " + placement.track-name + " to entered start tick while preserving its right edge";
                                                enabled: root.app-mode == AppMode.running && start-tick-input.text != placement.start-tick;
                                                clicked => { IdeActions.trim-arrangement-placement-front(placement.id, start-tick-input.text); }
                                            }
                                            Button {
                                                width: 50px;
                                                text: "Split";
                                                accessible-label: "Split " + placement.clip-name + " on " + placement.track-name + " at the entered project tick without ripple";
                                                enabled: root.app-mode == AppMode.running && start-tick-input.text != placement.start-tick;
                                                clicked => { IdeActions.split-arrangement-placement(placement.id, start-tick-input.text); }
                                            }
                                        }
                                        HorizontalLayout {
                                            height: 44px;
                                            spacing: 4px;
                                            VerticalLayout {
                                                width: 82px;
                                                spacing: 2px;
                                                Text {
                                                    text: "DURATION TICKS";
                                                    color: #6f8197;
                                                    font-size: 8px;
                                                }
                                                duration-tick-input := LineEdit {
                                                    width: 82px;
                                                    horizontal-stretch: 0;
                                                    text: placement.duration-ticks;
                                                    accessible-label: "Duration ticks for " + placement.clip-name + " on " + placement.track-name;
                                                    accepted => { IdeActions.set-arrangement-placement-duration(placement.id, self.text); }
                                                }
                                            }
                                            Button {
                                                width: 50px;
                                                text: "Trim";
                                                accessible-label: "Set the right edge of " + placement.clip-name + " on " + placement.track-name + " from its entered duration";
                                                enabled: root.app-mode == AppMode.running && duration-tick-input.text != placement.duration-ticks;
                                                clicked => { IdeActions.set-arrangement-placement-duration(placement.id, duration-tick-input.text); }
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        width: 58px;
                                        spacing: 4px;
                                        Button {
                                            text: "Locate";
                                            accessible-label: "Locate to " + placement.clip-name + " on " + placement.track-name;
                                            enabled: root.app-mode == AppMode.running;
                                            clicked => { IdeActions.locate-placement(placement.index); }
                                        }
                                        Button {
                                            text: "Copy";
                                            accessible-label: "Copy the exact source view of " + placement.clip-name + " on " + placement.track-name + " to the entered start tick without ripple";
                                            enabled: root.app-mode == AppMode.running && start-tick-input.text != placement.start-tick;
                                            clicked => { IdeActions.duplicate-arrangement-placement(placement.id, start-tick-input.text); }
                                        }
                                        Button {
                                            text: "Remove";
                                            accessible-label: "Review removal of " + placement.clip-name + " from " + placement.track-name;
                                            enabled: root.app-mode == AppMode.running;
                                            clicked => {
                                                root.remove-arrangement-placement-id = placement.id;
                                                root.remove-arrangement-placement-clip-name = placement.clip-name;
                                                root.remove-arrangement-placement-track-name = placement.track-name;
                                                root.remove-arrangement-placement-visible = true;
                                            }
                                        }
                                    }
                                    Button {
                                        width: 58px;
                                        text: placement.enabled ? "Disable" : "Enable";
                                        accessible-label: (placement.enabled ? "Disable " : "Enable ") + placement.clip-name + " on " + placement.track-name;
                                        enabled: root.app-mode == AppMode.running;
                                        clicked => { IdeActions.set-arrangement-placement-active(placement.index, !placement.enabled); }
                                    }
                                }
                            }
                        }

                        if !root.remove-arrangement-placement-visible : Text {
                            text: "Exact non-ripple copies, splits, moves, edge trims, activation, and confirmed removal persist. Splits preserve contiguous source playback. No drag, snap, or waveform editing.";
                            color: #65758a;
                            font-size: 9px;
                        }
                    }
                }

                if root.clips-visible && !root.clip-rename-visible && !root.clip-duplicate-visible && !root.clip-gain-visible && !root.clip-fades-visible && !root.clip-loop-visible && !root.clip-source-slip-visible && !root.add-arrangement-placement-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        HorizontalLayout {
                            height: 48px;
                            VerticalLayout {
                                Text { text: "AUDIO CLIPS"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                                Text { text: "Reusable verified source views · exact placement · global activation, direction, gain, loop, and linear fades"; color: #aebccc; font-size: 12px; }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Performance";
                                clicked => { root.clips-visible = false; root.clip-rename-visible = false; root.clip-duplicate-visible = false; root.clip-gain-visible = false; root.clip-fades-visible = false; root.clip-loop-visible = false; root.clip-source-slip-visible = false; root.add-arrangement-placement-visible = false; }
                            }
                            Button {
                                text: "Mixer";
                                enabled: root.app-mode == AppMode.running;
                                clicked => { root.clips-visible = false; root.clip-rename-visible = false; root.clip-duplicate-visible = false; root.clip-gain-visible = false; root.clip-fades-visible = false; root.clip-loop-visible = false; root.clip-source-slip-visible = false; root.add-arrangement-placement-visible = false; root.mixer-visible = true; }
                            }
                        }

                        Rectangle { height: 1px; background: #27313d; }

                        if root.audio-clips.length == 0 : Text {
                            text: "This project contains no audio clips.";
                            color: #8fa0b4;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            vertical-stretch: 1;
                        }

                        if root.audio-clips.length > 0 : ListView {
                            vertical-stretch: 1;
                            for clip in root.audio-clips : Rectangle {
                                height: 116px;
                                width: parent.width;
                                background: #0e141b;
                                border-color: #27313d;
                                border-width: 1px;
                                border-radius: 6px;
                                HorizontalLayout {
                                    padding: 9px;
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: clip.name; color: #edf2f8; font-size: 13px; font-weight: 600; overflow: elide; }
                                        Text { text: clip.track-name; color: #8290a2; font-size: 9px; overflow: elide; }
                                        Text { text: clip.duration-ticks + " ticks · full reusable clip"; color: #65758a; font-size: 8px; overflow: elide; }
                                        Text { text: "SOURCE START  " + clip.source-start-edit + "  ·  VIEW  " + clip.source-frame-count + " FRAMES"; color: #65758a; font-size: 8px; overflow: elide; }
                                    }
                                    VerticalLayout {
                                        width: 142px;
                                        alignment: center;
                                        Text { text: "CLIP GAIN"; color: #65758a; font-size: 8px; horizontal-alignment: center; }
                                        Text { text: clip.gain-label; color: #b9c5d3; font-size: 13px; font-weight: 600; horizontal-alignment: center; }
                                        Text { text: "LOOP  " + clip.loop-label; color: clip.loop-enabled ? #75d7b4 : #8290a2; font-size: 8px; horizontal-alignment: center; overflow: elide; }
                                        Text { text: "DIRECTION  " + clip.direction-label; color: clip.reverse ? #e5b567 : #8290a2; font-size: 8px; horizontal-alignment: center; overflow: elide; }
                                        Text { text: "FADES  " + clip.fade-label; color: #8290a2; font-size: 8px; horizontal-alignment: center; overflow: elide; }
                                    }
                                    VerticalLayout {
                                        width: 292px;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            spacing: 4px;
                                            Button {
                                                width: 88px;
                                                text: "Rename";
                                                accessible-label: "Rename " + clip.name;
                                                enabled: root.app-mode == AppMode.running;
                                                clicked => {
                                                    root.clip-rename-id = clip.id;
                                                    root.clip-rename-original = clip.name;
                                                    root.clip-rename-name = clip.name;
                                                    root.clip-rename-visible = true;
                                                }
                                            }
                                            Button {
                                                width: 100px;
                                                text: "Duplicate";
                                                accessible-label: "Duplicate " + clip.name + " as an independent reusable clip";
                                                enabled: root.app-mode == AppMode.running;
                                                clicked => {
                                                    root.clip-duplicate-id = clip.id;
                                                    root.clip-duplicate-source-name = clip.name;
                                                    root.clip-duplicate-name = "";
                                                    root.clip-duplicate-visible = true;
                                                }
                                            }
                                            Button {
                                                width: 88px;
                                                text: "Place";
                                                accessible-label: "Place the full " + clip.name + " clip at an exact project tick";
                                                enabled: root.app-mode == AppMode.running;
                                                clicked => {
                                                    root.add-arrangement-placement-clip-id = clip.id;
                                                    root.add-arrangement-placement-clip-name = clip.name;
                                                    root.add-arrangement-placement-track-name = clip.track-name;
                                                    root.add-arrangement-placement-duration-ticks = clip.duration-ticks;
                                                    root.add-arrangement-placement-start-tick = "0";
                                                    root.add-arrangement-placement-visible = true;
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            Button {
                                                width: 92px;
                                                text: "Gain";
                                                accessible-label: "Edit gain for " + clip.name;
                                                enabled: root.app-mode == AppMode.running;
                                                clicked => {
                                                    root.clip-gain-id = clip.id;
                                                    root.clip-gain-name = clip.name;
                                                    root.clip-gain-original = clip.gain-edit;
                                                    root.clip-gain-value = clip.gain-edit;
                                                    root.clip-gain-visible = true;
                                                }
                                            }
                                            Button {
                                                width: 92px;
                                                text: "Loop";
                                                accessible-label: "Edit reusable loop for " + clip.name;
                                                enabled: root.app-mode == AppMode.running;
                                                clicked => {
                                                    root.clip-loop-id = clip.id;
                                                    root.clip-loop-name = clip.name;
                                                    root.clip-loop-duration = clip.duration-ticks;
                                                    root.clip-loop-original-enabled = clip.loop-enabled;
                                                    root.clip-loop-original-start = clip.loop-start-edit;
                                                    root.clip-loop-original-end = clip.loop-end-edit;
                                                    root.clip-loop-enabled = clip.loop-enabled;
                                                    root.clip-loop-start = clip.loop-start-edit;
                                                    root.clip-loop-end = clip.loop-end-edit;
                                                    root.clip-loop-visible = true;
                                                }
                                            }
                                            Button {
                                                width: 92px;
                                                text: "Fades";
                                                accessible-label: "Edit linear fades for " + clip.name;
                                                enabled: root.app-mode == AppMode.running;
                                                clicked => {
                                                    root.clip-fades-id = clip.id;
                                                    root.clip-fades-name = clip.name;
                                                    root.clip-fades-duration = clip.duration-ticks;
                                                    root.clip-fades-original-in = clip.fade-in-edit;
                                                    root.clip-fades-original-out = clip.fade-out-edit;
                                                    root.clip-fades-in = clip.fade-in-edit;
                                                    root.clip-fades-out = clip.fade-out-edit;
                                                    root.clip-fades-visible = true;
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            Button {
                                                width: 92px;
                                                text: clip.active ? "Disable" : "Enable";
                                                accessible-label: (clip.active ? "Disable " : "Enable ") + clip.name + " everywhere";
                                                enabled: root.app-mode == AppMode.running;
                                                clicked => { IdeActions.set-audio-clip-active(clip.id, !clip.active); }
                                            }
                                            Button {
                                                width: 92px;
                                                text: clip.reverse ? "Forward" : "Reverse";
                                                accessible-label: (clip.reverse ? "Use forward playback for " : "Use reverse playback for ") + clip.name + " everywhere";
                                                enabled: root.app-mode == AppMode.running;
                                                clicked => { IdeActions.set-audio-clip-reverse(clip.id, !clip.reverse); }
                                            }
                                            Button {
                                                width: 92px;
                                                text: "Slip source";
                                                accessible-label: "Move the immutable source view for " + clip.name + " to an exact frame everywhere";
                                                enabled: root.app-mode == AppMode.running;
                                                clicked => {
                                                    root.clip-source-slip-id = clip.id;
                                                    root.clip-source-slip-name = clip.name;
                                                    root.clip-source-slip-frame-count = clip.source-frame-count;
                                                    root.clip-source-slip-original = clip.source-start-edit;
                                                    root.clip-source-slip-start = clip.source-start-edit;
                                                    root.clip-source-slip-visible = true;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Text {
                            text: "Rename changes metadata only. Duplicate shares immutable source audio but creates no placement. Place creates one full-length non-ripple reference. Activation, direction, source slip, gain, loop, and fades affect every existing reference. Source slip keeps duration and placements fixed; reverse does not reverse transport or rewrite media.";
                            color: #65758a;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                    }
                }

                if root.clips-visible && root.clip-rename-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;
                        Text { text: "RENAME AUDIO CLIP"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: root.clip-rename-original; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                        Text {
                            text: "Enter a display name from 1 to 120 characters. Leading and trailing whitespace is removed before validation.";
                            color: #aebccc;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        LineEdit {
                            text <=> root.clip-rename-name;
                            placeholder-text: "Audio clip name";
                            accessible-label: "New audio clip name";
                        }
                        Text {
                            text: "Clip identity, arrangement placements, owning track, playback settings, and immutable source audio remain unchanged.";
                            color: #65758a;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Cancel"; clicked => { root.clip-rename-visible = false; } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Rename clip";
                                enabled: root.app-mode == AppMode.running
                                    && root.clip-rename-id != ""
                                    && root.clip-rename-name != ""
                                    && root.clip-rename-name != root.clip-rename-original;
                                clicked => { IdeActions.rename-audio-clip(root.clip-rename-id, root.clip-rename-name); }
                            }
                        }
                    }
                }

                if root.clips-visible && root.clip-duplicate-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;
                        Text { text: "DUPLICATE AUDIO CLIP"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: root.clip-duplicate-source-name; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                        Text {
                            text: "Enter a name from 1 to 120 characters for the new reusable clip. Leading and trailing whitespace is removed before validation.";
                            color: #aebccc;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        LineEdit {
                            text <=> root.clip-duplicate-name;
                            placeholder-text: "New audio clip name";
                            accessible-label: "Duplicated audio clip name";
                        }
                        Text {
                            text: "The duplicate receives a new identity and independent clip metadata. It keeps the same verified source view and owning track. No audio media or arrangement placement is created.";
                            color: #65758a;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Cancel"; clicked => { root.clip-duplicate-visible = false; } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: root.app-mode == AppMode.duplicating-clip ? "Duplicating clip..." : "Duplicate clip";
                                enabled: root.app-mode == AppMode.running
                                    && root.clip-duplicate-id != ""
                                    && root.clip-duplicate-name != "";
                                clicked => { IdeActions.duplicate-audio-clip(root.clip-duplicate-id, root.clip-duplicate-name); }
                            }
                        }
                    }
                }

                if root.clips-visible && !root.clip-rename-visible && !root.clip-duplicate-visible && root.add-arrangement-placement-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;
                        Text { text: "PLACE CLIP IN ARRANGEMENT"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: root.add-arrangement-placement-clip-name; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                        Text {
                            text: root.add-arrangement-placement-track-name + " · " + root.add-arrangement-placement-duration-ticks + " ticks";
                            color: #aebccc;
                            font-size: 11px;
                            overflow: elide;
                        }
                        Text {
                            text: "Enter the exact project start tick. This creates one new, enabled placement of the complete reusable clip on its owning track.";
                            color: #aebccc;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        LineEdit {
                            text <=> root.add-arrangement-placement-start-tick;
                            placeholder-text: "0";
                            accessible-label: "Arrangement placement start tick";
                        }
                        Text {
                            text: "The edit is non-ripple: existing placements keep their exact ticks. The reusable clip and immutable source audio are unchanged. Overlap and conflicting scene authority are rejected.";
                            color: #65758a;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Cancel"; clicked => { root.add-arrangement-placement-visible = false; } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Place full clip";
                                enabled: root.app-mode == AppMode.running
                                    && root.add-arrangement-placement-clip-id != ""
                                    && root.add-arrangement-placement-start-tick != "";
                                clicked => {
                                    IdeActions.add-arrangement-placement(
                                        root.add-arrangement-placement-clip-id,
                                        root.add-arrangement-placement-start-tick
                                    );
                                }
                            }
                        }
                    }
                }

                if root.clips-visible && !root.clip-rename-visible && !root.clip-duplicate-visible && root.clip-gain-visible && !root.clip-fades-visible && !root.clip-loop-visible && !root.add-arrangement-placement-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;
                        Text { text: "EDIT CLIP GAIN"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: root.clip-gain-name; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                        Text {
                            text: "Enter constant gain in dB. Values must be finite and at or below the native +6.0206 dB limit. Negative values attenuate; 0 dB is unity.";
                            color: #aebccc;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        LineEdit {
                            text <=> root.clip-gain-value;
                            placeholder-text: "0";
                            accessible-label: "Audio clip gain in decibels";
                        }
                        Text {
                            text: "This edits the reusable clip everywhere it is referenced. It does not normalize audio or change the source asset.";
                            color: #65758a;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Cancel"; clicked => { root.clip-gain-visible = false; } }
                            Button { text: "Reset to 0 dB"; clicked => { root.clip-gain-value = "0"; } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Apply gain";
                                enabled: root.app-mode == AppMode.running
                                    && root.clip-gain-id != ""
                                    && root.clip-gain-value != ""
                                    && root.clip-gain-value != root.clip-gain-original;
                                clicked => { IdeActions.set-audio-clip-gain(root.clip-gain-id, root.clip-gain-value); }
                            }
                        }
                    }
                }

                if root.clips-visible && !root.clip-rename-visible && !root.clip-duplicate-visible && !root.clip-gain-visible && root.clip-fades-visible && !root.clip-loop-visible && !root.add-arrangement-placement-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;
                        Text { text: "EDIT CLIP FADES"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: root.clip-fades-name; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                        Text {
                            text: "Enter exact fade-in and fade-out durations in project ticks. Their combined duration may not exceed the clip's " + root.clip-fades-duration + " ticks.";
                            color: #aebccc;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        GridLayout {
                            spacing: 8px;
                            Text { text: "Fade in"; color: #8fa0b4; vertical-alignment: center; }
                            LineEdit { text <=> root.clip-fades-in; placeholder-text: "0"; accessible-label: "Audio clip fade-in ticks"; }
                            Text { text: "Fade out"; color: #8fa0b4; vertical-alignment: center; }
                            LineEdit { text <=> root.clip-fades-out; placeholder-text: "0"; accessible-label: "Audio clip fade-out ticks"; }
                        }
                        Text {
                            text: "The fixed curve is linear amplitude. This edits the reusable clip everywhere it is referenced; it is not an arrangement crossfade and does not change source audio.";
                            color: #65758a;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Cancel"; clicked => { root.clip-fades-visible = false; } }
                            Button { text: "Reset fades"; clicked => { root.clip-fades-in = "0"; root.clip-fades-out = "0"; } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Apply fades";
                                enabled: root.app-mode == AppMode.running
                                    && root.clip-fades-id != ""
                                    && root.clip-fades-in != ""
                                    && root.clip-fades-out != ""
                                    && (root.clip-fades-in != root.clip-fades-original-in
                                        || root.clip-fades-out != root.clip-fades-original-out);
                                clicked => { IdeActions.set-audio-clip-fades(root.clip-fades-id, root.clip-fades-in, root.clip-fades-out); }
                            }
                        }
                    }
                }

                if root.clips-visible && !root.clip-rename-visible && !root.clip-duplicate-visible && !root.clip-gain-visible && !root.clip-fades-visible && root.clip-loop-visible && !root.add-arrangement-placement-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;
                        Text { text: "EDIT REUSABLE CLIP LOOP"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: root.clip-loop-name; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                        Text {
                            text: "Set an exact non-empty loop range within the clip's " + root.clip-loop-duration + " ticks. The stored range remains valid when looping is disabled.";
                            color: #aebccc;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Button {
                            text: root.clip-loop-enabled ? "Loop enabled" : "Loop disabled";
                            accessible-label: root.clip-loop-enabled ? "Disable reusable clip loop" : "Enable reusable clip loop";
                            clicked => { root.clip-loop-enabled = !root.clip-loop-enabled; }
                        }
                        GridLayout {
                            spacing: 8px;
                            Text { text: "Loop start"; color: #8fa0b4; vertical-alignment: center; }
                            LineEdit { text <=> root.clip-loop-start; placeholder-text: "0"; accessible-label: "Audio clip loop start tick"; }
                            Text { text: "Loop end"; color: #8fa0b4; vertical-alignment: center; }
                            LineEdit { text <=> root.clip-loop-end; placeholder-text: root.clip-loop-duration; accessible-label: "Audio clip loop end tick"; }
                        }
                        Text {
                            text: "This edits the reusable clip everywhere it is referenced. It is not the transport loop, does not repeat arrangement placements, and does not change source audio.";
                            color: #65758a;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Cancel"; clicked => { root.clip-loop-visible = false; } }
                            Button {
                                text: "Full clip";
                                clicked => { root.clip-loop-start = "0"; root.clip-loop-end = root.clip-loop-duration; }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Apply loop";
                                enabled: root.app-mode == AppMode.running
                                    && root.clip-loop-id != ""
                                    && root.clip-loop-start != ""
                                    && root.clip-loop-end != ""
                                    && (root.clip-loop-enabled != root.clip-loop-original-enabled
                                        || root.clip-loop-start != root.clip-loop-original-start
                                        || root.clip-loop-end != root.clip-loop-original-end);
                                clicked => {
                                    IdeActions.set-audio-clip-loop(
                                        root.clip-loop-id,
                                        root.clip-loop-enabled,
                                        root.clip-loop-start,
                                        root.clip-loop-end
                                    );
                                }
                            }
                        }
                    }
                }

                if root.clips-visible && !root.clip-rename-visible && !root.clip-duplicate-visible && !root.clip-gain-visible && !root.clip-fades-visible && !root.clip-loop-visible && root.clip-source-slip-visible && !root.add-arrangement-placement-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;
                        Text { text: "SLIP REUSABLE CLIP SOURCE"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: root.clip-source-slip-name; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                        Text {
                            text: "Enter the exact first frame for this " + root.clip-source-slip-frame-count + "-frame view. The complete view must remain inside the verified audio asset.";
                            color: #aebccc;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        GridLayout {
                            spacing: 8px;
                            Text { text: "Source start frame"; color: #8fa0b4; vertical-alignment: center; }
                            LineEdit { text <=> root.clip-source-slip-start; placeholder-text: "0"; accessible-label: "Audio clip source start frame"; }
                        }
                        Text {
                            text: "This is a nondestructive global slip of the reusable clip. Duration, warp, loop, fades, arrangement timing, scene references, and media bytes remain unchanged.";
                            color: #65758a;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Cancel"; clicked => { root.clip-source-slip-visible = false; } }
                            Button { text: "Asset start"; clicked => { root.clip-source-slip-start = "0"; } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Apply source slip";
                                enabled: root.app-mode == AppMode.running
                                    && root.clip-source-slip-id != ""
                                    && root.clip-source-slip-start != ""
                                    && root.clip-source-slip-start != root.clip-source-slip-original;
                                clicked => { IdeActions.set-audio-clip-source-start(root.clip-source-slip-id, root.clip-source-slip-start); }
                            }
                        }
                    }
                }

                if root.loudness-visible && !root.clips-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        HorizontalLayout {
                            height: 48px;
                            VerticalLayout {
                                Text { text: "LIVE LOUDNESS"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                                Text { text: "Final stereo output · programme " + root.loudness-programme-time; color: #aebccc; font-size: 12px; }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text {
                                width: 82px;
                                text: root.loudness-state;
                                color: root.loudness-state == "RUNNING" ? #63e6b5 : root.loudness-state == "STANDBY" ? #f5b83d : #8fa0b4;
                                font-size: 10px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            Button {
                                text: "Performance";
                                clicked => { root.loudness-reset-confirming = false; root.loudness-visible = false; root.arrangement-visible = false; root.mixer-visible = false; root.mixer-sends-visible = false; root.takes-visible = false; }
                            }
                            Button {
                                text: "Mixer";
                                enabled: root.app-mode == AppMode.running;
                                clicked => { root.loudness-reset-confirming = false; root.loudness-visible = false; root.arrangement-visible = false; root.mixer-visible = true; root.mixer-sends-visible = false; root.takes-visible = false; }
                            }
                        }

                        Rectangle { height: 1px; background: #27313d; }

                        HorizontalLayout {
                            height: 34px;
                            spacing: 6px;
                            Text { width: 104px; text: "PRESENTATION"; color: #65758a; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                            Button {
                                text: root.loudness-wide-scale ? "EBU +9" : "✓ EBU +9";
                                clicked => { root.loudness-wide-scale = false; }
                            }
                            Button {
                                text: root.loudness-wide-scale ? "✓ EBU +18" : "EBU +18";
                                clicked => { root.loudness-wide-scale = true; }
                            }
                            Button {
                                text: root.loudness-relative ? "LUFS" : "✓ LUFS";
                                clicked => { root.loudness-relative = false; }
                            }
                            Button {
                                text: root.loudness-relative ? "✓ LU" : "LU";
                                clicked => { root.loudness-relative = true; }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: root.loudness-scale-name; color: #8290a2; font-size: 10px; vertical-alignment: center; }
                        }

                        GridLayout {
                            spacing: 8px;
                            LoudnessCard { row: 0; col: 0; height: 128px; label: "M · MOMENTARY"; value: root.loudness-momentary; detail: "400 ms · live in run and standby"; }
                            LoudnessCard { row: 0; col: 1; height: 128px; label: "S · SHORT-TERM"; value: root.loudness-short-term; detail: "3 s · live in run and standby"; }
                            LoudnessCard { row: 0; col: 2; height: 128px; label: "I · INTEGRATED"; value: root.loudness-integrated; detail: "Gated programme measurement"; primary: true; }
                        }

                        GridLayout {
                            spacing: 8px;
                            LoudnessCard { row: 0; col: 0; height: 96px; label: "MAX M"; value: root.loudness-maximum-momentary; detail: "Since reset"; }
                            LoudnessCard { row: 0; col: 1; height: 96px; label: "MAX S"; value: root.loudness-maximum-short-term; detail: "Since reset"; }
                            LoudnessCard { row: 0; col: 2; height: 96px; label: "LOUDNESS RANGE"; value: root.loudness-range; detail: root.loudness-lra-status; }
                            LoudnessCard { row: 0; col: 3; height: 96px; label: "MAX TRUE PEAK"; value: root.loudness-maximum-true-peak; detail: "Final output · since reset"; }
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }

                        if !root.loudness-reset-confirming : HorizontalLayout {
                            height: 42px;
                            spacing: 8px;
                            Text { width: 104px; text: "MEASUREMENT"; color: #65758a; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                            Button {
                                text: "Run";
                                enabled: root.app-mode == AppMode.running && root.loudness-available && root.loudness-state != "RUNNING";
                                clicked => { IdeActions.loudness-run(); }
                            }
                            Button {
                                text: "Standby";
                                enabled: root.app-mode == AppMode.running && root.loudness-available && root.loudness-state != "STANDBY";
                                clicked => { IdeActions.loudness-standby(); }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Reset measurement";
                                enabled: root.app-mode == AppMode.running && root.loudness-available;
                                clicked => { root.loudness-reset-confirming = true; }
                            }
                        }

                        if root.loudness-reset-confirming : HorizontalLayout {
                            height: 42px;
                            spacing: 8px;
                            Text { horizontal-stretch: 1; text: "Reset I, LRA, maximum M/S and maximum true peak?"; color: #ffbf9b; font-size: 11px; vertical-alignment: center; }
                            Button { text: "Cancel"; clicked => { root.loudness-reset-confirming = false; } }
                            Button {
                                text: "Confirm reset";
                                enabled: root.app-mode == AppMode.running && root.loudness-available;
                                clicked => { IdeActions.loudness-reset(); }
                            }
                        }

                        Text {
                            height: 26px;
                            text: "Measurement only · standby keeps M/S live · no normalization, limiting, or certified EBU Mode claim.";
                            color: #65758a;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        Rectangle {
            height: root.error-text == "" ? 38px : 52px;
            border-radius: 6px;
            background: root.error-text == "" ? #111820 : #3b2022;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                Text {
                    text: root.error-text == "" ? root.status-text : root.error-text;
                    color: root.error-text == "" ? #8494a8 : #ffaaa6;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
