component Panel inherits Rectangle {
    background: #141a22;
    border-color: #27313d;
    border-width: 1px;
    border-radius: 8px;
}

component Meter inherits Rectangle {
    in property <float> level: 0;
    in property <string> channel-name;
    in property <string> reading: "—";

    background: #090d12;
    border-color: #27313d;
    border-width: 1px;
    border-radius: 5px;

    Rectangle {
        x: 5px;
        y: 5px + (parent.height - 34px) * (1 - root.level);
        width: parent.width - 10px;
        height: (parent.height - 34px) * root.level;
        border-radius: 3px;
        background: root.level > 0.92 ? #ff5a55 : root.level > 0.72 ? #f5b83d : #3ddc97;
    }

    Text {
        x: 0;
        y: parent.height - 25px;
        width: parent.width;
        text: root.channel-name;
        color: #95a3b5;
        font-size: 11px;
        horizontal-alignment: center;
    }

    Text {
        x: 0;
        y: 8px;
        width: parent.width;
        text: root.reading;
        color: #e7edf5;
        font-size: 11px;
        horizontal-alignment: center;
    }
}

component LoudnessCard inherits Rectangle {
    in property <string> label;
    in property <string> value: "—";
    in property <string> detail;
    in property <bool> primary: false;

    background: root.primary ? #102536 : #0e141b;
    border-color: root.primary ? #37769a : #27313d;
    border-width: 1px;
    border-radius: 6px;

    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        Text { text: root.label; color: #65758a; font-size: 9px; font-weight: 700; letter-spacing: 0.6px; }
        Text { text: root.value; color: root.primary ? #edf2f8 : #dce5ef; font-size: root.primary ? 23px : 18px; font-weight: 600; overflow: elide; }
        Text { text: root.detail; color: #8290a2; font-size: 9px; overflow: elide; }
    }
}

