    private property <bool> project-form-visible:
        root.new-project-visible || root.new-track-visible;
    private property <bool> audio-import-available:
        root.app-mode == AppMode.running
        && !root.project-form-visible
        && root.clips-visible
        && !root.clip-rename-visible
        && !root.clip-duplicate-visible
        && !root.clip-remove-visible
        && !root.clip-gain-visible
        && !root.clip-fades-visible
        && !root.clip-loop-visible
        && !root.clip-source-slip-visible
        && !root.clip-source-trim-visible
        && !root.add-arrangement-placement-visible
        && root.selected-audio-import-track-index >= 0
        && root.selected-audio-import-track-index < root.audio-import-track-names.length;
