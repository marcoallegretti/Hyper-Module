}

export struct SceneRow {
    index: int,
    id: string,
    name: string,
    display-name: string,
    availability: string,
    runtime-state: string,
    active: bool,
    launchable: bool,
    queued: bool,
    current: bool,
}

export struct SceneSlotRow {
    index: int,
    track-name: string,
    action: string,
    detail: string,
}

export struct MixerChannelRow {
    index: int,
    track-id: string,
    name: string,
    display-name: string,
    kind: string,
    state-available: bool,
    gain-percent: float,
    pan-percent: float,
    muted: bool,
    solo: bool,
    solo-available: bool,
    renameable: bool,
    removable: bool,
    active: bool,
    activation-toggleable: bool,
}

export struct MixerSendRow {
    index: int,
    channel-index: int,
    send-index: int,
    source-name: string,
    target-name: string,
    tap: string,
    state-available: bool,
    gain-percent: float,
    pan-percent: float,
    enabled: bool,
}

export struct NativeDeviceRow {
    index: int,
    chain-id: string,
    device-instance-id: string,
    track-id: string,
    track-name: string,
    enabled: bool,
    can-move-earlier: bool,
    can-move-later: bool,
    can-duplicate: bool,
    kind-index: int,
    kind-name: string,
    detail: string,
    mode-index: int,
    mode-name: string,
    cutoff-millihertz: string,
    cutoff-label: string,
    resonance-millionths: string,
    resonance-label: string,
    threshold-millidecibels: string,
    ratio-millionths: string,
    attack-microseconds: string,
    release-microseconds: string,
    makeup-millidecibels: string,
}

export struct TakeRow {
    index: int,
    track-name: string,
    captured-at: string,
    detail: string,
    timeline-start: string,
    active: bool,
    state: string,
}

export struct ArrangementRow {
    index: int,
    id: string,
    track-name: string,
    clip-name: string,
    start-tick: string,
    clip-start-tick: string,
    duration-ticks: string,
    start-clock: string,
    end-clock: string,
    start-percent: float,
    width-percent: float,
    enabled: bool,
    active: bool,
}

export struct ControlBindingRow {
    id: string,
    enabled: bool,
    source: string,
    scope: string,
    target: string,
    transform: string,
}

export struct AutomationTakeRow {
    id: string,
    name: string,
    enabled: bool,
    range: string,
    target: string,
    interpolation: string,
    points: string,
}

export struct ArrangementSceneLaunchRow {
    index: int,
    id: string,
    scene-index: int,
    scene-id: string,
    scene-name: string,
    tick: string,
}

export struct ClipRow {
    id: string,
    name: string,
    track-name: string,
    duration-ticks: string,
    source-start-edit: string,
    source-frame-count: string,
    active: bool,
    gain-label: string,
    gain-edit: string,
    loop-enabled: bool,
    loop-label: string,
    loop-start-edit: string,
    loop-end-edit: string,
    reverse: bool,
    direction-label: string,
    fade-label: string,
    fade-in-edit: string,
    fade-out-edit: string,
}

