    in property <[bool]> control-target-continuous: [];
    in property <[bool]> control-target-boolean: [];
    in property <[string]> control-target-range: [];
    in-out property <bool> mixer-control-visible: false;
    in property <bool> export-available: false;
    in property <string> export-destination: "";
    in property <string> export-summary: "";
    in property <string> runtime-bundle-destination: "";
    in property <string> runtime-bundle-summary: "";
    in property <string> undo-label: "";
    in property <string> redo-label: "";
    in property <bool> undo-available: false;
    in property <bool> redo-available: false;
    in-out property <bool> control-create-visible: false;
    in-out property <int> control-create-source-index: 0;
    in-out property <int> control-create-target-index: 0;
    in-out property <bool> control-create-momentary: false;
    in-out property <string> control-create-output-min: "0";
    in-out property <string> control-create-output-max: "1000000";
    in property <[string]> automation-target-names: [];
    in property <[bool]> automation-target-boolean: [];
    in property <[string]> automation-target-domain: [];
    in-out property <bool> mixer-automation-visible: false;
    in-out property <bool> automation-create-visible: false;
    in-out property <string> automation-create-name: "";
    in-out property <int> automation-create-target-index: 0;
    in-out property <int> automation-create-interpolation-index: 0;
    in-out property <string> automation-create-start: "0";
    in-out property <string> automation-create-end: "1920";
    in-out property <string> automation-create-points: "";
    in property <bool> mixer-main-state-available: false;
    in property <float> mixer-main-gain-percent: 0;
    in property <bool> mixer-main-muted: false;
    in property <[string]> recording-target-names: [];
    in-out property <int> selected-recording-target-index: 0;
    in property <string> recording-target: "—";
    in property <string> recording-frame-count: "0";
    in property <string> recording-drop-count: "0";
    in property <[TakeRow]> recording-takes: [];
    in property <[ArrangementRow]> arrangement-placements: [];
    in property <[ArrangementSceneLaunchRow]> arrangement-scene-launches: [];
    in property <[string]> scene-names: [];
    in property <[ClipRow]> audio-clips: [];
    in property <int> unused-sample-assets: 0;
    in property <string> unused-sample-bytes: "0 bytes";
    in-out property <bool> unused-sample-cleanup-confirming: false;
    in property <[string]> audio-import-track-names: [];
    in-out property <int> selected-audio-import-track-index: 0;
    in property <string> arrangement-span-clock: "—";
    in property <bool> preview-active: false;
    in property <float> preview-gain-percent: 25;
    in property <bool> preview-muted: false;
    in property <string> preview-state: "Idle";
    in property <string> preview-progress: "—";
    in property <string> transport-state: "Stopped";
    in property <bool> transport-start-available: false;
    in property <bool> transport-stop-available: false;
    in property <string> stream-state: "No stream";
    in property <string> frame-position: "0";
    in property <string> musical-position: "";
    in property <string> transport-clock: "00:00:00.000";
    in property <bool> transport-extent-bounded: false;
    in property <bool> transport-seek-available: false;
    in property <string> loop-summary: "";
    in property <bool> loop-marking-available: false;
    in property <bool> loop-toggle-available: false;
    in property <bool> loop-engaged: false;
    in property <string> tempo-bpm: "";
    in property <bool> tempo-available: false;
    in property <string> tempo-locked-reason: "";
    in property <string> meter-signature: "";
    in property <bool> meter-available: false;
    in property <float> transport-progress-percent: 0;
    in property <string> transport-end-clock: "—";
    in property <string> callback-count: "0";
    in property <string> xrun-count: "Unavailable";
    in property <float> left-meter: 0;
    in property <float> right-meter: 0;
    in property <string> left-reading: "—";
    in property <string> right-reading: "—";
    in property <string> status-text: "Discovering desktop audio outputs…";
    in property <string> error-text: "";
    private property <bool> performance-visible:
        !root.project-form-visible
        && !root.mixer-visible
        && !root.takes-visible
        && !root.arrangement-visible
        && !root.clips-visible
        && !root.loudness-visible
        && !root.scene-create-visible
        && !root.scene-rename-visible
        && !root.scene-duplicate-visible
        && !root.scene-slots-visible;

    keyboard := FocusScope {
        width: parent.width;
        height: parent.height;

        capture-key-pressed(event) => {
            if !event.repeat && event.text == Key.Escape {
                if root.new-project-visible && root.app-mode == AppMode.closed {
                    root.new-project-visible = false;
                    return accept;
                }
                if root.new-track-visible && root.app-mode == AppMode.running {
                    root.new-track-visible = false;
                    return accept;
                }
            }
            reject
        }

        key-pressed(event) => {
            if event.text == Key.Space {
                if !event.repeat
                    && !event.modifiers.control
                    && !event.modifiers.shift
                    && !event.modifiers.alt
                    && !event.modifiers.meta
                    && root.app-mode == AppMode.running
                    && root.performance-visible {
                    if root.transport-start-available {
                        IdeActions.transport-start();
                    } else if root.transport-stop-available {
                        IdeActions.transport-stop();
                    }
                }
                return accept;
            }
            if event.modifiers.control && !event.repeat && (event.text == "z" || event.text == "Z") {
                if event.modifiers.shift {
                    if root.redo-available {
                        IdeActions.redo-edit();
                    }
                } else if root.undo-available {
                    IdeActions.undo-edit();
                }
                return accept;
            }
            if event.modifiers.control && !event.repeat && (event.text == "y" || event.text == "Y") {
                if root.redo-available {
                    IdeActions.redo-edit();
                }
                return accept;
            }
            if event.modifiers.control && !event.modifiers.shift && !event.repeat && (event.text == "s" || event.text == "S") {
                if root.app-mode == AppMode.running && root.mixer-main-state-available {
                    IdeActions.save-project();
                }
                return accept;
            }
            if event.modifiers.control && !event.modifiers.shift && !event.repeat && (event.text == "n" || event.text == "N") {
                if root.app-mode == AppMode.closed && !root.new-project-visible && !root.new-track-visible {
                    root.new-project-visible = true;
                }
                return accept;
            }
            if event.modifiers.control && !event.modifiers.shift && !event.repeat && (event.text == "o" || event.text == "O") {
                if root.app-mode == AppMode.closed && !root.new-project-visible && !root.new-track-visible {
                    IdeActions.choose-project();
                }
                return accept;
            }
            if event.modifiers.control && !event.modifiers.shift && !event.repeat && (event.text == "t" || event.text == "T") {
                if root.app-mode == AppMode.running && root.track-count < 8 && !root.new-project-visible && !root.new-track-visible {
                    root.new-track-visible = true;
                }
                return accept;
            }
            if event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt && !event.modifiers.meta && !event.repeat && (event.text == "i" || event.text == "I") {
                if root.audio-import-available {
                    IdeActions.choose-audio-import(root.selected-audio-import-track-index);
                }
                return accept;
            }
            if event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt && !event.modifiers.meta && !event.repeat && (event.text == "w" || event.text == "W") {
                if (root.app-mode == AppMode.running || root.app-mode == AppMode.previewing) && !root.new-project-visible && !root.new-track-visible {
                    IdeActions.close-project();
                }
                return accept;
            }
            reject
        }

    VerticalLayout {
        padding-left: 22px;
        padding-right: 22px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 10px;

        HorizontalLayout {
            height: 58px;

            VerticalLayout {
                spacing: 1px;
                Text {
                    text: "HYPER MODULE";
                    color: #f2f6fb;
                    font-size: 23px;
                    font-weight: 700;
                }
                Text {
                    text: "DESKTOP IDE  /  PLAYBACK CONTROL";
                    color: #65758a;
                    font-size: 11px;
                    letter-spacing: 1.4px;
                }
            }

            Rectangle { horizontal-stretch: 1; background: transparent; }

            Rectangle {
                width: 144px;
                height: 31px;
                border-radius: 16px;
                background: root.app-mode == AppMode.recording ? #542126
                    : root.app-mode == AppMode.previewing ? #173447
                    : root.app-mode == AppMode.output-testing ? #4a3514
                    : root.app-mode == AppMode.running ? #173d31
                    : root.app-mode == AppMode.unavailable ? #492323 : #222b36;
                Text {
                    text: root.app-mode == AppMode.recording ? "●  RECORDING"
                        : root.app-mode == AppMode.previewing ? "▶  AUDITION"
                        : root.app-mode == AppMode.preparing-preview ? "◌  PREPARING"
                        : root.app-mode == AppMode.preparing-recording ? "◌  PREPARING"
                        : root.app-mode == AppMode.finalizing-recording ? "◌  FINALIZING"
                        : root.app-mode == AppMode.starting-output-test ? "◌  STARTING TEST"
                        : root.app-mode == AppMode.output-testing ? "●  OUTPUT TEST"
                        : root.app-mode == AppMode.stopping-output-test ? "◌  STOPPING TEST"
                        : root.app-mode == AppMode.running ? "●  RUNNING"
                        : root.app-mode == AppMode.creating ? "◌  CREATING"
                        : root.app-mode == AppMode.opening ? "◌  OPENING"
                        : root.app-mode == AppMode.saving ? "◌  SAVING"
                        : root.app-mode == AppMode.preparing-runtime ? "◌  PREPARING RUNTIME"
                        : root.app-mode == AppMode.adding-track ? "◌  ADDING TRACK"
                        : root.app-mode == AppMode.removing-track ? "◌  REMOVING TRACK"
                        : root.app-mode == AppMode.renaming-track ? "◌  RENAMING TRACK"
                        : root.app-mode == AppMode.changing-track-activation ? "◌  UPDATING TRACK"
                        : root.app-mode == AppMode.adding-arrangement-placement ? "◌  PLACING CLIP"
                        : root.app-mode == AppMode.adding-arrangement-scene-launch ? "◌  ADDING SCENE MARKER"
                        : root.app-mode == AppMode.moving-arrangement-scene-launch ? "◌  MOVING SCENE MARKER"
                        : root.app-mode == AppMode.changing-arrangement-scene-launch-scene ? "◌  CHANGING SCENE"
                        : root.app-mode == AppMode.removing-arrangement-scene-launch ? "◌  REMOVING SCENE MARKER"
                        : root.app-mode == AppMode.duplicating-arrangement-placement ? "◌  COPYING PLACEMENT"
                        : root.app-mode == AppMode.changing-arrangement-activation ? "◌  UPDATING CLIP"
                        : root.app-mode == AppMode.moving-arrangement-placement ? "◌  MOVING CLIP"
                        : root.app-mode == AppMode.trimming-arrangement-placement ? "◌  TRIMMING CLIP"
                        : root.app-mode == AppMode.removing-arrangement-placement ? "◌  REMOVING CLIP"
                        : root.app-mode == AppMode.changing-clip-activation ? "◌  UPDATING CLIP"
                        : root.app-mode == AppMode.changing-clip-gain ? "◌  UPDATING GAIN"
                        : root.app-mode == AppMode.changing-clip-fades ? "◌  UPDATING FADES"
                        : root.app-mode == AppMode.changing-clip-loop ? "◌  UPDATING LOOP"
                        : root.app-mode == AppMode.changing-clip-reverse ? "◌  UPDATING DIRECTION"
                        : root.app-mode == AppMode.changing-clip-source ? "◌  SLIPPING SOURCE"
                        : root.app-mode == AppMode.trimming-clip-source ? "◌  TRIMMING SOURCE"
                        : root.app-mode == AppMode.creating-clip ? "◌  CREATING CLIP"
                        : root.app-mode == AppMode.importing-audio ? "◌  IMPORTING AUDIO"
                        : root.app-mode == AppMode.selecting ? "◌  SELECTING"
                        : root.app-mode == AppMode.closing ? "◌  CLOSING"
                        : root.app-mode == AppMode.closed ? "●  READY"
                        : root.app-mode == AppMode.unavailable ? "●  UNAVAILABLE"
                        : "◌  DISCOVERING";
                    color: root.app-mode == AppMode.recording ? #ff8b87
                        : root.app-mode == AppMode.previewing ? #7dcfff
                        : root.app-mode == AppMode.output-testing ? #ffd166
                        : root.app-mode == AppMode.running ? #63e6b5
                        : root.app-mode == AppMode.unavailable ? #ff8b87 : #a9b5c4;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            spacing: 16px;
            horizontal-stretch: 1;
            vertical-stretch: 1;

            VerticalLayout {
                width: 330px;
                spacing: 16px;

                Panel {
                    height: 298px;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 6px;
                        Text { text: "AUDIO I/O"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: "Playback output"; color: #edf2f8; font-size: 14px; font-weight: 600; }
                        output-selector := ComboBox {
                            model: root.output-names;
                            current-index <=> root.selected-output-index;
                            enabled: root.app-mode == AppMode.closed;
                            selected(_) => {
                                root.output-test-confirming = false;
                                IdeActions.select-output(self.current-index);
                            }
                        }
                        if root.app-mode == AppMode.unavailable : HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Retry discovery";
                                clicked => { IdeActions.retry-discovery(); }
                            }
                        }

                        if root.app-mode == AppMode.closed && !root.output-test-confirming : HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Refresh output"; clicked => { IdeActions.refresh-outputs(); } }
                            Button {
                                text: "Test output";
                                clicked => { root.output-test-confirming = true; }
                            }
                        }

                        if root.app-mode == AppMode.closed && root.output-test-confirming : HorizontalLayout {
                            spacing: 6px;
                            Text { horizontal-stretch: 1; text: "Lower monitors first · 1 kHz / −18 dBFS"; color: #ffbf9b; font-size: 9px; vertical-alignment: center; wrap: word-wrap; }
                            Button { text: "Cancel"; clicked => { root.output-test-confirming = false; } }
                            Button { text: "Start"; clicked => { IdeActions.start-output-test(); } }
                        }

                        if root.app-mode == AppMode.starting-output-test || root.app-mode == AppMode.output-testing || root.app-mode == AppMode.stopping-output-test : HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: root.output-test-signal; color: #ffd166; font-size: 9px; font-weight: 600; }
                                Text { text: root.output-test-detail; color: #8290a2; font-size: 8px; overflow: elide; }
                            }
                            Button {
                                text: root.app-mode == AppMode.stopping-output-test ? "Stopping…" : "Stop";
                                enabled: root.app-mode == AppMode.output-testing;
                                clicked => { IdeActions.stop-output-test(); }
                            }
                        }

                        Rectangle { height: 1px; background: #27313d; }

                        HorizontalLayout {
                            Text { text: "INPUT CUE"; color: #edf2f8; font-size: 14px; font-weight: 600; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text {
                                text: root.monitoring-active ? root.monitoring-state : "OFF";
                                color: root.monitoring-active ? #63e6b5 : #728196;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                        }
                        input-selector := ComboBox {
                            model: root.input-names;
                            current-index <=> root.selected-input-index;
                            enabled: root.app-mode == AppMode.closed;
                            selected(_) => { IdeActions.select-input(self.current-index); }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Refresh input";
                                enabled: root.app-mode == AppMode.closed;
                                clicked => { IdeActions.refresh-inputs(); }
                            }
                            Text {
                                text: root.input-discovery-available ? "Ready" : "Unavailable";
                                color: root.input-discovery-available ? #63e6b5 : #ff9d76;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: "GAIN  " + Math.round(root.monitoring-gain-percent) + "%"; color: #8fa0b4; font-size: 9px; }
                                Slider {
                                    minimum: 0;
                                    maximum: 100;
                                    value: root.monitoring-gain-percent;
                                    enabled: (root.app-mode == AppMode.running || root.app-mode == AppMode.recording) && root.monitoring-active;
                                    accessible-label: "Input cue gain";
                                    released(value) => { IdeActions.monitor-gain(value); }
                                }
                            }
                            Button {
                                width: 72px;
                                text: root.monitoring-muted ? "MUTED" : "MUTE";
                                enabled: (root.app-mode == AppMode.running || root.app-mode == AppMode.recording) && root.monitoring-active;
                                clicked => { IdeActions.monitor-mute(); }
                            }
                        }
                        Text { text: "Global post-main cue only; this does not arm or route a track."; color: #728196; font-size: 9px; wrap: word-wrap; }
                    }
                }

                Panel {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        Text { text: "PROJECT"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        if root.new-project-visible : VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 6px;
                            Text { text: "NEW PROJECT NAME"; color: #65758a; font-size: 9px; font-weight: 700; letter-spacing: 0.6px; }
                            IdeLineEdit {
                                text <=> root.new-project-name;
                                enabled: root.app-mode == AppMode.closed;
                                accessible-label: "New project name";
                            }
                            Text {
                                text: "48 kHz · 120 BPM · 4/4 · one audio track";
                                color: #728196;
                                font-size: 9px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: "Cancel";
                                    enabled: root.app-mode == AppMode.closed;
                                    clicked => { root.new-project-visible = false; }
                                }
                                Button {
                                    horizontal-stretch: 1;
                                    text: root.app-mode == AppMode.selecting ? "Selecting location…"
                                        : root.app-mode == AppMode.creating ? "Creating project…"
                                        : "Choose location & create";
                                    enabled: root.app-mode == AppMode.closed && root.new-project-name != "";
                                    clicked => { IdeActions.create-project(root.new-project-name); }
                                }
                            }
                        }
                        if !root.new-project-visible : VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 8px;
                            if root.new-track-visible : VerticalLayout {
                                vertical-stretch: 1;
                                spacing: 6px;
                                Text { text: "NEW AUDIO TRACK"; color: #65758a; font-size: 9px; font-weight: 700; letter-spacing: 0.6px; }
                                IdeLineEdit {
                                    text <=> root.new-track-name;
                                    enabled: root.app-mode == AppMode.running;
                                    accessible-label: "New audio track name";
                                }
                                Text {
                                    text: "Appended after the current tracks with a unity-gain main mix channel.";
                                    color: #728196;
                                    font-size: 9px;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: "Cancel";
                                        enabled: root.app-mode == AppMode.running;
                                        clicked => { root.new-track-visible = false; }
                                    }
                                    Button {
                                        horizontal-stretch: 1;
                                        text: root.app-mode == AppMode.adding-track ? "Adding track…" : "Add audio track";
                                        enabled: root.app-mode == AppMode.running && root.new-track-name != "" && root.track-count < 8;
                                        clicked => { IdeActions.add-audio-track(root.new-track-name); }
                                    }
                                }
                                Text {
                                    text: root.track-count >= 8
                                        ? "Version 1 supports at most eight structural tracks."
                                        : "The current live mixer state is saved before the project is reopened.";
                                    color: root.track-count >= 8 ? #ffaaa6 : #728196;
                                    font-size: 9px;
                                    wrap: word-wrap;
                                }
                            }
                            if !root.new-track-visible : VerticalLayout {
                                spacing: 8px;
                            Text { text: root.project-name; color: #edf2f8; font-size: 18px; font-weight: 600; overflow: elide; }
                            Text { text: root.project-location; color: #8290a2; font-size: 11px; wrap: word-wrap; vertical-stretch: 1; }
                            if root.app-mode == AppMode.closed && root.recent-project-names.length > 0 : VerticalLayout {
                                spacing: 4px;
                                Text { text: "RECENT PROJECTS"; color: #65758a; font-size: 9px; font-weight: 700; letter-spacing: 0.6px; }
                                Text { text: "Select a project to verify and open it."; color: #728196; font-size: 9px; }
                                ListView {
                                    height: Math.min(root.recent-project-names.length * 34px, 116px);
                                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                    for project-name[index] in root.recent-project-display-names : Button {
                                        width: 100%;
                                        height: 30px;
                                        text: project-name;
                                        accessible-label: "Open recent project " + root.recent-project-names[index] + " at " + root.recent-project-paths[index];
                                        clicked => { IdeActions.open-recent-project(index); }
                                    }
                                }
                            }
                            if root.project-history-warning != "" : Text {
                                text: root.project-history-warning;
                                color: #ff9d76;
                                font-size: 9px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: root.app-mode == AppMode.running ? "Add audio track" : "New project";
                                    enabled: (root.app-mode == AppMode.running && root.track-count < 8) || root.app-mode == AppMode.closed;
                                    clicked => {
                                        if root.app-mode == AppMode.running {
                                            root.new-track-visible = true;
                                        } else {
                                            root.new-project-visible = true;
                                        }
                                    }
                                }
                                Button {
                                    horizontal-stretch: 1;
                                    text: root.app-mode == AppMode.selecting ? "Selecting project…"
                                        : root.app-mode == AppMode.opening ? "Opening project…" : "Open project folder";
                                    enabled: root.app-mode == AppMode.closed;
                                    clicked => { IdeActions.choose-project(); }
                                }
                            }
                            }
                        }
                        if !root.new-project-visible && !root.new-track-visible : HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: root.app-mode == AppMode.saving ? "Saving…" : "Save project";
                                enabled: root.app-mode == AppMode.running && root.mixer-main-state-available;
                                clicked => { IdeActions.save-project(); }
                            }
                            Button {
                                text: root.app-mode == AppMode.preparing-runtime ? "Preparing…" : "Prepare for Runtime";
                                enabled: root.app-mode == AppMode.running && root.mixer-main-state-available;
                                accessible-label: "Save and compile a verified Runtime bundle";
                                clicked => { IdeActions.prepare-runtime(); }
                            }
                            Button {
                                text: "Close";
                                enabled: root.app-mode == AppMode.running || root.app-mode == AppMode.previewing;
                                clicked => { IdeActions.close-project(); }
                            }
                        }
                        if !root.new-project-visible && !root.new-track-visible : HorizontalLayout {
                            spacing: 8px;
                            Button {
                                horizontal-stretch: 1;
                                text: root.undo-label == "" ? "Undo" : "Undo " + root.undo-label;
                                enabled: root.undo-available;
                                accessible-label: "Undo the last durable edit";
                                clicked => { IdeActions.undo-edit(); }
                            }
                            Button {
                                horizontal-stretch: 1;
                                text: root.redo-label == "" ? "Redo" : "Redo " + root.redo-label;
                                enabled: root.redo-available;
                                accessible-label: "Redo the last undone edit";
                                clicked => { IdeActions.redo-edit(); }
                            }
                        }
                        if !root.new-project-visible && !root.new-track-visible : Button {
                            text: root.app-mode == AppMode.exporting-project ? "Exporting…" : "Export WAV";
                            enabled: root.app-mode == AppMode.running && root.export-available;
                            accessible-label: "Export the project as a WAV file";
                            clicked => { IdeActions.export-project(); }
                        }
                        if root.export-summary != "" : Text {
                            text: root.export-summary;
                            color: #8fa0b4;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                        if root.export-destination != "" : Text {
                            text: root.export-destination;
                            color: #728196;
                            font-size: 8px;
                            overflow: elide;
                        }
                        if root.runtime-bundle-summary != "" : Text {
                            text: root.runtime-bundle-summary;
                            color: #8fa0b4;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                        if root.runtime-bundle-destination != "" : Text {
                            text: root.runtime-bundle-destination;
                            color: #728196;
                            font-size: 8px;
                            overflow: elide;
                        }
                        if !root.new-project-visible && !root.new-track-visible : Text { text: "Verified identity"; color: #65758a; font-size: 10px; }
                        if !root.new-project-visible && !root.new-track-visible : Text { text: root.project-id; color: #b9c5d3; font-size: 11px; overflow: elide; }
                        if !root.new-track-visible : VerticalLayout {
                        spacing: 8px;
                        Rectangle { height: 1px; background: #27313d; }
                        Text { text: "CAPTURE TAKE"; color: #6f8197; font-size: 10px; font-weight: 700; letter-spacing: 1px; }
                        ComboBox {
                            model: root.recording-target-names;
                            current-index <=> root.selected-recording-target-index;
                            enabled: root.app-mode == AppMode.running && root.monitoring-active && root.recording-target-names.length > 0;
                            accessible-label: "Recording target audio track";
                        }
                        if root.app-mode == AppMode.recording : HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Stop & import"; clicked => { IdeActions.stop-recording(); } }
                            Button { text: "Abort"; clicked => { IdeActions.abort-recording(); } }
                        }
                        if root.app-mode != AppMode.recording : Button {
                            text: root.app-mode == AppMode.preparing-recording ? "Preparing capture…"
                                : root.app-mode == AppMode.finalizing-recording ? "Finalizing capture…"
                                : "Record take";
                            enabled: root.app-mode == AppMode.running && root.monitoring-active && root.recording-target-names.length > 0;
                            clicked => { IdeActions.start-recording(); }
                        }
                        Text {
                            text: root.app-mode == AppMode.recording
                                ? root.recording-target + "  ·  " + root.recording-frame-count + " frames  ·  " + root.recording-drop-count + " rejected"
                                : "Takes must stay under 15 minutes; overruns retain recovery data. Playback pauses; no synchronized overdub.";
                            color: root.app-mode == AppMode.recording ? #ffaaa6 : #728196;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                        }
                    }
                }
            }

            right-pane := Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: transparent;

                if root.performance-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                    padding: 22px;
                    spacing: 18px;

                    HorizontalLayout {
                        height: 62px;
                        VerticalLayout {
                            Text { text: "PERFORMANCE"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                            Text { text: root.transport-state; color: #edf2f8; font-size: 24px; font-weight: 650; }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Button {
                            text: "Arrangement (" + root.arrangement-placements.length + ")";
                            enabled: root.app-mode == AppMode.running;
                            clicked => { root.clips-visible = false; root.loudness-visible = false; root.arrangement-visible = true; }
                        }
                        Button {
                            text: "Clips (" + root.audio-clips.length + ")";
                            enabled: root.app-mode == AppMode.running;
                            clicked => { root.arrangement-visible = false; root.loudness-visible = false; root.clips-visible = true; }
                        }
                        Button {
                            text: "Loudness";
                            enabled: root.app-mode == AppMode.running;
                            clicked => { root.arrangement-visible = false; root.clips-visible = false; root.loudness-visible = true; }
                        }
                        Button {
                            text: "Takes (" + root.recording-takes.length + ")";
                            enabled: root.app-mode == AppMode.running || root.app-mode == AppMode.previewing;
                            clicked => { root.arrangement-visible = false; root.clips-visible = false; root.loudness-visible = false; root.takes-visible = true; }
                        }
                        Button {
                            text: "Mixer";
                            enabled: root.app-mode == AppMode.running;
                            clicked => { root.arrangement-visible = false; root.clips-visible = false; root.loudness-visible = false; root.mixer-visible = true; }
                        }
                        Text { text: root.stream-state; color: #8fa0b4; font-size: 12px; vertical-alignment: center; }
                    }

                    Rectangle { height: 1px; background: #27313d; }

                    HorizontalLayout {
                        height: 132px;
                        spacing: 18px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 8px;
                            HorizontalLayout {
                                alignment: center;
                                spacing: 10px;
                                Button {
                                    text: "▶  Start";
                                    enabled: root.app-mode == AppMode.running && root.transport-start-available;
                                    clicked => { IdeActions.transport-start(); }
                                }
                                Button {
                                    text: "■  Stop";
                                    enabled: root.app-mode == AppMode.running && root.transport-stop-available;
                                    clicked => { IdeActions.transport-stop(); }
                                }
                                Button {
                                    text: "|◀  Return";
                                    accessible-label: "Return transport to start";
                                    enabled: root.app-mode == AppMode.running;
                                    clicked => { IdeActions.transport-return-start(); }
                                }
                            }
                            Text { text: root.transport-clock; color: #dce5ef; font-size: 18px; font-weight: 600; horizontal-alignment: center; }
                            Text { text: root.musical-position; color: #7fd6a2; font-size: 12px; font-weight: 600; horizontal-alignment: center; }
                            Text { text: "Frame  " + root.frame-position; color: #8fa0b4; font-size: 11px; horizontal-alignment: center; }
                            VerticalLayout {
                                spacing: 2px;
                                Slider {
                                    minimum: 0;
                                    maximum: 100;
                                    value: root.transport-progress-percent;
                                    enabled: root.app-mode == AppMode.running && root.transport-seek-available;
                                    accessible-label: "Locate within finite compiled playback range";
                                    released(value) => { IdeActions.transport-seek(value); }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: "TEMPO";
                                        color: #65758a;
                                        font-size: 9px;
                                        vertical-alignment: center;
                                    }
                                    tempo-input := IdeLineEdit {
                                        width: 74px;
                                        text: root.tempo-bpm;
                                        enabled: root.tempo-available;
                                        placeholder-text: "120";
                                        accessible-label: "Project tempo in beats per minute";
                                        accepted => { IdeActions.set-tempo(self.text); }
                                    }
                                    Button {
                                        text: "Set";
                                        enabled: root.tempo-available;
                                        accessible-label: "Apply the typed tempo to the project";
                                        clicked => { IdeActions.set-tempo(tempo-input.text); }
                                    }
                                    Text {
                                        text: "METER";
                                        color: #65758a;
                                        font-size: 9px;
                                        vertical-alignment: center;
                                    }
                                    meter-input := IdeLineEdit {
                                        width: 62px;
                                        text: root.meter-signature;
                                        enabled: root.meter-available;
                                        placeholder-text: "4/4";
                                        accessible-label: "Project time signature";
                                        accepted => { IdeActions.set-meter(self.text); }
                                    }
                                    Button {
                                        text: "Set";
                                        enabled: root.meter-available;
                                        accessible-label: "Apply the typed time signature";
                                        clicked => { IdeActions.set-meter(meter-input.text); }
                                    }
                                    Text {
                                        text: root.tempo-locked-reason;
                                        color: #b58a67;
                                        font-size: 9px;
                                        vertical-alignment: center;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Button {
                                        text: "Loop in";
                                        enabled: root.loop-marking-available;
                                        accessible-label: "Set the loop start to the playhead";
                                        clicked => { IdeActions.loop-mark-in(); }
                                    }
                                    Button {
                                        text: "Loop out";
                                        enabled: root.loop-marking-available;
                                        accessible-label: "Set the loop end to the playhead";
                                        clicked => { IdeActions.loop-mark-out(); }
                                    }
                                    Button {
                                        text: root.loop-engaged ? "Looping" : "Loop";
                                        enabled: root.loop-toggle-available;
                                        accessible-label: "Repeat the marked range while the transport rolls";
                                        clicked => { IdeActions.loop-toggle(); }
                                    }
                                    Button {
                                        text: "Clear";
                                        enabled: root.loop-summary != "";
                                        accessible-label: "Discard the marked loop range";
                                        clicked => { IdeActions.loop-clear(); }
                                    }
                                }
                                Text {
                                    text: root.loop-summary;
                                    color: root.loop-engaged ? #7fd6a2 : #8fa0b4;
                                    font-size: 9px;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: root.transport-extent-bounded ? "0:00  ·  COMPILED PLAYBACK RANGE  ·  " + root.transport-end-clock : "OPEN-ENDED RECORDED SCENE AUTHORITY · SEEK RANGE UNAVAILABLE";
                                    color: root.transport-extent-bounded ? #65758a : #b58a67;
                                    font-size: 9px;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                        Meter { width: 64px; level: root.left-meter; channel-name: "LEFT"; reading: root.left-reading; }
                        Meter { width: 64px; level: root.right-meter; channel-name: "RIGHT"; reading: root.right-reading; }
                    }

                    Rectangle { height: 1px; background: #27313d; }

                    VerticalLayout {
                        height: 125px;
                        spacing: 4px;
                        HorizontalLayout {
                            Text { text: "SCENE LAUNCHER"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "New scene";
                                accessible-label: "Create a new scene";
                                enabled: root.app-mode == AppMode.running && root.scenes.length < root.max-scene-count;
                                clicked => { IdeActions.begin-add-scene(); }
                            }
                        }
                        GridLayout {
                            spacing: 6px;
                            for scene[index] in root.scenes : VerticalLayout {
                                row: index / 4;
                                col: Math.mod(index, 4);
                                min-width: 180px;
                                max-width: 180px;
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: 4px;
                                    Button {
                                        min-width: 0px;
                                        horizontal-stretch: 2;
                                        text: (scene.queued ? "[Q] " : scene.current ? "[>] " : "") + scene.display-name;
                                        accessible-label: scene.name + ", " + (scene.runtime-state != "" ? scene.runtime-state : scene.availability);
                                        enabled: root.app-mode == AppMode.running && scene.launchable;
                                        clicked => { IdeActions.launch-scene(scene.index); }
                                    }
                                    Button {
                                        horizontal-stretch: 1;
                                        text: "Edit";
                                        accessible-label: "Edit scene " + scene.name;
                                        enabled: root.app-mode == AppMode.running && scene.id != "";
                                        clicked => { IdeActions.open-scene-slots(scene.id); }
                                    }
                                    Button {
                                        horizontal-stretch: 1;
                                        text: scene.active ? "On" : "Off";
                                        accessible-label: (scene.active ? "Disable scene " : "Enable scene ") + scene.name;
                                        enabled: root.app-mode == AppMode.running && scene.id != "";
                                        clicked => { IdeActions.set-scene-active(scene.id, !scene.active); }
                                    }
                                    Button {
                                        horizontal-stretch: 1;
                                        text: "Mark";
                                        accessible-label: "Add scene " + scene.name + " to the linear arrangement";
                                        enabled: root.app-mode == AppMode.running && scene.id != "";
                                        clicked => {
                                            root.remove-arrangement-placement-visible = false;
                                            root.move-arrangement-scene-launch-visible = false;
                                            root.set-arrangement-scene-launch-scene-visible = false;
                                            root.remove-arrangement-scene-launch-visible = false;
                                            root.add-arrangement-scene-launch-id = scene.id;
                                            root.add-arrangement-scene-launch-name = scene.name;
                                            root.add-arrangement-scene-launch-tick = "0";
                                            root.add-arrangement-scene-launch-visible = true;
                                            root.arrangement-visible = true;
                                        }
                                    }
                                }
                                Text {
                                    text: scene.runtime-state != "" ? scene.runtime-state : scene.availability;
                                    color: scene.queued ? #e7b96d : scene.current ? #63e6b5 : scene.launchable ? #63e6b5 : #8fa0b4;
                                    font-size: 9px;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: #27313d; }

                    Text { text: "RUNTIME EVIDENCE"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }

                    GridLayout {
                        spacing: 10px;
                        Rectangle {
                            row: 0; col: 0; height: 78px; background: #0e141b; border-radius: 6px;
                            VerticalLayout { padding: 12px; Text { text: "SAMPLE RATE"; color: #65758a; font-size: 10px; } Text { text: root.sample-rate; color: #dce5ef; font-size: 18px; } }
                        }
                        Rectangle {
                            row: 0; col: 1; height: 78px; background: #0e141b; border-radius: 6px;
                            VerticalLayout { padding: 12px; Text { text: "SCENES"; color: #65758a; font-size: 10px; } Text { text: root.scene-count; color: #dce5ef; font-size: 18px; } }
                        }
                        Rectangle {
                            row: 0; col: 2; height: 78px; background: #0e141b; border-radius: 6px;
                            VerticalLayout { padding: 12px; Text { text: "CALLBACKS"; color: #65758a; font-size: 10px; } Text { text: root.callback-count; color: #dce5ef; font-size: 18px; } }
                        }
                        Rectangle {
                            row: 0; col: 3; height: 78px; background: #0e141b; border-radius: 6px;
                            VerticalLayout { padding: 12px; Text { text: "NATIVE XRUNS"; color: #65758a; font-size: 10px; } Text { text: root.xrun-count; color: #dce5ef; font-size: 18px; } }
                        }
                        Rectangle {
                            row: 1; col: 0; height: 64px; background: #0e141b; border-radius: 6px;
                            VerticalLayout { padding: 10px; Text { text: "INPUT CUE"; color: #65758a; font-size: 9px; } Text { text: root.monitoring-state; color: root.monitoring-active ? #63e6b5 : #8fa0b4; font-size: 15px; } }
                        }
                        Rectangle {
                            row: 1; col: 1; height: 64px; background: #0e141b; border-radius: 6px;
                            VerticalLayout { padding: 10px; Text { text: "CUE FRAMES"; color: #65758a; font-size: 9px; } Text { text: root.monitoring-frame-count; color: #dce5ef; font-size: 15px; } }
                        }
                        Rectangle {
                            row: 1; col: 2; height: 64px; background: #0e141b; border-radius: 6px;
                            VerticalLayout { padding: 10px; Text { text: "DROPPED FRAMES"; color: #65758a; font-size: 9px; } Text { text: root.monitoring-drop-count; color: root.monitoring-drop-count == "0" ? #dce5ef : #ff9d76; font-size: 15px; } }
                        }
                        Rectangle {
                            row: 1; col: 3; height: 64px; background: #0e141b; border-radius: 6px;
                            VerticalLayout { padding: 10px; Text { text: "UNDERFLOWS"; color: #65758a; font-size: 9px; } Text { text: root.monitoring-underflow-count; color: root.monitoring-underflow-count == "0" ? #dce5ef : #ff9d76; font-size: 15px; } }
                        }
                    }
                    }
                }

                if root.scene-create-visible && !root.mixer-visible && !root.takes-visible && !root.arrangement-visible && !root.clips-visible && !root.loudness-visible && !root.scene-rename-visible && !root.scene-duplicate-visible && !root.scene-slots-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 22px;
                        spacing: 16px;
                        Text { text: "CREATE SCENE"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: "Add a durable scene"; color: #edf2f8; font-size: 24px; font-weight: 600; }
                        Text {
                            text: "A new scene starts with Continue on every track. Choose when a launch becomes effective; track actions can be authored after creation.";
                            color: #aebccc;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        GridLayout {
                            spacing: 8px;
                            Text { row: 0; col: 0; text: "Scene name"; color: #8fa0b4; vertical-alignment: center; }
                            IdeLineEdit { row: 0; col: 1; text <=> root.scene-create-name; placeholder-text: "Verse"; accessible-label: "New scene name"; }
                            Text { row: 1; col: 0; text: "Launch timing"; color: #8fa0b4; vertical-alignment: center; }
                            ComboBox {
                                row: 1;
                                col: 1;
                                model: ["Immediate", "Grid"];
                                current-index <=> root.scene-create-quantization-index;
                                accessible-label: "New scene launch timing";
                            }
                            if root.scene-create-quantization-index == 1 : Text { row: 2; col: 0; text: "Grid quantum"; color: #8fa0b4; vertical-alignment: center; }
                            if root.scene-create-quantization-index == 1 : IdeLineEdit {
                                row: 2;
                                col: 1;
                                text <=> root.scene-create-quantum-ticks;
                                placeholder-text: "Positive whole ticks";
                                accessible-label: "Scene launch grid quantum in ticks";
                            }
                        }
                        Text {
                            text: root.scene-create-quantization-index == 0
                                ? "Immediate launches apply on the next audio processing boundary."
                                : "Grid launches wait for the next exact project-tick multiple.";
                            color: #65758a;
                            font-size: 9px;
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Cancel"; enabled: root.app-mode == AppMode.running; clicked => { root.scene-create-visible = false; } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Create scene";
                                enabled: root.app-mode == AppMode.running
                                    && root.scene-create-name != ""
                                    && (root.scene-create-quantization-index == 0 || root.scene-create-quantum-ticks != "");
                                clicked => { IdeActions.add-scene(root.scene-create-name, root.scene-create-quantization-index, root.scene-create-quantum-ticks); }
                            }
                        }
                    }
                }

                if root.scene-slots-visible && !root.mixer-visible && !root.takes-visible && !root.arrangement-visible && !root.clips-visible && !root.loudness-visible && !root.scene-create-visible && !root.scene-rename-visible && !root.scene-duplicate-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 22px;
                        spacing: 14px;
                        Text { height: 16px; text: "SCENE TRACK ACTIONS"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { height: 32px; text: root.scene-slots-scene-name; color: #edf2f8; font-size: 24px; font-weight: 600; overflow: elide; }
                        Text {
                            height: 32px;
                            text: "Continue leaves the track unchanged. Stop ends its launched material. Play replaces it with a reusable clip owned by that track.";
                            color: #aebccc;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        if root.scene-slots.length == 0 : Text {
                            text: "This scene has no editable track actions.";
                            color: #8fa0b4;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            vertical-stretch: 1;
                        }
                        if root.scene-slots.length > 0 : HorizontalLayout {
                            spacing: 14px;
                            ListView {
                                width: 330px;
                                vertical-stretch: 1;
                                for slot in root.scene-slots : Button {
                                    height: 52px;
                                    checkable: true;
                                    checked: slot.index == root.selected-scene-slot-index;
                                    text: slot.track-name + "  ·  " + slot.action + "\n" + slot.detail;
                                    accessible-label: slot.track-name + ", " + slot.action + ", " + slot.detail;
                                    clicked => { IdeActions.select-scene-slot(slot.index); }
                                }
                            }
                            Rectangle { width: 1px; background: #27313d; }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 10px;
                                Text { text: root.selected-scene-slot-track-name; color: #edf2f8; font-size: 18px; font-weight: 600; overflow: elide; }
                                Text { text: "Track action"; color: #8fa0b4; font-size: 10px; }
                                ComboBox {
                                    height: 34px;
                                    model: ["Continue", "Stop", "Play clip"];
                                    current-index <=> root.scene-slot-action-index;
                                    accessible-label: "Track action for " + root.selected-scene-slot-track-name;
                                }
                                if root.scene-slot-action-index == 2 : Text { text: "Reusable clip"; color: #8fa0b4; font-size: 10px; }
                                if root.scene-slot-action-index == 2 : ComboBox {
                                    height: 34px;
                                    model: root.scene-slot-clip-names;
                                    current-index <=> root.selected-scene-slot-clip-index;
                                    enabled: root.scene-slot-clip-names.length > 0;
                                    accessible-label: "Reusable clip for " + root.selected-scene-slot-track-name;
                                }
                                if root.scene-slot-action-index == 2 && root.scene-slot-clip-names.length == 0 : Text {
                                    text: "No reusable audio clip belongs to this track.";
                                    color: #ff9d76;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                                Button {
                                    height: 34px;
                                    text: "Apply track action";
                                    enabled: root.app-mode == AppMode.running
                                        && root.selected-scene-slot-index >= 0
                                        && root.selected-scene-slot-track-id != ""
                                        && (root.scene-slot-action-index != 2 || root.selected-scene-slot-clip-index >= 0);
                                    clicked => {
                                        IdeActions.set-scene-slot(
                                            root.scene-slots-scene-id,
                                            root.selected-scene-slot-track-id,
                                            root.scene-slot-action-index,
                                            root.selected-scene-slot-clip-index,
                                        );
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            height: 34px;
                            spacing: 8px;
                            Button { text: "Done"; enabled: root.app-mode == AppMode.running; clicked => { root.scene-slots-visible = false; } }
                            Button {
                                text: "Rename scene";
                                enabled: root.app-mode == AppMode.running && root.scene-slots-scene-id != "";
                                clicked => {
                                    root.scene-rename-id = root.scene-slots-scene-id;
                                    root.scene-rename-original = root.scene-slots-scene-name;
                                    root.scene-rename-name = root.scene-slots-scene-name;
                                    root.scene-slots-visible = false;
                                    root.scene-rename-visible = true;
                                }
                            }
                            Button {
                                text: "Duplicate scene";
                                accessible-label: "Duplicate " + root.scene-slots-scene-name + " as an independent scene";
                                enabled: root.app-mode == AppMode.running
                                    && root.scene-slots-scene-id != ""
                                    && root.scenes.length < root.max-scene-count;
                                clicked => {
                                    root.scene-duplicate-id = root.scene-slots-scene-id;
                                    root.scene-duplicate-source-name = root.scene-slots-scene-name;
                                    root.scene-duplicate-name = "";
                                    root.scene-slots-visible = false;
                                    root.scene-duplicate-visible = true;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                    }
                }

                if root.scene-rename-visible && !root.mixer-visible && !root.takes-visible && !root.arrangement-visible && !root.clips-visible && !root.loudness-visible && !root.scene-duplicate-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 22px;
                        spacing: 16px;
                        Text { text: "RENAME SCENE"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: root.scene-rename-original; color: #edf2f8; font-size: 24px; font-weight: 600; overflow: elide; }
                        Text {
                            text: "Change the scene label without changing its launch order, quantization, slots, activation, or recorded arrangement launches.";
                            color: #aebccc;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        GridLayout {
                            spacing: 8px;
                            Text { text: "Scene name"; color: #8fa0b4; vertical-alignment: center; }
                            scene-rename-input := IdeLineEdit { text <=> root.scene-rename-name; placeholder-text: "Verse"; accessible-label: "Scene name"; }
                        }
                        Text { text: "1 to 120 characters. Leading and trailing whitespace is removed."; color: #65758a; font-size: 9px; }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Cancel"; clicked => { root.scene-rename-visible = false; } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Rename scene";
                                enabled: root.app-mode == AppMode.running
                                    && root.scene-rename-id != ""
                                    && root.scene-rename-name != ""
                                    && root.scene-rename-name != root.scene-rename-original;
                                clicked => { IdeActions.rename-scene(root.scene-rename-id, root.scene-rename-name); }
                            }
                        }
                    }
                }

                if root.scene-duplicate-visible && !root.mixer-visible && !root.takes-visible && !root.arrangement-visible && !root.clips-visible && !root.loudness-visible && !root.scene-create-visible && !root.scene-rename-visible && !root.scene-slots-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 22px;
                        spacing: 16px;
                        Text { text: "DUPLICATE SCENE"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: root.scene-duplicate-source-name; color: #edf2f8; font-size: 24px; font-weight: 600; overflow: elide; }
                        Text {
                            text: "Enter a name from 1 to 120 characters for the new scene. Leading and trailing whitespace is removed before validation.";
                            color: #aebccc;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        IdeLineEdit {
                            text <=> root.scene-duplicate-name;
                            placeholder-text: "New scene name";
                            accessible-label: "Duplicated scene name";
                        }
                        Text {
                            text: "The duplicate receives a new identity and is appended after existing scenes. It independently preserves activation, launch timing, and track actions. Existing arrangement launch history remains unchanged.";
                            color: #65758a;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Cancel"; clicked => { root.scene-duplicate-visible = false; } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: root.app-mode == AppMode.duplicating-scene ? "Duplicating scene..." : "Duplicate scene";
                                enabled: root.app-mode == AppMode.running
                                    && root.scene-duplicate-id != ""
                                    && root.scene-duplicate-name != ""
                                    && root.scenes.length < root.max-scene-count;
                                clicked => { IdeActions.duplicate-scene(root.scene-duplicate-id, root.scene-duplicate-name); }
                            }
                        }
                    }
                }

                if root.mixer-visible && root.remove-track-visible && !root.mixer-sends-visible && !root.takes-visible && !root.arrangement-visible && !root.clips-visible && !root.loudness-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 22px;
                        spacing: 14px;
                        Text { text: "REMOVE EMPTY AUDIO TRACK"; color: #ff9d76; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: root.remove-track-name; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                        Rectangle { height: 1px; background: #27313d; }
                        Text { text: "This cannot be undone. Removal is accepted only when no clips, child tracks, scenes, arrangement placements, control mappings, recordings, or mixer routes reference this track, and while the project contains no automation."; color: #aebccc; font-size: 11px; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Cancel";
                                enabled: root.app-mode == AppMode.running;
                                clicked => {
                                    root.remove-track-visible = false;
                                    root.remove-track-id = "";
                                    root.remove-track-name = "";
                                }
                            }
                            Button {
                                horizontal-stretch: 1;
                                text: root.app-mode == AppMode.removing-track ? "Removing track..." : "Remove empty track";
                                enabled: root.app-mode == AppMode.running && root.remove-track-id != "";
                                clicked => { IdeActions.remove-audio-track(root.remove-track-id); }
                            }
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }

                if root.mixer-visible && root.rename-track-visible && !root.remove-track-visible && !root.mixer-sends-visible && !root.takes-visible && !root.arrangement-visible && !root.clips-visible && !root.loudness-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 22px;
                        spacing: 14px;
                        Text { text: "RENAME AUDIO TRACK"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: root.rename-track-original-name; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                        Rectangle { height: 1px; background: #27313d; }
                        Text { text: "New display name"; color: #aebccc; font-size: 12px; }
                        IdeLineEdit {
                            text <=> root.rename-track-name;
                            enabled: root.app-mode == AppMode.running;
                            accessible-label: "New audio track name";
                        }
                        Text {
                            text: "The committed live mixer is preserved first. The structural track is then replaced through a recoverable project transaction.";
                            color: #728196;
                            font-size: 10px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Cancel";
                                enabled: root.app-mode == AppMode.running;
                                clicked => { root.rename-track-visible = false; }
                            }
                            Button {
                                horizontal-stretch: 1;
                                text: root.app-mode == AppMode.renaming-track ? "Renaming track..." : "Rename audio track";
                                enabled: root.app-mode == AppMode.running
                                    && root.rename-track-index >= 0
                                    && root.rename-track-name != ""
                                    && root.rename-track-name != root.rename-track-original-name;
                                clicked => { IdeActions.rename-audio-track(root.rename-track-index, root.rename-track-name); }
                            }
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }

                if root.mixer-visible && !root.rename-track-visible && !root.remove-track-visible && !root.mixer-sends-visible && !root.mixer-automation-visible && !root.mixer-control-visible && !root.mixer-native-filter-visible && !root.takes-visible && !root.arrangement-visible && !root.clips-visible && !root.loudness-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        height: 48px;
                        spacing: 8px;
                        VerticalLayout {
                            Text { text: "BASE MIXER"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                            Text { text: "Automation may override base values"; color: #aebccc; font-size: 12px; }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Button { text: "Performance"; clicked => { root.mixer-visible = false; } }
                        Button { text: "Sends"; enabled: root.mixer-sends.length > 0; clicked => { root.mixer-sends-visible = true; } }
                        Button {
                            text: "Devices (" + root.native-devices.length + ")";
                            enabled: root.native-filter-track-names.length > 0;
                            clicked => {
                                root.native-filter-add-visible = false;
                                root.native-filter-edit-visible = false;
                                root.native-filter-remove-confirming-index = -1;
                                root.mixer-native-filter-visible = true;
                            }
                        }
                        Button {
                            text: "Control (" + root.control-bindings.length + ")";
                            enabled: root.control-source-names.length > 0;
                            clicked => {
                                root.control-create-visible = false;
                                root.mixer-control-visible = true;
                            }
                        }
                        Button {
                            text: "Automation (" + root.automation-takes.length + ")";
                            enabled: root.automation-target-names.length > 0;
                            clicked => {
                                root.automation-create-visible = false;
                                root.mixer-automation-visible = true;
                            }
                        }
                        Text { text: root.stream-state; color: #8fa0b4; font-size: 12px; vertical-alignment: center; }
                    }

                    Rectangle { height: 1px; background: #27313d; }

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for channel in root.mixer-channels : Rectangle {
                            width: 72px;
                            vertical-stretch: 1;
                            background: #0e141b;
                            border-color: #27313d;
                            border-width: 1px;
                            border-radius: 6px;
                            VerticalLayout {
                                padding: 7px;
                                spacing: 5px;
                                Text { text: channel.display-name; accessible-label: channel.name; color: channel.active ? #dce5ef : #8290a2; font-size: 10px; font-weight: 600; horizontal-alignment: center; overflow: elide; }
                                Text { text: channel.kind; color: #65758a; font-size: 8px; horizontal-alignment: center; }
                                Button {
                                    text: "Rename";
                                    enabled: root.app-mode == AppMode.running && channel.renameable;
                                    clicked => {
                                        root.rename-track-index = channel.index;
                                        root.rename-track-original-name = channel.name;
                                        root.rename-track-name = channel.name;
                                        root.rename-track-visible = true;
                                    }
                                }
                                Button {
                                    text: channel.active ? "Disable" : "Enable";
                                    accessible-label: (channel.active ? "Disable " : "Enable ") + channel.name;
                                    enabled: root.app-mode == AppMode.running && channel.activation-toggleable;
                                    clicked => { IdeActions.set-audio-track-active(channel.index, !channel.active); }
                                }
                                Button {
                                    text: "Remove";
                                    enabled: root.app-mode == AppMode.running && channel.removable;
                                    clicked => {
                                        root.remove-track-id = channel.track-id;
                                        root.remove-track-name = channel.name;
                                        root.remove-track-visible = true;
                                    }
                                }
                                Slider {
                                    min-width: 28px;
                                    max-width: 28px;
                                    vertical-stretch: 1;
                                    orientation: Orientation.vertical;
                                    minimum: 0;
                                    maximum: 200;
                                    value: channel.gain-percent;
                                    enabled: root.app-mode == AppMode.running && channel.state-available;
                                    accessible-label: channel.name + " base gain";
                                    released(value) => { IdeActions.mixer-channel-gain(channel.index, value); }
                                }
                                Text { text: Math.round(channel.gain-percent) + "%"; color: channel.state-available ? #aebccc : #65758a; font-size: 9px; horizontal-alignment: center; }
                                Slider {
                                    height: 24px;
                                    minimum: -100;
                                    maximum: 100;
                                    value: channel.pan-percent;
                                    enabled: root.app-mode == AppMode.running && channel.state-available;
                                    accessible-label: channel.name + " base pan";
                                    released(value) => { IdeActions.mixer-channel-pan(channel.index, value); }
                                }
                                Text { text: "PAN " + Math.round(channel.pan-percent); color: channel.state-available ? #aebccc : #65758a; font-size: 8px; horizontal-alignment: center; }
                                HorizontalLayout {
                                    spacing: 3px;
                                    Button { text: channel.muted ? "M*" : "M"; accessible-label: channel.name + (channel.muted ? " muted" : " not muted"); enabled: root.app-mode == AppMode.running && channel.state-available; clicked => { IdeActions.mixer-channel-mute(channel.index); } }
                                    Button { text: channel.solo ? "S*" : "S"; accessible-label: channel.name + (channel.solo ? " soloed" : " not soloed"); enabled: root.app-mode == AppMode.running && channel.state-available && channel.solo-available; clicked => { IdeActions.mixer-channel-solo(channel.index); } }
                                }
                                Text { text: !channel.active ? "DISABLED" : channel.state-available ? "BASE" : "UNAVAILABLE"; color: !channel.active ? #8290a2 : channel.state-available ? #63e6b5 : #ff9d76; font-size: 7px; horizontal-alignment: center; }
                            }
                        }
                        Rectangle {
                            width: 76px;
                            vertical-stretch: 1;
                            background: #18202a;
                            border-color: #3a4858;
                            border-width: 1px;
                            border-radius: 6px;
                            VerticalLayout {
                                padding: 7px;
                                spacing: 5px;
                                Text { text: "MAIN"; color: #edf2f8; font-size: 10px; font-weight: 700; horizontal-alignment: center; }
                                Text { text: "OUTPUT"; color: #65758a; font-size: 8px; horizontal-alignment: center; }
                                Slider {
                                    min-width: 28px;
                                    max-width: 28px;
                                    vertical-stretch: 1;
                                    orientation: Orientation.vertical;
                                    minimum: 0;
                                    maximum: 200;
                                    value: root.mixer-main-gain-percent;
                                    enabled: root.app-mode == AppMode.running && root.mixer-main-state-available;
                                    accessible-label: "Main base gain";
                                    released(value) => { IdeActions.mixer-main-gain(value); }
                                }
                                Text { text: Math.round(root.mixer-main-gain-percent) + "%"; color: root.mixer-main-state-available ? #aebccc : #65758a; font-size: 9px; horizontal-alignment: center; }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                                Button { text: root.mixer-main-muted ? "MUTE ON" : "MUTE"; enabled: root.app-mode == AppMode.running && root.mixer-main-state-available; clicked => { IdeActions.mixer-main-mute(); } }
                                Text { text: root.mixer-main-state-available ? "BASE" : "UNAVAILABLE"; color: root.mixer-main-state-available ? #63e6b5 : #ff9d76; font-size: 7px; horizontal-alignment: center; }
                            }
                        }
                    }
                    }
                }

                if root.mixer-visible && root.mixer-native-filter-visible && !root.mixer-sends-visible && !root.mixer-automation-visible && !root.mixer-control-visible && !root.takes-visible && !root.arrangement-visible && !root.clips-visible && !root.loudness-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        HorizontalLayout {
                            height: 48px;
                            spacing: 8px;
                            VerticalLayout {
                                Text { text: "NATIVE DEVICES"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                                Text { text: "Portable pre-fader filters and compressors · identical project state in IDE and Runtime"; color: #aebccc; font-size: 12px; }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Channels";
                                clicked => {
                                    root.native-filter-add-visible = false;
                                    root.native-filter-edit-visible = false;
                                    root.native-compressor-add-visible = false;
                                    root.native-compressor-edit-visible = false;
                                    root.native-filter-remove-confirming-index = -1;
                                    root.mixer-native-filter-visible = false;
                                }
                            }
                            Button {
                                text: "Add filter";
                                enabled: root.app-mode == AppMode.running && root.native-filter-track-names.length > 0 && !root.native-filter-edit-visible && !root.native-compressor-add-visible && !root.native-compressor-edit-visible;
                                clicked => { root.native-filter-remove-confirming-index = -1; root.native-compressor-add-visible = false; root.native-compressor-edit-visible = false; root.native-filter-add-visible = true; }
                            }
                            Button {
                                text: "Add compressor";
                                enabled: root.app-mode == AppMode.running && root.native-filter-track-names.length > 0 && !root.native-filter-add-visible && !root.native-filter-edit-visible && !root.native-compressor-edit-visible;
                                clicked => { root.native-filter-remove-confirming-index = -1; root.native-filter-add-visible = false; root.native-filter-edit-visible = false; root.native-compressor-add-visible = true; }
                            }
                        }

                        Rectangle { height: 1px; background: #27313d; }

                        if root.native-filter-add-visible : HorizontalLayout {
                            height: 48px;
                            spacing: 8px;
                            VerticalLayout { min-width: 140px; max-width: 140px; spacing: 2px; Text { text: "TRACK"; color: #65758a; font-size: 8px; } ComboBox { model: root.native-filter-track-names; current-index <=> root.native-filter-add-track-index; } }
                            VerticalLayout { min-width: 130px; max-width: 130px; spacing: 2px; Text { text: "MODE"; color: #65758a; font-size: 8px; } ComboBox { model: ["Low-pass", "High-pass"]; current-index <=> root.native-filter-add-mode-index; } }
                            VerticalLayout { min-width: 140px; max-width: 140px; spacing: 2px; Text { text: "CUTOFF · mHz"; color: #65758a; font-size: 8px; } IdeLineEdit { text <=> root.native-filter-add-cutoff; } }
                            VerticalLayout { min-width: 140px; max-width: 140px; spacing: 2px; Text { text: "RESONANCE · millionths"; color: #65758a; font-size: 8px; } IdeLineEdit { text <=> root.native-filter-add-resonance; } }
                            Button { text: "Cancel"; enabled: root.app-mode == AppMode.running; clicked => { root.native-filter-add-visible = false; } }
                            Button {
                                text: root.app-mode == AppMode.editing-native-filter ? "Adding…" : "Add";
                                enabled: root.app-mode == AppMode.running && root.native-filter-add-track-index >= 0 && root.native-filter-add-cutoff != "" && root.native-filter-add-resonance != "";
                                clicked => { IdeActions.add-native-filter(root.native-filter-add-track-index, root.native-filter-add-mode-index, root.native-filter-add-cutoff, root.native-filter-add-resonance); }
                            }
                        }

                        if root.native-compressor-add-visible : HorizontalLayout {
                            height: 48px; spacing: 8px;
                            VerticalLayout { min-width: 120px; max-width: 120px; spacing: 2px; Text { text: "TRACK"; color: #65758a; font-size: 8px; } ComboBox { model: root.native-filter-track-names; current-index <=> root.native-filter-add-track-index; } }
                            VerticalLayout { min-width: 100px; max-width: 100px; spacing: 2px; Text { text: "THRESHOLD · mdB"; color: #65758a; font-size: 8px; } IdeLineEdit { text <=> root.native-compressor-add-threshold; } }
                            VerticalLayout { min-width: 100px; max-width: 100px; spacing: 2px; Text { text: "RATIO · millionths"; color: #65758a; font-size: 8px; } IdeLineEdit { text <=> root.native-compressor-add-ratio; } }
                            VerticalLayout { min-width: 88px; max-width: 88px; spacing: 2px; Text { text: "ATTACK · μs"; color: #65758a; font-size: 8px; } IdeLineEdit { text <=> root.native-compressor-add-attack; } }
                            VerticalLayout { min-width: 88px; max-width: 88px; spacing: 2px; Text { text: "RELEASE · μs"; color: #65758a; font-size: 8px; } IdeLineEdit { text <=> root.native-compressor-add-release; } }
                            VerticalLayout { min-width: 88px; max-width: 88px; spacing: 2px; Text { text: "MAKEUP · mdB"; color: #65758a; font-size: 8px; } IdeLineEdit { text <=> root.native-compressor-add-makeup; } }
                            Button { text: "Cancel"; clicked => { root.native-compressor-add-visible = false; } }
                            Button { text: "Add"; enabled: root.app-mode == AppMode.running; clicked => { IdeActions.add-native-compressor(root.native-filter-add-track-index, root.native-compressor-add-threshold, root.native-compressor-add-ratio, root.native-compressor-add-attack, root.native-compressor-add-release, root.native-compressor-add-makeup); } }
                        }

                        if root.native-filter-edit-visible : HorizontalLayout {
                            height: 48px;
                            spacing: 8px;
                            VerticalLayout { min-width: 130px; max-width: 130px; spacing: 2px; Text { text: "MODE"; color: #65758a; font-size: 8px; } ComboBox { model: ["Low-pass", "High-pass"]; current-index <=> root.native-filter-edit-mode-index; } }
                            VerticalLayout { min-width: 140px; max-width: 140px; spacing: 2px; Text { text: "CUTOFF · mHz"; color: #65758a; font-size: 8px; } IdeLineEdit { text <=> root.native-filter-edit-cutoff; } }
                            VerticalLayout { min-width: 140px; max-width: 140px; spacing: 2px; Text { text: "RESONANCE · millionths"; color: #65758a; font-size: 8px; } IdeLineEdit { text <=> root.native-filter-edit-resonance; } }
                            Button { text: "Cancel"; enabled: root.app-mode == AppMode.running; clicked => { root.native-filter-edit-visible = false; root.native-filter-edit-index = -1; } }
                            Button {
                                text: root.app-mode == AppMode.editing-native-filter ? "Saving…" : "Save";
                                enabled: root.app-mode == AppMode.running && root.native-filter-edit-index >= 0 && root.native-filter-edit-cutoff != "" && root.native-filter-edit-resonance != "";
                                clicked => { IdeActions.update-native-filter(root.native-filter-edit-index, root.native-filter-edit-enabled, root.native-filter-edit-mode-index, root.native-filter-edit-cutoff, root.native-filter-edit-resonance); }
                            }
                        }

                        if root.native-compressor-edit-visible : HorizontalLayout {
                            height: 48px; spacing: 8px;
                            VerticalLayout { min-width: 100px; max-width: 100px; spacing: 2px; Text { text: "THRESHOLD · mdB"; color: #65758a; font-size: 8px; } IdeLineEdit { text <=> root.native-compressor-edit-threshold; } }
                            VerticalLayout { min-width: 100px; max-width: 100px; spacing: 2px; Text { text: "RATIO · millionths"; color: #65758a; font-size: 8px; } IdeLineEdit { text <=> root.native-compressor-edit-ratio; } }
                            VerticalLayout { min-width: 88px; max-width: 88px; spacing: 2px; Text { text: "ATTACK · μs"; color: #65758a; font-size: 8px; } IdeLineEdit { text <=> root.native-compressor-edit-attack; } }
                            VerticalLayout { min-width: 88px; max-width: 88px; spacing: 2px; Text { text: "RELEASE · μs"; color: #65758a; font-size: 8px; } IdeLineEdit { text <=> root.native-compressor-edit-release; } }
                            VerticalLayout { min-width: 88px; max-width: 88px; spacing: 2px; Text { text: "MAKEUP · mdB"; color: #65758a; font-size: 8px; } IdeLineEdit { text <=> root.native-compressor-edit-makeup; } }
                            Button { text: "Cancel"; clicked => { root.native-compressor-edit-visible = false; root.native-compressor-edit-index = -1; } }
                            Button { text: "Save"; enabled: root.app-mode == AppMode.running && root.native-compressor-edit-index >= 0; clicked => { IdeActions.update-native-compressor(root.native-compressor-edit-index, root.native-compressor-edit-enabled, root.native-compressor-edit-threshold, root.native-compressor-edit-ratio, root.native-compressor-edit-attack, root.native-compressor-edit-release, root.native-compressor-edit-makeup); } }
                        }

                        ListView {
                            vertical-stretch: 1;
                            for filter in root.native-devices : Rectangle {
                                height: 88px;
                                background: filter.enabled ? #0e1c20 : #0e141b;
                                border-color: filter.enabled ? #315a58 : #27313d;
                                border-width: 1px;
                                border-radius: 6px;
                                HorizontalLayout {
                                    padding: 8px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        Text { text: filter.track-name + " · " + filter.kind-name; color: filter.enabled ? #dce5ef : #8290a2; font-size: 12px; font-weight: 600; overflow: elide; }
                                        Text { text: filter.detail + (filter.enabled ? "" : " · BYPASSED"); color: #8290a2; font-size: 10px; overflow: elide; }
                                    }
                                    VerticalLayout {
                                        min-width: 310px;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: filter.enabled ? "Bypass" : "Enable";
                                                enabled: root.app-mode == AppMode.running && !root.native-filter-add-visible && !root.native-filter-edit-visible && !root.native-compressor-add-visible && !root.native-compressor-edit-visible;
                                                clicked => {
                                                    if filter.kind-index == 0 { IdeActions.update-native-filter(filter.index, !filter.enabled, filter.mode-index, filter.cutoff-millihertz, filter.resonance-millionths); }
                                                    else { IdeActions.update-native-compressor(filter.index, !filter.enabled, filter.threshold-millidecibels, filter.ratio-millionths, filter.attack-microseconds, filter.release-microseconds, filter.makeup-millidecibels); }
                                                }
                                            }
                                            Button {
                                                text: "Copy";
                                                accessible-label: "Copy native device for a later paste";
                                                enabled: root.app-mode == AppMode.running && !root.native-filter-add-visible && !root.native-filter-edit-visible && !root.native-compressor-add-visible && !root.native-compressor-edit-visible;
                                                clicked => { IdeActions.copy-native-device(filter.index); }
                                            }
                                            Button {
                                                text: "Paste";
                                                accessible-label: "Paste copied native device after this device";
                                                enabled: root.app-mode == AppMode.running && root.native-device-copy-available && filter.can-duplicate && !root.native-filter-add-visible && !root.native-filter-edit-visible && !root.native-compressor-add-visible && !root.native-compressor-edit-visible;
                                                clicked => { IdeActions.paste-native-device(filter.index); }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: "←";
                                                accessible-label: "Move native device earlier in its chain";
                                                enabled: root.app-mode == AppMode.running && filter.can-move-earlier && !root.native-filter-add-visible && !root.native-filter-edit-visible && !root.native-compressor-add-visible && !root.native-compressor-edit-visible;
                                                clicked => { IdeActions.move-native-device(filter.index, -1); }
                                            }
                                            Button {
                                                text: "→";
                                                accessible-label: "Move native device later in its chain";
                                                enabled: root.app-mode == AppMode.running && filter.can-move-later && !root.native-filter-add-visible && !root.native-filter-edit-visible && !root.native-compressor-add-visible && !root.native-compressor-edit-visible;
                                                clicked => { IdeActions.move-native-device(filter.index, 1); }
                                            }
                                            Button {
                                                text: "Duplicate";
                                                accessible-label: "Duplicate native device in its chain";
                                                enabled: root.app-mode == AppMode.running && filter.can-duplicate && !root.native-filter-add-visible && !root.native-filter-edit-visible && !root.native-compressor-add-visible && !root.native-compressor-edit-visible;
                                                clicked => { IdeActions.duplicate-native-device(filter.index); }
                                            }
                                            Button {
                                                text: "Edit";
                                                enabled: root.app-mode == AppMode.running && !root.native-filter-add-visible && !root.native-filter-edit-visible && !root.native-compressor-add-visible && !root.native-compressor-edit-visible;
                                                clicked => {
                                                    if filter.kind-index == 0 {
                                                        root.native-compressor-add-visible = false;
                                                        root.native-compressor-edit-visible = false;
                                                        root.native-filter-edit-index = filter.index;
                                                        root.native-filter-edit-enabled = filter.enabled;
                                                        root.native-filter-edit-mode-index = filter.mode-index;
                                                        root.native-filter-edit-cutoff = filter.cutoff-millihertz;
                                                        root.native-filter-edit-resonance = filter.resonance-millionths;
                                                        root.native-filter-edit-visible = true;
                                                    } else {
                                                        root.native-filter-add-visible = false;
                                                        root.native-filter-edit-visible = false;
                                                        root.native-compressor-edit-index = filter.index;
                                                        root.native-compressor-edit-enabled = filter.enabled;
                                                        root.native-compressor-edit-threshold = filter.threshold-millidecibels;
                                                        root.native-compressor-edit-ratio = filter.ratio-millionths;
                                                        root.native-compressor-edit-attack = filter.attack-microseconds;
                                                        root.native-compressor-edit-release = filter.release-microseconds;
                                                        root.native-compressor-edit-makeup = filter.makeup-millidecibels;
                                                        root.native-compressor-edit-visible = true;
                                                    }
                                                    root.native-filter-remove-confirming-index = -1;
                                                }
                                            }
                                            Button {
                                                text: root.native-filter-remove-confirming-index == filter.index ? "Confirm" : "Remove";
                                                enabled: root.app-mode == AppMode.running && !root.native-filter-add-visible && !root.native-filter-edit-visible && !root.native-compressor-add-visible && !root.native-compressor-edit-visible;
                                                clicked => {
                                                    if root.native-filter-remove-confirming-index == filter.index {
                                                        IdeActions.remove-native-filter(filter.index);
                                                    } else {
                                                        root.native-filter-remove-confirming-index = filter.index;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if root.native-devices.length == 0 : Rectangle {
                            vertical-stretch: 1;
                            background: transparent;
                            Text { text: "No Native Devices on audio tracks"; color: #65758a; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                if root.mixer-visible && root.mixer-control-visible && !root.takes-visible && !root.arrangement-visible && !root.clips-visible && !root.loudness-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    HorizontalLayout {
                        height: 48px;
                        spacing: 8px;
                        VerticalLayout {
                            Text { text: "CONTROL MAPPINGS"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                            Text { text: "Front-panel CV, clock, and reset inputs drive project targets"; color: #aebccc; font-size: 12px; }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Button {
                            text: "Channels";
                            clicked => { root.control-create-visible = false; root.mixer-control-visible = false; }
                        }
                        Button {
                            text: "Performance";
                            clicked => {
                                root.control-create-visible = false;
                                root.mixer-control-visible = false;
                                root.mixer-sends-visible = false;
                                root.mixer-visible = false;
                            }
                        }
                        Button {
                            text: "Add binding";
                            enabled: root.app-mode == AppMode.running && !root.control-create-visible && root.control-target-names.length > 0;
                            clicked => {
                                root.control-create-source-index = 0;
                                root.control-create-target-index = 0;
                                root.control-create-momentary = false;
                                root.control-create-output-min = "0";
                                root.control-create-output-max = "1000000";
                                root.control-create-visible = true;
                            }
                        }
                    }

                    Rectangle { height: 1px; background: #27313d; }

                    if root.control-create-visible : VerticalLayout {
                        spacing: 8px;
                        Text { height: 16px; text: "ADD CONTROL BINDING"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        HorizontalLayout {
                            height: 48px;
                            spacing: 8px;
                            VerticalLayout {
                                width: 150px;
                                Text { text: "Source"; color: #8fa0b4; font-size: 9px; }
                                ComboBox {
                                    model: root.control-source-names;
                                    current-index <=> root.control-create-source-index;
                                    enabled: root.app-mode == AppMode.running;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: "Target"; color: #8fa0b4; font-size: 9px; }
                                ComboBox {
                                    model: root.control-target-names;
                                    current-index <=> root.control-create-target-index;
                                    enabled: root.app-mode == AppMode.running;
                                }
                            }
                        }
                        HorizontalLayout {
                            height: 48px;
                            spacing: 8px;
                            if root.control-target-continuous[root.control-create-target-index] : VerticalLayout {
                                width: 140px;
                                Text { text: "Output min"; color: #8fa0b4; font-size: 9px; }
                                IdeLineEdit {
                                    text <=> root.control-create-output-min;
                                    input-type: number;
                                    enabled: root.app-mode == AppMode.running;
                                }
                            }
                            if root.control-target-continuous[root.control-create-target-index] : VerticalLayout {
                                width: 140px;
                                Text { text: "Output max"; color: #8fa0b4; font-size: 9px; }
                                IdeLineEdit {
                                    text <=> root.control-create-output-max;
                                    input-type: number;
                                    enabled: root.app-mode == AppMode.running;
                                }
                            }
                            if root.control-target-boolean[root.control-create-target-index] : VerticalLayout {
                                width: 150px;
                                Text { text: "Edge behaviour"; color: #8fa0b4; font-size: 9px; }
                                Button {
                                    text: root.control-create-momentary ? "Momentary" : "Toggle";
                                    enabled: root.app-mode == AppMode.running;
                                    clicked => { root.control-create-momentary = !root.control-create-momentary; }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: "Domain"; color: #8fa0b4; font-size: 9px; }
                                Text {
                                    text: root.control-source-continuous[root.control-create-source-index]
                                            != root.control-target-continuous[root.control-create-target-index]
                                        ? "A CV source drives only value targets; clock and reset drive only switch and action targets."
                                        : root.control-target-range[root.control-create-target-index] != ""
                                            ? root.control-target-range[root.control-create-target-index]
                                            : "This target is driven by an edge, not a value.";
                                    color: #728196;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        HorizontalLayout {
                            height: 34px;
                            spacing: 8px;
                            Button {
                                text: "Cancel";
                                enabled: root.app-mode == AppMode.running;
                                clicked => { root.control-create-visible = false; }
                            }
                            Button {
                                horizontal-stretch: 1;
                                text: root.app-mode == AppMode.editing-control-mapping ? "Adding binding..." : "Add control binding";
                                enabled: root.app-mode == AppMode.running
                                    && root.control-source-continuous[root.control-create-source-index]
                                        == root.control-target-continuous[root.control-create-target-index];
                                clicked => {
                                    IdeActions.add-control-binding(
                                        root.control-create-source-index,
                                        root.control-create-target-index,
                                        root.control-create-momentary,
                                        root.control-create-output-min,
                                        root.control-create-output-max
                                    );
                                }
                            }
                        }
                        Rectangle { height: 1px; background: #27313d; }
                    }

                    if root.control-bindings.length == 0 : Text {
                        text: "This project has no control bindings.";
                        color: #8fa0b4;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        vertical-stretch: 1;
                    }

                    if root.control-bindings.length > 0 : ListView {
                        vertical-stretch: 1;
                        for binding in root.control-bindings : Rectangle {
                            height: 52px;
                            width: parent.width;
                            background: #101820;
                            border-color: #27313d;
                            border-width: 1px;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    Text { text: binding.source + "  to  " + binding.target; color: #dce5ef; font-size: 12px; font-weight: 600; overflow: elide; }
                                    Text { text: binding.scope + " - " + binding.transform; color: #8fa0b4; font-size: 9px; overflow: elide; }
                                }
                                Text {
                                    width: 72px;
                                    text: binding.enabled ? "ENABLED" : "DISABLED";
                                    color: binding.enabled ? #63e6b5 : #728196;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    width: 76px;
                                    padding-top: 9px;
                                    padding-bottom: 9px;
                                    Button {
                                        text: binding.enabled ? "Disable" : "Enable";
                                        accessible-label: (binding.enabled ? "Disable " : "Enable ") + binding.source + " control binding";
                                        enabled: root.app-mode == AppMode.running;
                                        clicked => { IdeActions.set-control-binding-active(binding.id, !binding.enabled); }
                                    }
                                }
                                VerticalLayout {
                                    width: 76px;
                                    padding-top: 9px;
                                    padding-bottom: 9px;
                                    Button {
                                        text: "Remove";
                                        accessible-label: "Remove " + binding.source + " control binding";
                                        enabled: root.app-mode == AppMode.running;
                                        clicked => { IdeActions.remove-control-binding(binding.id); }
                                    }
                                }
                            }
                        }
                    }
                    }
                }

                if root.mixer-visible && root.mixer-automation-visible && !root.mixer-control-visible && !root.takes-visible && !root.arrangement-visible && !root.clips-visible && !root.loudness-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    HorizontalLayout {
                        height: 48px;
                        spacing: 8px;
                        VerticalLayout {
                            Text { text: "MIXER AUTOMATION"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                            Text { text: "Persisted takes drive the mixer inside their tick interval"; color: #aebccc; font-size: 12px; }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Button {
                            text: "Channels";
                            clicked => { root.automation-create-visible = false; root.automation-take-remove-confirming-id = ""; root.mixer-automation-visible = false; }
                        }
                        Button {
                            text: "Performance";
                            clicked => {
                                root.automation-create-visible = false;
                                root.automation-take-remove-confirming-id = "";
                                root.mixer-automation-visible = false;
                                root.mixer-sends-visible = false;
                                root.mixer-visible = false;
                            }
                        }
                            Button {
                                text: "Add take";
                            enabled: root.app-mode == AppMode.running && !root.automation-create-visible;
                            clicked => {
                                root.automation-create-name = "";
                                root.automation-create-target-index = 0;
                                root.automation-create-interpolation-index = 0;
                                root.automation-create-start = "0";
                                root.automation-create-end = "1920";
                                root.automation-create-points = "";
                                root.automation-take-remove-confirming-id = "";
                                root.automation-create-visible = true;
                            }
                        }
                    }

                    Rectangle { height: 1px; background: #27313d; }

                    if root.automation-create-visible : VerticalLayout {
                        spacing: 8px;
                        Text { height: 16px; text: "ADD AUTOMATION TAKE"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        HorizontalLayout {
                            height: 48px;
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: "Name"; color: #8fa0b4; font-size: 9px; }
                                IdeLineEdit {
                                    placeholder-text: "Take name";
                                    text <=> root.automation-create-name;
                                    enabled: root.app-mode == AppMode.running;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 2;
                                Text { text: "Target"; color: #8fa0b4; font-size: 9px; }
                                ComboBox {
                                    model: root.automation-target-names;
                                    current-index <=> root.automation-create-target-index;
                                    enabled: root.app-mode == AppMode.running;
                                    selected(_) => {
                                        if (root.automation-target-boolean[self.current-index]) {
                                            root.automation-create-interpolation-index = 0;
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                width: 120px;
                                Text { text: "Interpolation"; color: #8fa0b4; font-size: 9px; }
                                ComboBox {
                                    model: ["Hold", "Linear"];
                                    current-index <=> root.automation-create-interpolation-index;
                                    enabled: root.app-mode == AppMode.running
                                        && !root.automation-target-boolean[root.automation-create-target-index];
                                }
                            }
                        }
                        HorizontalLayout {
                            height: 48px;
                            spacing: 8px;
                            VerticalLayout {
                                width: 120px;
                                Text { text: "Start tick"; color: #8fa0b4; font-size: 9px; }
                                IdeLineEdit {
                                    text <=> root.automation-create-start;
                                    input-type: number;
                                    enabled: root.app-mode == AppMode.running;
                                }
                            }
                            VerticalLayout {
                                width: 120px;
                                Text { text: "End tick"; color: #8fa0b4; font-size: 9px; }
                                IdeLineEdit {
                                    text <=> root.automation-create-end;
                                    input-type: number;
                                    enabled: root.app-mode == AppMode.running;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text {
                                    text: "Points  " + root.automation-target-domain[root.automation-create-target-index];
                                    color: #8fa0b4;
                                    font-size: 9px;
                                }
                                IdeLineEdit {
                                    placeholder-text: "tick=value, tick=value";
                                    text <=> root.automation-create-points;
                                    enabled: root.app-mode == AppMode.running;
                                }
                            }
                        }
                        HorizontalLayout {
                            height: 34px;
                            spacing: 8px;
                            Button {
                                text: "Cancel";
                                enabled: root.app-mode == AppMode.running;
                                clicked => { root.automation-create-visible = false; }
                            }
                            Button {
                                horizontal-stretch: 1;
                                text: root.app-mode == AppMode.adding-automation-take ? "Adding take..." : "Add automation take";
                                enabled: root.app-mode == AppMode.running
                                    && root.automation-create-name != ""
                                    && root.automation-create-start != ""
                                    && root.automation-create-end != ""
                                    && root.automation-create-points != "";
                                clicked => {
                                    IdeActions.add-automation-take(
                                        root.automation-create-name,
                                        root.automation-create-target-index,
                                        root.automation-create-interpolation-index,
                                        root.automation-create-start,
                                        root.automation-create-end,
                                        root.automation-create-points
                                    );
                                }
                            }
                        }
                        Rectangle { height: 1px; background: #27313d; }
                    }

                    if root.automation-takes.length == 0 : Text {
                        text: "This project has no automation takes.";
                        color: #8fa0b4;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        vertical-stretch: 1;
                    }

                    if root.automation-takes.length > 0 : ListView {
                        vertical-stretch: 1;
                        for take in root.automation-takes : Rectangle {
                            height: 52px;
                            width: parent.width;
                            background: #101820;
                            border-color: #27313d;
                            border-width: 1px;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    Text { text: take.name; color: #dce5ef; font-size: 12px; font-weight: 600; overflow: elide; }
                                    Text { text: take.target; color: #8fa0b4; font-size: 9px; overflow: elide; }
                                }
                                VerticalLayout {
                                    width: 150px;
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    Text { text: take.range; color: #e7b96d; font-size: 10px; }
                                    Text { text: take.interpolation + " " + take.points; color: #728196; font-size: 9px; }
                                }
                                Text {
                                    width: 72px;
                                    text: take.enabled ? "ENABLED" : "DISABLED";
                                    color: take.enabled ? #63e6b5 : #728196;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    width: 154px;
                                    padding-top: 9px;
                                    padding-bottom: 9px;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Button {
                                            text: take.enabled ? "Disable" : "Enable";
                                            accessible-label: (take.enabled ? "Disable " : "Enable ") + take.name + " automation take";
                                            enabled: root.app-mode == AppMode.running;
                                            clicked => {
                                                root.automation-take-remove-confirming-id = "";
                                                IdeActions.set-automation-take-active(take.id, !take.enabled);
                                            }
                                        }
                                        Button {
                                            text: root.automation-take-remove-confirming-id == take.id ? "Confirm" : "Remove";
                                            accessible-label: (root.automation-take-remove-confirming-id == take.id ? "Confirm removal of " : "Remove ") + take.name + " automation take";
                                            enabled: root.app-mode == AppMode.running;
                                            clicked => {
                                                if root.automation-take-remove-confirming-id == take.id {
                                                    IdeActions.remove-automation-take(take.id);
                                                } else {
                                                    root.automation-take-remove-confirming-id = take.id;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    }
                }

                if root.mixer-visible && root.mixer-sends-visible && !root.mixer-automation-visible && !root.mixer-control-visible && !root.takes-visible && !root.arrangement-visible && !root.clips-visible && !root.loudness-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    HorizontalLayout {
                        height: 48px;
                        VerticalLayout {
                            Text { text: "BASE SENDS"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                            Text { text: "Compiled routes · automation may override base values"; color: #aebccc; font-size: 12px; }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Button { text: "Channels"; clicked => { root.mixer-sends-visible = false; } }
                        Button { text: "Performance"; clicked => { root.mixer-sends-visible = false; root.mixer-visible = false; } }
                    }

                    Rectangle { height: 1px; background: #27313d; }

                    if root.mixer-sends.length == 0 : Text {
                        text: "This compiled mixer has no sends.";
                        color: #8fa0b4;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        vertical-stretch: 1;
                    }

                    GridLayout {
                        spacing: 7px;
                        for send[index] in root.mixer-sends : Rectangle {
                            row: index / 2;
                            col: Math.mod(index, 2);
                            height: 48px;
                            background: #0e141b;
                            border-color: #27313d;
                            border-width: 1px;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding: 4px;
                                spacing: 5px;
                                VerticalLayout {
                                    width: 104px;
                                    Text { text: send.source-name + " → " + send.target-name; accessible-label: send.source-name + " send to " + send.target-name; color: #dce5ef; font-size: 9px; overflow: elide; }
                                    Text { text: send.tap; color: #65758a; font-size: 7px; }
                                }
                                Button { width: 48px; text: send.enabled ? "ON" : "OFF"; enabled: root.app-mode == AppMode.running && send.state-available; clicked => { IdeActions.mixer-send-enabled(send.index); } }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    Text { text: "GAIN " + Math.round(send.gain-percent) + "%"; color: #8fa0b4; font-size: 8px; }
                                    Slider { minimum: 0; maximum: 200; value: send.gain-percent; enabled: root.app-mode == AppMode.running && send.state-available; accessible-label: send.source-name + " send gain to " + send.target-name; released(value) => { IdeActions.mixer-send-gain(send.index, value); } }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    Text { text: "PAN " + Math.round(send.pan-percent); color: #8fa0b4; font-size: 8px; }
                                    Slider { minimum: -100; maximum: 100; value: send.pan-percent; enabled: root.app-mode == AppMode.running && send.state-available; accessible-label: send.source-name + " send pan to " + send.target-name; released(value) => { IdeActions.mixer-send-pan(send.index, value); } }
                                }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }

                if root.takes-visible && !root.arrangement-visible && !root.clips-visible && !root.loudness-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        HorizontalLayout {
                            height: 48px;
                            VerticalLayout {
                                Text { text: "RECORDED TAKES"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                                Text { text: "Verified whole-file recordings · dry audition only"; color: #aebccc; font-size: 12px; }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Performance";
                                clicked => { root.takes-visible = false; root.take-clip-visible = false; root.mixer-visible = false; root.mixer-sends-visible = false; }
                            }
                            Button {
                                text: "Mixer";
                                enabled: !root.preview-active;
                                clicked => { root.takes-visible = false; root.take-clip-visible = false; root.mixer-visible = true; root.mixer-sends-visible = false; }
                            }
                        }

                        Rectangle { height: 1px; background: #27313d; }

                        if root.take-clip-visible : Rectangle {
                            vertical-stretch: 1;
                            background: #0e141b;
                            border-color: #37769a;
                            border-width: 1px;
                            border-radius: 6px;
                            VerticalLayout {
                                padding: 18px;
                                spacing: 12px;
                                Text { text: "CREATE REUSABLE AUDIO CLIP"; color: #7dcfff; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                                Text { text: "Source take on " + root.take-clip-track-name; color: #edf2f8; font-size: 15px; font-weight: 600; overflow: elide; }
                                Text {
                                    text: "This preserves the verified whole recording and its exact frame-derived duration. The new clip belongs to the take's track; it is not placed in the arrangement.";
                                    color: #aebccc;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                Text { text: "CLIP NAME"; color: #65758a; font-size: 9px; }
                                IdeLineEdit {
                                    text <=> root.take-clip-name;
                                    accessible-label: "Reusable audio clip name";
                                }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Button {
                                        width: 86px;
                                        text: "Cancel";
                                        enabled: root.app-mode == AppMode.running;
                                        clicked => { root.take-clip-visible = false; }
                                    }
                                    Button {
                                        width: 116px;
                                        text: root.app-mode == AppMode.creating-clip ? "Creating…" : "Create clip";
                                        enabled: root.app-mode == AppMode.running && root.take-clip-name != "";
                                        clicked => { IdeActions.create-audio-clip-from-take(root.take-clip-index, root.take-clip-name); }
                                    }
                                }
                            }
                        }

                        if !root.take-clip-visible && root.recording-takes.length == 0 : Text {
                            text: "No verified recorded takes are present in this project.";
                            color: #8fa0b4;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            vertical-stretch: 1;
                        }

                        if !root.take-clip-visible && root.recording-takes.length > 0 : ListView {
                            vertical-stretch: 1;
                            for take in root.recording-takes : Rectangle {
                                height: 74px;
                                width: parent.width;
                                background: take.active ? #102536 : #0e141b;
                                border-color: take.active ? #37769a : #27313d;
                                border-width: 1px;
                                border-radius: 6px;
                                HorizontalLayout {
                                    padding: 9px;
                                    spacing: 12px;
                                    VerticalLayout {
                                        width: 164px;
                                        spacing: 2px;
                                        Text { text: take.track-name; color: #edf2f8; font-size: 13px; font-weight: 600; overflow: elide; }
                                        Text { text: take.captured-at; color: #8290a2; font-size: 9px; overflow: elide; }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: take.detail; color: #b9c5d3; font-size: 11px; overflow: elide; }
                                        Text { text: take.timeline-start; color: #65758a; font-size: 9px; overflow: elide; }
                                    }
                                    Text {
                                        width: 74px;
                                        text: take.state;
                                        color: take.active ? #7dcfff : #65758a;
                                        font-size: 9px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    Button {
                                        width: 86px;
                                        text: take.active && root.preview-active ? "Stop" : "Preview";
                                        accessible-label: (take.active && root.preview-active ? "Stop preview of " : "Preview ") + take.track-name;
                                        enabled: root.app-mode == AppMode.running || (root.app-mode == AppMode.previewing && take.active);
                                        clicked => { IdeActions.toggle-take-preview(take.index); }
                                    }
                                    Button {
                                        width: 92px;
                                        text: "Create clip";
                                        accessible-label: "Create a reusable audio clip from the recorded take on " + take.track-name;
                                        enabled: root.app-mode == AppMode.running;
                                        clicked => {
                                            root.take-clip-index = take.index;
                                            root.take-clip-track-name = take.track-name;
                                            root.take-clip-name = take.track-name;
                                            root.take-clip-visible = true;
                                        }
                                    }
                                }
                            }
                        }

                        if !root.take-clip-visible : Rectangle { height: 1px; background: #27313d; }
                        if !root.take-clip-visible : HorizontalLayout {
                            height: 58px;
                            spacing: 10px;
                            VerticalLayout {
                                width: 130px;
                                Text { text: "AUDITION"; color: #65758a; font-size: 9px; }
                                Text { text: root.preview-state; color: root.preview-active ? #7dcfff : #aebccc; font-size: 14px; font-weight: 600; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: "GAIN  " + Math.round(root.preview-gain-percent) + "%"; color: #8fa0b4; font-size: 9px; }
                                Slider {
                                    minimum: 0;
                                    maximum: 100;
                                    value: root.preview-gain-percent;
                                    enabled: root.app-mode == AppMode.running || root.app-mode == AppMode.previewing;
                                    accessible-label: "Recorded take audition gain";
                                    released(value) => { IdeActions.preview-gain(value); }
                                }
                            }
                            Button {
                                width: 72px;
                                text: root.preview-muted ? "MUTED" : "MUTE";
                                enabled: root.app-mode == AppMode.running || root.app-mode == AppMode.previewing;
                                clicked => { IdeActions.preview-mute(); }
                            }
                            Text {
                                width: 126px;
                                text: root.preview-progress;
                                color: #aebccc;
                                font-size: 10px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                        if !root.take-clip-visible : Text {
                            text: "Audition is dry. Creating a reusable clip still does not place it in the arrangement.";
                            color: #65758a;
                            font-size: 9px;
                        }
                    }
                }

                if root.arrangement-visible && !root.clips-visible && !root.loudness-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        HorizontalLayout {
                            height: 48px;
                            VerticalLayout {
                                Text { text: "ARRANGEMENT"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                                Text { text: root.arrangement-placements.length + " placements · " + root.arrangement-scene-launches.length + " scene markers · span " + root.arrangement-span-clock; color: #aebccc; font-size: 12px; }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Performance";
                                clicked => { root.arrangement-visible = false; root.mixer-visible = false; root.mixer-sends-visible = false; root.takes-visible = false; }
                            }
                            Button {
                                text: "Mixer";
                                enabled: root.app-mode == AppMode.running;
                                clicked => { root.arrangement-visible = false; root.mixer-visible = true; root.mixer-sends-visible = false; root.takes-visible = false; }
                            }
                        }

                        Rectangle { height: 1px; background: #27313d; }

                        if root.add-arrangement-scene-launch-visible : VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 14px;
                            Text { text: "ADD SCENE MARKER"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                            Text { text: root.add-arrangement-scene-launch-name; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                            Text {
                                text: "This writes a durable scene launch at one exact project tick. It does not capture a live performance, move existing events, or bypass the single-authority playback rules.";
                                color: #aebccc;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                            GridLayout {
                                spacing: 8px;
                                Text { row: 0; col: 0; text: "Project tick"; color: #8fa0b4; vertical-alignment: center; }
                                IdeLineEdit {
                                    row: 0; col: 1;
                                    text <=> root.add-arrangement-scene-launch-tick;
                                    input-type: number;
                                    accessible-label: "Exact project tick for scene marker";
                                    accepted => {
                                        IdeActions.add-arrangement-scene-launch(root.add-arrangement-scene-launch-id, self.text);
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: "Cancel";
                                    enabled: root.app-mode == AppMode.running;
                                    clicked => { root.add-arrangement-scene-launch-visible = false; }
                                }
                                Button {
                                    horizontal-stretch: 1;
                                    text: root.app-mode == AppMode.adding-arrangement-scene-launch ? "Adding marker..." : "Add marker";
                                    enabled: root.app-mode == AppMode.running
                                        && root.add-arrangement-scene-launch-id != ""
                                        && root.add-arrangement-scene-launch-tick != "";
                                    clicked => {
                                        IdeActions.add-arrangement-scene-launch(
                                            root.add-arrangement-scene-launch-id,
                                            root.add-arrangement-scene-launch-tick
                                        );
                                    }
                                }
                            }
                            Rectangle { vertical-stretch: 1; background: transparent; }
                        }

                        if root.move-arrangement-scene-launch-visible : VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 14px;
                            Text { text: "MOVE SCENE MARKER"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                            Text { text: root.move-arrangement-scene-launch-name; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                            Text {
                                text: "Move this durable launch from tick " + root.move-arrangement-scene-launch-original-tick + " to one exact project tick.";
                                color: #aebccc;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "This is a non-ripple edit. Other markers and arrangement placements keep their positions.";
                                color: #728196;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            GridLayout {
                                spacing: 8px;
                                Text { row: 0; col: 0; text: "Project tick"; color: #8fa0b4; vertical-alignment: center; }
                                IdeLineEdit {
                                    row: 0; col: 1;
                                    text <=> root.move-arrangement-scene-launch-tick;
                                    input-type: number;
                                    accessible-label: "New exact project tick for " + root.move-arrangement-scene-launch-name + " scene marker";
                                    accepted => {
                                        IdeActions.move-arrangement-scene-launch(root.move-arrangement-scene-launch-id, self.text);
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: "Cancel";
                                    enabled: root.app-mode == AppMode.running;
                                    clicked => {
                                        root.move-arrangement-scene-launch-visible = false;
                                        root.move-arrangement-scene-launch-id = "";
                                        root.move-arrangement-scene-launch-name = "";
                                        root.move-arrangement-scene-launch-original-tick = "";
                                        root.move-arrangement-scene-launch-tick = "";
                                    }
                                }
                                Button {
                                    horizontal-stretch: 1;
                                    text: root.app-mode == AppMode.moving-arrangement-scene-launch ? "Moving marker..." : "Move marker";
                                    enabled: root.app-mode == AppMode.running
                                        && root.move-arrangement-scene-launch-id != ""
                                        && root.move-arrangement-scene-launch-tick != ""
                                        && root.move-arrangement-scene-launch-tick != root.move-arrangement-scene-launch-original-tick;
                                    clicked => {
                                        IdeActions.move-arrangement-scene-launch(
                                            root.move-arrangement-scene-launch-id,
                                            root.move-arrangement-scene-launch-tick
                                        );
                                    }
                                }
                            }
                            Rectangle { vertical-stretch: 1; background: transparent; }
                        }

                        if root.set-arrangement-scene-launch-scene-visible : VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 14px;
                            Text { text: "CHANGE MARKER SCENE"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                            Text { text: root.set-arrangement-scene-launch-scene-name; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                            Text { text: "Project tick " + root.set-arrangement-scene-launch-scene-tick; color: #8fa0b4; font-size: 12px; }
                            Text {
                                text: "Change which scene this durable marker launches. Its identity and exact project tick remain unchanged.";
                                color: #aebccc;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                            GridLayout {
                                spacing: 8px;
                                Text { row: 0; col: 0; text: "Scene"; color: #8fa0b4; vertical-alignment: center; }
                                ComboBox {
                                    row: 0; col: 1;
                                    model: root.scene-names;
                                    current-index <=> root.set-arrangement-scene-launch-scene-target-index;
                                    accessible-label: "Replacement scene for marker at tick " + root.set-arrangement-scene-launch-scene-tick;
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: "Cancel";
                                    enabled: root.app-mode == AppMode.running;
                                    clicked => {
                                        root.set-arrangement-scene-launch-scene-visible = false;
                                        root.set-arrangement-scene-launch-scene-id = "";
                                        root.set-arrangement-scene-launch-scene-name = "";
                                        root.set-arrangement-scene-launch-scene-current-id = "";
                                        root.set-arrangement-scene-launch-scene-current-index = -1;
                                        root.set-arrangement-scene-launch-scene-tick = "";
                                        root.set-arrangement-scene-launch-scene-target-index = -1;
                                    }
                                }
                                Button {
                                    horizontal-stretch: 1;
                                    text: root.app-mode == AppMode.changing-arrangement-scene-launch-scene ? "Changing scene..." : "Change scene";
                                    enabled: root.app-mode == AppMode.running
                                        && root.set-arrangement-scene-launch-scene-id != ""
                                        && root.set-arrangement-scene-launch-scene-target-index >= 0
                                        && root.set-arrangement-scene-launch-scene-target-index < root.scene-names.length
                                        && root.set-arrangement-scene-launch-scene-target-index != root.set-arrangement-scene-launch-scene-current-index;
                                    clicked => {
                                        IdeActions.set-arrangement-scene-launch-scene(
                                            root.set-arrangement-scene-launch-scene-id,
                                            root.set-arrangement-scene-launch-scene-target-index
                                        );
                                    }
                                }
                            }
                            Rectangle { vertical-stretch: 1; background: transparent; }
                        }

                        if root.remove-arrangement-scene-launch-visible : VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 14px;
                            Text { text: "REMOVE SCENE MARKER"; color: #ff9d76; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                            Text { text: root.remove-arrangement-scene-launch-name; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                            Text { text: "Project tick " + root.remove-arrangement-scene-launch-tick; color: #8fa0b4; font-size: 12px; }
                            Rectangle { height: 1px; background: #27313d; }
                            Text {
                                text: "This cannot be undone. Only this scheduled scene launch is removed. The scene, its slots, arrangement placements, tracks, clips, and mixer state remain unchanged.";
                                color: #aebccc;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "This is a non-ripple edit. Later markers keep their project ticks, and the project is reopened and verified before completion is reported.";
                                color: #728196;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: "Cancel";
                                    enabled: root.app-mode == AppMode.running;
                                    clicked => {
                                        root.remove-arrangement-scene-launch-visible = false;
                                        root.remove-arrangement-scene-launch-id = "";
                                        root.remove-arrangement-scene-launch-name = "";
                                        root.remove-arrangement-scene-launch-tick = "";
                                    }
                                }
                                Button {
                                    horizontal-stretch: 1;
                                    text: root.app-mode == AppMode.removing-arrangement-scene-launch ? "Removing marker..." : "Remove marker";
                                    enabled: root.app-mode == AppMode.running && root.remove-arrangement-scene-launch-id != "";
                                    clicked => { IdeActions.remove-arrangement-scene-launch(root.remove-arrangement-scene-launch-id); }
                                }
                            }
                            Rectangle { vertical-stretch: 1; background: transparent; }
                        }

                        if root.remove-arrangement-placement-visible && !root.arrangement-scene-launch-form-visible : VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 14px;
                            Text { text: "REMOVE ARRANGEMENT PLACEMENT"; color: #ff9d76; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                            Text { text: root.remove-arrangement-placement-clip-name; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                            Text { text: "Track: " + root.remove-arrangement-placement-track-name; color: #8fa0b4; font-size: 12px; overflow: elide; }
                            Rectangle { height: 1px; background: #27313d; }
                            Text {
                                text: "This cannot be undone. Only this arrangement placement is removed. The reusable clip, source audio, track, mixer state, later placement positions, and recorded takes remain unchanged.";
                                color: #aebccc;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "This is a non-ripple edit. The project is reopened and verified before the removal is reported as complete.";
                                color: #728196;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: "Cancel";
                                    enabled: root.app-mode == AppMode.running;
                                    clicked => {
                                        root.remove-arrangement-placement-visible = false;
                                        root.remove-arrangement-placement-id = "";
                                        root.remove-arrangement-placement-clip-name = "";
                                        root.remove-arrangement-placement-track-name = "";
                                    }
                                }
                                Button {
                                    horizontal-stretch: 1;
                                    text: root.app-mode == AppMode.removing-arrangement-placement ? "Removing placement..." : "Remove placement";
                                    enabled: root.app-mode == AppMode.running && root.remove-arrangement-placement-id != "";
                                    clicked => { IdeActions.remove-arrangement-placement(root.remove-arrangement-placement-id); }
                                }
                            }
                            Rectangle { vertical-stretch: 1; background: transparent; }
                        }

                        if !root.remove-arrangement-placement-visible && !root.arrangement-scene-launch-form-visible && root.arrangement-placements.length == 0 && root.arrangement-scene-launches.length == 0 : Text {
                            text: "This project has no linear arrangement placements.";
                            color: #8fa0b4;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            vertical-stretch: 1;
                        }

                        if !root.remove-arrangement-placement-visible && !root.arrangement-scene-launch-form-visible && root.arrangement-scene-launches.length > 0 : ListView {
                            height: Math.min(144px, root.arrangement-scene-launches.length * 42px);
                            for marker in root.arrangement-scene-launches : Rectangle {
                                height: 38px;
                                width: parent.width;
                                background: #101820;
                                border-color: #27313d;
                                border-width: 1px;
                                border-radius: 4px;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    Text { text: "SCENE"; color: #6f8197; font-size: 9px; vertical-alignment: center; }
                                    Text { text: marker.scene-name; color: #dce5ef; font-size: 11px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                    Text { text: "TICK " + marker.tick; color: #e7b96d; font-size: 10px; vertical-alignment: center; }
                                    Button {
                                        width: 54px;
                                        text: "Locate";
                                        accessible-label: "Locate " + marker.scene-name + " scene marker at tick " + marker.tick;
                                        enabled: root.app-mode == AppMode.running;
                                        clicked => { IdeActions.locate-arrangement-scene-launch(marker.index, marker.id, false); }
                                    }
                                    Button {
                                        width: 48px;
                                        text: "Play";
                                        accessible-label: "Play from " + marker.scene-name + " scene marker at tick " + marker.tick;
                                        enabled: root.app-mode == AppMode.running;
                                        clicked => { IdeActions.locate-arrangement-scene-launch(marker.index, marker.id, true); }
                                    }
                                    Button {
                                        width: 54px;
                                        text: "Scene";
                                        accessible-label: "Change scene for " + marker.scene-name + " marker at tick " + marker.tick;
                                        enabled: root.app-mode == AppMode.running && root.scenes.length > 1;
                                        clicked => {
                                            root.remove-arrangement-placement-visible = false;
                                            root.add-arrangement-scene-launch-visible = false;
                                            root.move-arrangement-scene-launch-visible = false;
                                            root.remove-arrangement-scene-launch-visible = false;
                                            root.set-arrangement-scene-launch-scene-id = marker.id;
                                            root.set-arrangement-scene-launch-scene-name = marker.scene-name;
                                            root.set-arrangement-scene-launch-scene-current-id = marker.scene-id;
                                            root.set-arrangement-scene-launch-scene-current-index = marker.scene-index;
                                            root.set-arrangement-scene-launch-scene-tick = marker.tick;
                                            root.set-arrangement-scene-launch-scene-target-index = marker.scene-index;
                                            root.set-arrangement-scene-launch-scene-visible = true;
                                        }
                                    }
                                    Button {
                                        width: 58px;
                                        text: "Move";
                                        accessible-label: "Move " + marker.scene-name + " scene marker from tick " + marker.tick;
                                        enabled: root.app-mode == AppMode.running;
                                        clicked => {
                                            root.remove-arrangement-placement-visible = false;
                                            root.add-arrangement-scene-launch-visible = false;
                                            root.set-arrangement-scene-launch-scene-visible = false;
                                            root.remove-arrangement-scene-launch-visible = false;
                                            root.move-arrangement-scene-launch-id = marker.id;
                                            root.move-arrangement-scene-launch-name = marker.scene-name;
                                            root.move-arrangement-scene-launch-original-tick = marker.tick;
                                            root.move-arrangement-scene-launch-tick = marker.tick;
                                            root.move-arrangement-scene-launch-visible = true;
                                        }
                                    }
                                    Button {
                                        width: 68px;
                                        text: "Remove";
                                        accessible-label: "Review removal of " + marker.scene-name + " scene marker at tick " + marker.tick;
                                        enabled: root.app-mode == AppMode.running;
                                        clicked => {
                                            root.remove-arrangement-placement-visible = false;
                                            root.add-arrangement-scene-launch-visible = false;
                                            root.move-arrangement-scene-launch-visible = false;
                                            root.set-arrangement-scene-launch-scene-visible = false;
                                            root.remove-arrangement-scene-launch-id = marker.id;
                                            root.remove-arrangement-scene-launch-name = marker.scene-name;
                                            root.remove-arrangement-scene-launch-tick = marker.tick;
                                            root.remove-arrangement-scene-launch-visible = true;
                                        }
                                    }
                                }
                            }
                        }

                        if !root.remove-arrangement-placement-visible && !root.arrangement-scene-launch-form-visible && root.arrangement-placements.length > 0 : ListView {
                            vertical-stretch: 1;
                            for placement in root.arrangement-placements : Rectangle {
                                height: 112px;
                                width: parent.width;
                                background: placement.enabled ? #0e141b : #11151a;
                                border-color: placement.enabled ? #27313d : #3a3330;
                                border-width: 1px;
                                border-radius: 6px;
                                HorizontalLayout {
                                    padding: 9px;
                                    spacing: 6px;
                                    VerticalLayout {
                                        width: 110px;
                                        spacing: 2px;
                                        Text { text: placement.clip-name; color: placement.enabled ? #edf2f8 : #8c929a; font-size: 13px; font-weight: 600; overflow: elide; }
                                        Text { text: placement.track-name; color: #8290a2; font-size: 9px; overflow: elide; }
                                        Text { text: "SOURCE +" + placement.clip-start-tick + " TICKS"; color: #65758a; font-size: 8px; overflow: elide; }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 5px;
                                        Text {
                                            text: placement.start-clock + "  →  " + placement.end-clock;
                                            color: #b9c5d3;
                                            font-size: 10px;
                                        }
                                        Rectangle {
                                            height: 16px;
                                            clip: true;
                                            background: #090d12;
                                            border-color: #202a35;
                                            border-width: 1px;
                                            border-radius: 3px;
                                            Rectangle {
                                                x: parent.width * placement.start-percent / 100;
                                                width: Math.max(2px, parent.width * placement.width-percent / 100);
                                                height: parent.height;
                                                background: placement.active ? #245d78 : placement.enabled ? #34404d : #4a3c34;
                                                border-radius: 3px;
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        width: 64px;
                                        alignment: center;
                                        Text {
                                            text: placement.enabled ? "ENABLED" : "DISABLED";
                                            color: placement.enabled ? #63e6b5 : #b58a67;
                                            font-size: 9px;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            text: placement.active ? "PLAYBACK ACTIVE" : "PLAYBACK BLOCKED";
                                            color: placement.active ? #6f8197 : #65758a;
                                            font-size: 7px;
                                            horizontal-alignment: center;
                                        }
                                    }
                                    VerticalLayout {
                                        width: 244px;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            height: 44px;
                                            spacing: 4px;
                                            VerticalLayout {
                                                width: 82px;
                                                spacing: 2px;
                                                Text {
                                                    text: "START TICK";
                                                    color: #6f8197;
                                                    font-size: 8px;
                                                }
                                                start-tick-input := IdeLineEdit {
                                                    width: 82px;
                                                    horizontal-stretch: 0;
                                                    text: placement.start-tick;
                                                    accessible-label: "Start tick for " + placement.clip-name + " on " + placement.track-name;
                                                    accepted => { IdeActions.move-arrangement-placement(placement.id, self.text); }
                                                }
                                            }
                                            Button {
                                                width: 50px;
                                                text: "Move";
                                                accessible-label: "Move " + placement.clip-name + " on " + placement.track-name + " to entered start tick";
                                                enabled: root.app-mode == AppMode.running && start-tick-input.text != placement.start-tick;
                                                clicked => { IdeActions.move-arrangement-placement(placement.id, start-tick-input.text); }
                                            }
                                            Button {
                                                width: 50px;
                                                text: "Left";
                                                accessible-label: "Trim the left edge of " + placement.clip-name + " on " + placement.track-name + " to entered start tick while preserving its right edge";
                                                enabled: root.app-mode == AppMode.running && start-tick-input.text != placement.start-tick;
                                                clicked => { IdeActions.trim-arrangement-placement-front(placement.id, start-tick-input.text); }
                                            }
                                            Button {
                                                width: 50px;
                                                text: "Split";
                                                accessible-label: "Split " + placement.clip-name + " on " + placement.track-name + " at the entered project tick without ripple";
                                                enabled: root.app-mode == AppMode.running && start-tick-input.text != placement.start-tick;
                                                clicked => { IdeActions.split-arrangement-placement(placement.id, start-tick-input.text); }
                                            }
                                        }
                                        HorizontalLayout {
                                            height: 44px;
                                            spacing: 4px;
                                            VerticalLayout {
                                                width: 82px;
                                                spacing: 2px;
                                                Text {
                                                    text: "DURATION TICKS";
                                                    color: #6f8197;
                                                    font-size: 8px;
                                                }
                                                duration-tick-input := IdeLineEdit {
                                                    width: 82px;
                                                    horizontal-stretch: 0;
                                                    text: placement.duration-ticks;
                                                    accessible-label: "Duration ticks for " + placement.clip-name + " on " + placement.track-name;
                                                    accepted => { IdeActions.set-arrangement-placement-duration(placement.id, self.text); }
                                                }
                                            }
                                            Button {
                                                width: 50px;
                                                text: "Trim";
                                                accessible-label: "Set the right edge of " + placement.clip-name + " on " + placement.track-name + " from its entered duration";
                                                enabled: root.app-mode == AppMode.running && duration-tick-input.text != placement.duration-ticks;
                                                clicked => { IdeActions.set-arrangement-placement-duration(placement.id, duration-tick-input.text); }
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        width: 58px;
                                        spacing: 4px;
                                        Button {
                                            text: "Locate";
                                            accessible-label: "Locate to " + placement.clip-name + " on " + placement.track-name;
                                            enabled: root.app-mode == AppMode.running;
                                            clicked => { IdeActions.locate-placement(placement.index); }
                                        }
                                        Button {
                                            text: "Copy";
                                            accessible-label: "Copy the exact source view of " + placement.clip-name + " on " + placement.track-name + " to the entered start tick without ripple";
                                            enabled: root.app-mode == AppMode.running && start-tick-input.text != placement.start-tick;
                                            clicked => { IdeActions.duplicate-arrangement-placement(placement.id, start-tick-input.text); }
                                        }
                                        Button {
                                            text: "Remove";
                                            accessible-label: "Review removal of " + placement.clip-name + " from " + placement.track-name;
                                            enabled: root.app-mode == AppMode.running;
                                            clicked => {
                                                root.remove-arrangement-placement-id = placement.id;
                                                root.remove-arrangement-placement-clip-name = placement.clip-name;
                                                root.remove-arrangement-placement-track-name = placement.track-name;
                                                root.remove-arrangement-placement-visible = true;
                                            }
                                        }
                                    }
                                    Button {
                                        width: 58px;
                                        text: placement.enabled ? "Disable" : "Enable";
                                        accessible-label: (placement.enabled ? "Disable " : "Enable ") + placement.clip-name + " on " + placement.track-name;
                                        enabled: root.app-mode == AppMode.running;
                                        clicked => { IdeActions.set-arrangement-placement-active(placement.index, !placement.enabled); }
                                    }
                                }
                            }
                        }

                        if !root.remove-arrangement-placement-visible && !root.arrangement-scene-launch-form-visible : Text {
                            text: "Scene markers and exact non-ripple placement edits persist. Markers must preserve single-track authority; this surface does not claim live performance capture, drag, snap, or waveform editing.";
                            color: #65758a;
                            font-size: 9px;
                        }
                    }
                }

                if root.clips-visible && !root.clip-rename-visible && !root.clip-duplicate-visible && !root.clip-remove-visible && !root.clip-gain-visible && !root.clip-fades-visible && !root.clip-loop-visible && !root.clip-source-slip-visible && !root.clip-source-trim-visible && !root.add-arrangement-placement-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        VerticalLayout {
                            height: 76px;
                            spacing: 6px;
                            HorizontalLayout {
                                height: 30px;
                                Text { text: "AUDIO CLIPS"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Button {
                                    text: "Performance";
                                    clicked => { root.clips-visible = false; root.clip-rename-visible = false; root.clip-duplicate-visible = false; root.clip-gain-visible = false; root.clip-fades-visible = false; root.clip-loop-visible = false; root.clip-source-slip-visible = false; root.clip-source-trim-visible = false; root.add-arrangement-placement-visible = false; }
                                }
                                Button {
                                    text: "Mixer";
                                    enabled: root.app-mode == AppMode.running;
                                    clicked => { root.clips-visible = false; root.clip-rename-visible = false; root.clip-duplicate-visible = false; root.clip-gain-visible = false; root.clip-fades-visible = false; root.clip-loop-visible = false; root.clip-source-slip-visible = false; root.clip-source-trim-visible = false; root.add-arrangement-placement-visible = false; root.mixer-visible = true; }
                                }
                            }
                            HorizontalLayout {
                                height: 34px;
                                Text { text: "Reusable verified source views · import creates no arrangement placement"; color: #aebccc; font-size: 11px; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Text { text: "DESTINATION"; color: #65758a; font-size: 9px; vertical-alignment: center; }
                                ComboBox {
                                    width: 150px;
                                    model: root.audio-import-track-names;
                                    current-index <=> root.selected-audio-import-track-index;
                                    enabled: root.app-mode == AppMode.running && root.audio-import-track-names.length > 0;
                                    accessible-label: "Destination audio track for imported files";
                                }
                                Button {
                                    width: 112px;
                                    text: root.app-mode == AppMode.importing-audio ? "Importing…" : "Import audio…";
                                    enabled: root.audio-import-available;
                                    clicked => { IdeActions.choose-audio-import(root.selected-audio-import-track-index); }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #27313d; }

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: root.unused-sample-assets == 0
                                    ? "No unreferenced imported media"
                                    : root.unused-sample-assets + " unreferenced sample " + (root.unused-sample-assets == 1 ? "copy" : "copies") + " · " + root.unused-sample-bytes;
                                color: root.unused-sample-assets == 0 ? #65758a : #e5b567;
                                font-size: 10px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            if !root.unused-sample-cleanup-confirming : Button {
                                text: "Clean unused media";
                                enabled: root.app-mode == AppMode.running && root.unused-sample-assets > 0;
                                accessible-label: "Permanently remove unreferenced project-owned sample copies";
                                clicked => { root.unused-sample-cleanup-confirming = true; }
                            }
                            if root.unused-sample-cleanup-confirming : Button {
                                text: "Cancel";
                                clicked => { root.unused-sample-cleanup-confirming = false; }
                            }
                            if root.unused-sample-cleanup-confirming : Button {
                                text: "Delete copies permanently";
                                enabled: root.app-mode == AppMode.running && root.unused-sample-assets > 0;
                                accessible-label: "Confirm permanent deletion of " + root.unused-sample-assets + " unreferenced project sample copies";
                                clicked => { IdeActions.clean-unused-samples(); }
                            }
                        }

                        if root.audio-clips.length == 0 : Text {
                            text: "This project contains no audio clips. Import WAV or FLAC into an audio track to create reusable clips.";
                            color: #8fa0b4;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            vertical-stretch: 1;
                        }

                        if root.audio-clips.length > 0 : ListView {
                            vertical-stretch: 1;
                            for clip in root.audio-clips : Rectangle {
                                height: 144px;
                                width: parent.width;
                                background: #0e141b;
                                border-color: #27313d;
                                border-width: 1px;
                                border-radius: 6px;
                                HorizontalLayout {
                                    padding: 9px;
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: clip.name; color: #edf2f8; font-size: 13px; font-weight: 600; overflow: elide; }
                                        Text { text: clip.track-name; color: #8290a2; font-size: 9px; overflow: elide; }
                                        Text { text: clip.duration-ticks + " ticks · full reusable clip"; color: #65758a; font-size: 8px; overflow: elide; }
                                        Text { text: "SOURCE START  " + clip.source-start-edit + "  ·  VIEW  " + clip.source-frame-count + " FRAMES"; color: #65758a; font-size: 8px; overflow: elide; }
                                    }
                                    VerticalLayout {
                                        width: 142px;
                                        alignment: center;
                                        Text { text: "CLIP GAIN"; color: #65758a; font-size: 8px; horizontal-alignment: center; }
                                        Text { text: clip.gain-label; color: #b9c5d3; font-size: 13px; font-weight: 600; horizontal-alignment: center; }
                                        Text { text: "LOOP  " + clip.loop-label; color: clip.loop-enabled ? #75d7b4 : #8290a2; font-size: 8px; horizontal-alignment: center; overflow: elide; }
                                        Text { text: "DIRECTION  " + clip.direction-label; color: clip.reverse ? #e5b567 : #8290a2; font-size: 8px; horizontal-alignment: center; overflow: elide; }
                                        Text { text: "FADES  " + clip.fade-label; color: #8290a2; font-size: 8px; horizontal-alignment: center; overflow: elide; }
                                    }
                                    VerticalLayout {
                                        width: 292px;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            spacing: 4px;
                                            Button {
                                                width: 88px;
                                                text: "Rename";
                                                accessible-label: "Rename " + clip.name;
                                                enabled: root.app-mode == AppMode.running;
                                                clicked => {
                                                    root.clip-rename-id = clip.id;
                                                    root.clip-rename-original = clip.name;
                                                    root.clip-rename-name = clip.name;
                                                    root.clip-rename-visible = true;
                                                }
                                            }
                                            Button {
                                                width: 100px;
                                                text: "Duplicate";
                                                accessible-label: "Duplicate " + clip.name + " as an independent reusable clip";
                                                enabled: root.app-mode == AppMode.running;
                                                clicked => {
                                                    root.clip-duplicate-id = clip.id;
                                                    root.clip-duplicate-source-name = clip.name;
                                                    root.clip-duplicate-name = "";
                                                    root.clip-duplicate-visible = true;
                                                }
                                            }
                                            Button {
                                                width: 88px;
                                                text: "Place";
                                                accessible-label: "Place the full " + clip.name + " clip at an exact project tick";
                                                enabled: root.app-mode == AppMode.running;
                                                clicked => {
                                                    root.add-arrangement-placement-clip-id = clip.id;
                                                    root.add-arrangement-placement-clip-name = clip.name;
                                                    root.add-arrangement-placement-track-name = clip.track-name;
                                                    root.add-arrangement-placement-duration-ticks = clip.duration-ticks;
                                                    root.add-arrangement-placement-start-tick = "0";
                                                    root.add-arrangement-placement-visible = true;
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            Button {
                                                width: 116px;
                                                text: "Remove unused";
                                                accessible-label: "Remove unused reusable clip " + clip.name + " without deleting its source audio";
                                                enabled: root.app-mode == AppMode.running;
                                                clicked => {
                                                    root.clip-remove-id = clip.id;
                                                    root.clip-remove-name = clip.name;
                                                    root.clip-remove-visible = true;
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            Button {
                                                width: 92px;
                                                text: "Gain";
                                                accessible-label: "Edit gain for " + clip.name;
                                                enabled: root.app-mode == AppMode.running;
                                                clicked => {
                                                    root.clip-gain-id = clip.id;
                                                    root.clip-gain-name = clip.name;
                                                    root.clip-gain-original = clip.gain-edit;
                                                    root.clip-gain-value = clip.gain-edit;
                                                    root.clip-gain-visible = true;
                                                }
                                            }
                                            Button {
                                                width: 92px;
                                                text: "Loop";
                                                accessible-label: "Edit reusable loop for " + clip.name;
                                                enabled: root.app-mode == AppMode.running;
                                                clicked => {
                                                    root.clip-loop-id = clip.id;
                                                    root.clip-loop-name = clip.name;
                                                    root.clip-loop-duration = clip.duration-ticks;
                                                    root.clip-loop-original-enabled = clip.loop-enabled;
                                                    root.clip-loop-original-start = clip.loop-start-edit;
                                                    root.clip-loop-original-end = clip.loop-end-edit;
                                                    root.clip-loop-enabled = clip.loop-enabled;
                                                    root.clip-loop-start = clip.loop-start-edit;
                                                    root.clip-loop-end = clip.loop-end-edit;
                                                    root.clip-loop-visible = true;
                                                }
                                            }
                                            Button {
                                                width: 92px;
                                                text: "Fades";
                                                accessible-label: "Edit linear fades for " + clip.name;
                                                enabled: root.app-mode == AppMode.running;
                                                clicked => {
                                                    root.clip-fades-id = clip.id;
                                                    root.clip-fades-name = clip.name;
                                                    root.clip-fades-duration = clip.duration-ticks;
                                                    root.clip-fades-original-in = clip.fade-in-edit;
                                                    root.clip-fades-original-out = clip.fade-out-edit;
                                                    root.clip-fades-in = clip.fade-in-edit;
                                                    root.clip-fades-out = clip.fade-out-edit;
                                                    root.clip-fades-visible = true;
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            Button {
                                                width: 92px;
                                                text: clip.active ? "Disable" : "Enable";
                                                accessible-label: (clip.active ? "Disable " : "Enable ") + clip.name + " everywhere";
                                                enabled: root.app-mode == AppMode.running;
                                                clicked => { IdeActions.set-audio-clip-active(clip.id, !clip.active); }
                                            }
                                            Button {
                                                width: 92px;
                                                text: clip.reverse ? "Forward" : "Reverse";
                                                accessible-label: (clip.reverse ? "Use forward playback for " : "Use reverse playback for ") + clip.name + " everywhere";
                                                enabled: root.app-mode == AppMode.running;
                                                clicked => { IdeActions.set-audio-clip-reverse(clip.id, !clip.reverse); }
                                            }
                                            Button {
                                                width: 92px;
                                                text: "Slip source";
                                                accessible-label: "Move the immutable source view for " + clip.name + " to an exact frame everywhere";
                                                enabled: root.app-mode == AppMode.running;
                                                clicked => {
                                                    root.clip-source-slip-id = clip.id;
                                                    root.clip-source-slip-name = clip.name;
                                                    root.clip-source-slip-frame-count = clip.source-frame-count;
                                                    root.clip-source-slip-original = clip.source-start-edit;
                                                    root.clip-source-slip-start = clip.source-start-edit;
                                                    root.clip-source-slip-visible = true;
                                                }
                                            }
                                            Button {
                                                width: 92px;
                                                text: "Trim source";
                                                accessible-label: "Trim the reusable source view for " + clip.name + " everywhere";
                                                enabled: root.app-mode == AppMode.running;
                                                clicked => {
                                                    root.clip-source-trim-id = clip.id;
                                                    root.clip-source-trim-name = clip.name;
                                                    root.clip-source-trim-original-start = clip.source-start-edit;
                                                    root.clip-source-trim-original-frame-count = clip.source-frame-count;
                                                    root.clip-source-trim-start = clip.source-start-edit;
                                                    root.clip-source-trim-frame-count = clip.source-frame-count;
                                                    root.clip-source-trim-visible = true;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Text {
                            text: "Import copies WAV or FLAC into project-owned 48 kHz media and creates one full-file reusable clip per file; it creates no arrangement placement. Rename changes metadata only. Duplicate shares immutable source audio but creates no placement. Remove unused deletes only an unreferenced reusable clip and keeps its source media. Clean unused media permanently deletes only project-owned sample copies referenced by no clip; recording takes and external originals are never included. Place creates one full-length non-ripple reference. Activation, direction, source slip, source trim, gain, loop, and fades affect every existing reference.";
                            color: #65758a;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                    }
                }

                if root.clips-visible && root.clip-rename-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;
                        Text { text: "RENAME AUDIO CLIP"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: root.clip-rename-original; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                        Text {
                            text: "Enter a display name from 1 to 120 characters. Leading and trailing whitespace is removed before validation.";
                            color: #aebccc;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        IdeLineEdit {
                            text <=> root.clip-rename-name;
                            placeholder-text: "Audio clip name";
                            accessible-label: "New audio clip name";
                        }
                        Text {
                            text: "Clip identity, arrangement placements, owning track, playback settings, and immutable source audio remain unchanged.";
                            color: #65758a;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Cancel"; clicked => { root.clip-rename-visible = false; } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Rename clip";
                                enabled: root.app-mode == AppMode.running
                                    && root.clip-rename-id != ""
                                    && root.clip-rename-name != ""
                                    && root.clip-rename-name != root.clip-rename-original;
                                clicked => { IdeActions.rename-audio-clip(root.clip-rename-id, root.clip-rename-name); }
                            }
                        }
                    }
                }

                if root.clips-visible && root.clip-duplicate-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;
                        Text { text: "DUPLICATE AUDIO CLIP"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: root.clip-duplicate-source-name; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                        Text {
                            text: "Enter a name from 1 to 120 characters for the new reusable clip. Leading and trailing whitespace is removed before validation.";
                            color: #aebccc;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        IdeLineEdit {
                            text <=> root.clip-duplicate-name;
                            placeholder-text: "New audio clip name";
                            accessible-label: "Duplicated audio clip name";
                        }
                        Text {
                            text: "The duplicate receives a new identity and independent clip metadata. It keeps the same verified source view and owning track. No audio media or arrangement placement is created.";
                            color: #65758a;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Cancel"; clicked => { root.clip-duplicate-visible = false; } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: root.app-mode == AppMode.duplicating-clip ? "Duplicating clip..." : "Duplicate clip";
                                enabled: root.app-mode == AppMode.running
                                    && root.clip-duplicate-id != ""
                                    && root.clip-duplicate-name != "";
                                clicked => { IdeActions.duplicate-audio-clip(root.clip-duplicate-id, root.clip-duplicate-name); }
                            }
                        }
                    }
                }

                if root.clips-visible && root.clip-remove-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;
                        Text { text: "REMOVE UNUSED AUDIO CLIP"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: root.clip-remove-name; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                        Text {
                            text: "This removes the reusable clip only when no arrangement placement or scene Play action still references it.";
                            color: #aebccc;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "The immutable source audio and its asset declaration are retained. This action does not clean up media files and cannot be undone.";
                            color: #65758a;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Cancel"; clicked => { root.clip-remove-visible = false; } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: root.app-mode == AppMode.removing-clip ? "Removing clip..." : "Remove unused clip";
                                enabled: root.app-mode == AppMode.running && root.clip-remove-id != "";
                                clicked => { IdeActions.remove-audio-clip(root.clip-remove-id); }
                            }
                        }
                    }
                }

                if root.clips-visible && !root.clip-rename-visible && !root.clip-duplicate-visible && root.add-arrangement-placement-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;
                        Text { text: "PLACE CLIP IN ARRANGEMENT"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: root.add-arrangement-placement-clip-name; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                        Text {
                            text: root.add-arrangement-placement-track-name + " · " + root.add-arrangement-placement-duration-ticks + " ticks";
                            color: #aebccc;
                            font-size: 11px;
                            overflow: elide;
                        }
                        Text {
                            text: "Enter the exact project start tick. This creates one new, enabled placement of the complete reusable clip on its owning track.";
                            color: #aebccc;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        IdeLineEdit {
                            text <=> root.add-arrangement-placement-start-tick;
                            placeholder-text: "0";
                            accessible-label: "Arrangement placement start tick";
                        }
                        Text {
                            text: "The edit is non-ripple: existing placements keep their exact ticks. The reusable clip and immutable source audio are unchanged. Overlap and conflicting scene authority are rejected.";
                            color: #65758a;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Cancel"; clicked => { root.add-arrangement-placement-visible = false; } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Place full clip";
                                enabled: root.app-mode == AppMode.running
                                    && root.add-arrangement-placement-clip-id != ""
                                    && root.add-arrangement-placement-start-tick != "";
                                clicked => {
                                    IdeActions.add-arrangement-placement(
                                        root.add-arrangement-placement-clip-id,
                                        root.add-arrangement-placement-start-tick
                                    );
                                }
                            }
                        }
                    }
                }

                if root.clips-visible && !root.clip-rename-visible && !root.clip-duplicate-visible && root.clip-gain-visible && !root.clip-fades-visible && !root.clip-loop-visible && !root.add-arrangement-placement-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;
                        Text { text: "EDIT CLIP GAIN"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: root.clip-gain-name; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                        Text {
                            text: "Enter constant gain in dB. Values must be finite and at or below the native +6.0206 dB limit. Negative values attenuate; 0 dB is unity.";
                            color: #aebccc;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        IdeLineEdit {
                            text <=> root.clip-gain-value;
                            placeholder-text: "0";
                            accessible-label: "Audio clip gain in decibels";
                        }
                        Text {
                            text: "This edits the reusable clip everywhere it is referenced. It does not normalize audio or change the source asset.";
                            color: #65758a;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Cancel"; clicked => { root.clip-gain-visible = false; } }
                            Button { text: "Reset to 0 dB"; clicked => { root.clip-gain-value = "0"; } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Apply gain";
                                enabled: root.app-mode == AppMode.running
                                    && root.clip-gain-id != ""
                                    && root.clip-gain-value != ""
                                    && root.clip-gain-value != root.clip-gain-original;
                                clicked => { IdeActions.set-audio-clip-gain(root.clip-gain-id, root.clip-gain-value); }
                            }
                        }
                    }
                }

                if root.clips-visible && !root.clip-rename-visible && !root.clip-duplicate-visible && !root.clip-gain-visible && root.clip-fades-visible && !root.clip-loop-visible && !root.add-arrangement-placement-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;
                        Text { text: "EDIT CLIP FADES"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: root.clip-fades-name; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                        Text {
                            text: "Enter exact fade-in and fade-out durations in project ticks. Their combined duration may not exceed the clip's " + root.clip-fades-duration + " ticks.";
                            color: #aebccc;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        GridLayout {
                            spacing: 8px;
                            Text { text: "Fade in"; color: #8fa0b4; vertical-alignment: center; }
                            IdeLineEdit { text <=> root.clip-fades-in; placeholder-text: "0"; accessible-label: "Audio clip fade-in ticks"; }
                            Text { text: "Fade out"; color: #8fa0b4; vertical-alignment: center; }
                            IdeLineEdit { text <=> root.clip-fades-out; placeholder-text: "0"; accessible-label: "Audio clip fade-out ticks"; }
                        }
                        Text {
                            text: "The fixed curve is linear amplitude. This edits the reusable clip everywhere it is referenced; it is not an arrangement crossfade and does not change source audio.";
                            color: #65758a;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Cancel"; clicked => { root.clip-fades-visible = false; } }
                            Button { text: "Reset fades"; clicked => { root.clip-fades-in = "0"; root.clip-fades-out = "0"; } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Apply fades";
                                enabled: root.app-mode == AppMode.running
                                    && root.clip-fades-id != ""
                                    && root.clip-fades-in != ""
                                    && root.clip-fades-out != ""
                                    && (root.clip-fades-in != root.clip-fades-original-in
                                        || root.clip-fades-out != root.clip-fades-original-out);
                                clicked => { IdeActions.set-audio-clip-fades(root.clip-fades-id, root.clip-fades-in, root.clip-fades-out); }
                            }
                        }
                    }
                }

                if root.clips-visible && !root.clip-rename-visible && !root.clip-duplicate-visible && !root.clip-gain-visible && !root.clip-fades-visible && root.clip-loop-visible && !root.add-arrangement-placement-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;
                        Text { text: "EDIT REUSABLE CLIP LOOP"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: root.clip-loop-name; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                        Text {
                            text: "Set an exact non-empty loop range within the clip's " + root.clip-loop-duration + " ticks. The stored range remains valid when looping is disabled.";
                            color: #aebccc;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Button {
                            text: root.clip-loop-enabled ? "Loop enabled" : "Loop disabled";
                            accessible-label: root.clip-loop-enabled ? "Disable reusable clip loop" : "Enable reusable clip loop";
                            clicked => { root.clip-loop-enabled = !root.clip-loop-enabled; }
                        }
                        GridLayout {
                            spacing: 8px;
                            Text { text: "Loop start"; color: #8fa0b4; vertical-alignment: center; }
                            IdeLineEdit { text <=> root.clip-loop-start; placeholder-text: "0"; accessible-label: "Audio clip loop start tick"; }
                            Text { text: "Loop end"; color: #8fa0b4; vertical-alignment: center; }
                            IdeLineEdit { text <=> root.clip-loop-end; placeholder-text: root.clip-loop-duration; accessible-label: "Audio clip loop end tick"; }
                        }
                        Text {
                            text: "This edits the reusable clip everywhere it is referenced. It is not the transport loop, does not repeat arrangement placements, and does not change source audio.";
                            color: #65758a;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Cancel"; clicked => { root.clip-loop-visible = false; } }
                            Button {
                                text: "Full clip";
                                clicked => { root.clip-loop-start = "0"; root.clip-loop-end = root.clip-loop-duration; }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Apply loop";
                                enabled: root.app-mode == AppMode.running
                                    && root.clip-loop-id != ""
                                    && root.clip-loop-start != ""
                                    && root.clip-loop-end != ""
                                    && (root.clip-loop-enabled != root.clip-loop-original-enabled
                                        || root.clip-loop-start != root.clip-loop-original-start
                                        || root.clip-loop-end != root.clip-loop-original-end);
                                clicked => {
                                    IdeActions.set-audio-clip-loop(
                                        root.clip-loop-id,
                                        root.clip-loop-enabled,
                                        root.clip-loop-start,
                                        root.clip-loop-end
                                    );
                                }
                            }
                        }
                    }
                }

                if root.clips-visible && !root.clip-rename-visible && !root.clip-duplicate-visible && !root.clip-gain-visible && !root.clip-fades-visible && !root.clip-loop-visible && root.clip-source-slip-visible && !root.clip-source-trim-visible && !root.add-arrangement-placement-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;
                        Text { text: "SLIP REUSABLE CLIP SOURCE"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: root.clip-source-slip-name; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                        Text {
                            text: "Enter the exact first frame for this " + root.clip-source-slip-frame-count + "-frame view. The complete view must remain inside the verified audio asset.";
                            color: #aebccc;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        GridLayout {
                            spacing: 8px;
                            Text { text: "Source start frame"; color: #8fa0b4; vertical-alignment: center; }
                            IdeLineEdit { text <=> root.clip-source-slip-start; placeholder-text: "0"; accessible-label: "Audio clip source start frame"; }
                        }
                        Text {
                            text: "This is a nondestructive global slip of the reusable clip. Duration, warp, loop, fades, arrangement timing, scene references, and media bytes remain unchanged.";
                            color: #65758a;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Cancel"; clicked => { root.clip-source-slip-visible = false; } }
                            Button { text: "Asset start"; clicked => { root.clip-source-slip-start = "0"; } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Apply source slip";
                                enabled: root.app-mode == AppMode.running
                                    && root.clip-source-slip-id != ""
                                    && root.clip-source-slip-start != ""
                                    && root.clip-source-slip-start != root.clip-source-slip-original;
                                clicked => { IdeActions.set-audio-clip-source-start(root.clip-source-slip-id, root.clip-source-slip-start); }
                            }
                        }
                    }
                }

                if root.clips-visible && !root.clip-rename-visible && !root.clip-duplicate-visible && !root.clip-gain-visible && !root.clip-fades-visible && !root.clip-loop-visible && !root.clip-source-slip-visible && root.clip-source-trim-visible && !root.add-arrangement-placement-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;
                        Text { text: "TRIM REUSABLE CLIP SOURCE VIEW"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                        Text { text: root.clip-source-trim-name; color: #edf2f8; font-size: 22px; font-weight: 600; overflow: elide; }
                        Text {
                            text: "Set a shorter exact source view. This cannot extend the committed " + root.clip-source-trim-original-frame-count + "-frame view.";
                            color: #aebccc;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        GridLayout {
                            spacing: 8px;
                            Text { text: "Source start frame"; color: #8fa0b4; vertical-alignment: center; }
                            IdeLineEdit { text <=> root.clip-source-trim-start; placeholder-text: "0"; accessible-label: "Trimmed audio clip source start frame"; }
                            Text { text: "Source frame count"; color: #8fa0b4; vertical-alignment: center; }
                            IdeLineEdit { text <=> root.clip-source-trim-frame-count; placeholder-text: "1"; accessible-label: "Trimmed audio clip source frame count"; }
                        }
                        Text {
                            text: "The trim preserves exact source rate and changes every reference only after save and reopen. It refuses nonlinear warp, lossy timing, and loop or fade state that no longer fits; source audio bytes and arrangement timing stay unchanged.";
                            color: #65758a;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Cancel"; clicked => { root.clip-source-trim-visible = false; } }
                            Button {
                                text: "Restore view";
                                clicked => {
                                    root.clip-source-trim-start = root.clip-source-trim-original-start;
                                    root.clip-source-trim-frame-count = root.clip-source-trim-original-frame-count;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Apply source trim";
                                enabled: root.app-mode == AppMode.running
                                    && root.clip-source-trim-id != ""
                                    && root.clip-source-trim-start != ""
                                    && root.clip-source-trim-frame-count != ""
                                    && (root.clip-source-trim-start != root.clip-source-trim-original-start
                                        || root.clip-source-trim-frame-count != root.clip-source-trim-original-frame-count);
                                clicked => { IdeActions.trim-audio-clip-source(root.clip-source-trim-id, root.clip-source-trim-start, root.clip-source-trim-frame-count); }
                            }
                        }
                    }
                }

                if root.loudness-visible && !root.clips-visible : Panel {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        HorizontalLayout {
                            height: 48px;
                            VerticalLayout {
                                Text { text: "LIVE LOUDNESS"; color: #6f8197; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                                Text { text: "Final stereo output · programme " + root.loudness-programme-time; color: #aebccc; font-size: 12px; }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text {
                                width: 82px;
                                text: root.loudness-state;
                                color: root.loudness-state == "RUNNING" ? #63e6b5 : root.loudness-state == "STANDBY" ? #f5b83d : #8fa0b4;
                                font-size: 10px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            Button {
                                text: "Performance";
                                clicked => { root.loudness-reset-confirming = false; root.loudness-visible = false; root.arrangement-visible = false; root.mixer-visible = false; root.mixer-sends-visible = false; root.takes-visible = false; }
                            }
                            Button {
                                text: "Mixer";
                                enabled: root.app-mode == AppMode.running;
                                clicked => { root.loudness-reset-confirming = false; root.loudness-visible = false; root.arrangement-visible = false; root.mixer-visible = true; root.mixer-sends-visible = false; root.takes-visible = false; }
                            }
                        }

                        Rectangle { height: 1px; background: #27313d; }

                        HorizontalLayout {
                            height: 34px;
                            spacing: 6px;
                            Text { width: 104px; text: "PRESENTATION"; color: #65758a; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                            Button {
                                text: root.loudness-wide-scale ? "EBU +9" : "✓ EBU +9";
                                clicked => { root.loudness-wide-scale = false; }
                            }
                            Button {
                                text: root.loudness-wide-scale ? "✓ EBU +18" : "EBU +18";
                                clicked => { root.loudness-wide-scale = true; }
                            }
                            Button {
                                text: root.loudness-relative ? "LUFS" : "✓ LUFS";
                                clicked => { root.loudness-relative = false; }
                            }
                            Button {
                                text: root.loudness-relative ? "✓ LU" : "LU";
                                clicked => { root.loudness-relative = true; }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: root.loudness-scale-name; color: #8290a2; font-size: 10px; vertical-alignment: center; }
                        }

                        GridLayout {
                            spacing: 8px;
                            LoudnessCard { row: 0; col: 0; height: 128px; label: "M · MOMENTARY"; value: root.loudness-momentary; detail: "400 ms · live in run and standby"; }
                            LoudnessCard { row: 0; col: 1; height: 128px; label: "S · SHORT-TERM"; value: root.loudness-short-term; detail: "3 s · live in run and standby"; }
                            LoudnessCard { row: 0; col: 2; height: 128px; label: "I · INTEGRATED"; value: root.loudness-integrated; detail: "Gated programme measurement"; primary: true; }
                        }

                        GridLayout {
                            spacing: 8px;
                            LoudnessCard { row: 0; col: 0; height: 96px; label: "MAX M"; value: root.loudness-maximum-momentary; detail: "Since reset"; }
                            LoudnessCard { row: 0; col: 1; height: 96px; label: "MAX S"; value: root.loudness-maximum-short-term; detail: "Since reset"; }
                            LoudnessCard { row: 0; col: 2; height: 96px; label: "LOUDNESS RANGE"; value: root.loudness-range; detail: root.loudness-lra-status; }
                            LoudnessCard { row: 0; col: 3; height: 96px; label: "MAX TRUE PEAK"; value: root.loudness-maximum-true-peak; detail: "Final output · since reset"; }
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }

                        if !root.loudness-reset-confirming : HorizontalLayout {
                            height: 42px;
                            spacing: 8px;
                            Text { width: 104px; text: "MEASUREMENT"; color: #65758a; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                            Button {
                                text: "Run";
                                enabled: root.app-mode == AppMode.running && root.loudness-available && root.loudness-state != "RUNNING";
                                clicked => { IdeActions.loudness-run(); }
                            }
                            Button {
                                text: "Standby";
                                enabled: root.app-mode == AppMode.running && root.loudness-available && root.loudness-state != "STANDBY";
                                clicked => { IdeActions.loudness-standby(); }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Reset measurement";
                                enabled: root.app-mode == AppMode.running && root.loudness-available;
                                clicked => { root.loudness-reset-confirming = true; }
                            }
                        }

                        if root.loudness-reset-confirming : HorizontalLayout {
                            height: 42px;
                            spacing: 8px;
                            Text { horizontal-stretch: 1; text: "Reset I, LRA, maximum M/S and maximum true peak?"; color: #ffbf9b; font-size: 11px; vertical-alignment: center; }
                            Button { text: "Cancel"; clicked => { root.loudness-reset-confirming = false; } }
                            Button {
                                text: "Confirm reset";
                                enabled: root.app-mode == AppMode.running && root.loudness-available;
                                clicked => { IdeActions.loudness-reset(); }
                            }
                        }

                        Text {
                            height: 26px;
                            text: "Measurement only · standby keeps M/S live · no normalization, limiting, or certified EBU Mode claim.";
                            color: #65758a;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        Rectangle {
            height: root.error-text == "" ? 38px : 52px;
            border-radius: 6px;
            background: root.error-text == "" ? #111820 : #3b2022;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                Text {
                    text: root.error-text == "" ? root.status-text : root.error-text;
                    color: root.error-text == "" ? #8494a8 : #ffaaa6;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
    }
}
