import { Button, HorizontalBox, ListView, ScrollView, VerticalBox } from "std-widgets.slint";

export struct OperatorSceneRow {
    name: string,
    status: string,
    available: bool,
    queued: bool,
    last-launched: bool,
}

export struct OperatorMixerRow {
    name: string,
    gain-percent: float,
    pan-percent: float,
    muted: bool,
    soloed: bool,
    controls-enabled: bool,
    solo-available: bool,
}

export struct OperatorMixerSendRow {
    source-name: string,
    target-name: string,
    tap: string,
    gain-percent: float,
    pan-percent: float,
    enabled: bool,
    controls-enabled: bool,
}

component FactCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> detail;
    background: #171b24;
    border-color: #2c3445;
    border-width: 1px;
    border-radius: 8px;
    min-height: 72px;

    VerticalLayout {
        padding: 12px;
        spacing: 5px;
        Text { text: root.label; color: #8d99ad; font-size: 11px; }
        Text { text: root.value; color: #edf2f8; font-size: 15px; overflow: elide; }
        if root.detail != "" : Text { text: root.detail; color: #8d99ad; font-size: 11px; overflow: elide; }
    }
}

component OutputMeterBar inherits Rectangle {
    in property <string> channel;
    in property <float> level;
    in property <string> reading;
    in property <string> peak-reading;
    background: #0c1118;
    border-radius: 5px;
    min-height: 30px;

    HorizontalLayout {
        padding: 7px;
        spacing: 10px;
        Text { text: root.channel; color: #8d99ad; font-size: 10px; font-weight: 700; width: 16px; }
        Rectangle {
            background: #202836;
            border-radius: 3px;
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width * root.level;
                height: parent.height;
                border-radius: 3px;
                background: root.level >= 1 ? #ff5a55 : root.level > 0.76 ? #f5b83d : #3ddc97;
            }
        }
        Text { text: root.reading; color: #edf2f8; font-size: 11px; width: 76px; horizontal-alignment: right; }
        Text { text: root.peak-reading; color: #8d99ad; font-size: 10px; width: 84px; horizontal-alignment: right; }
    }
}

component LoudnessValue inherits Rectangle {
    in property <string> label;
    in property <string> value;
    background: #111620;
    border-color: #2c3445;
    border-width: 1px;
    border-radius: 5px;
    min-height: 48px;

    VerticalLayout {
        padding: 7px;
        spacing: 3px;
        Text { text: root.label; color: #69778c; font-size: 9px; font-weight: 700; }
        Text { text: root.value; color: #edf2f8; font-size: 12px; overflow: elide; }
    }
}

component SceneLaunchTile inherits Rectangle {
    in property <string> name;
    in property <string> status;
    in property <bool> available;
    in property <bool> queued;
    in property <bool> last-launched;
    callback launch-requested();
    width: 94px;
    min-height: 62px;
    background: root.queued ? #44306f : root.last-launched ? #174c42 : root.available ? #202836 : #141923;
    border-color: root.queued ? #a88cff : root.last-launched ? #3ddc97 : #2c3445;
    border-width: 1px;
    border-radius: 5px;
    opacity: root.available ? 1 : 0.72;

    VerticalLayout {
        padding: 7px;
        spacing: 4px;
        Text { text: root.name; color: #edf2f8; font-size: 11px; font-weight: 700; overflow: elide; }
        Text { text: root.status; color: #8d99ad; font-size: 9px; overflow: elide; }
    }
    TouchArea {
        enabled: root.available;
        clicked => { root.launch-requested(); }
    }
}

component CommittedSlider inherits Rectangle {
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step: 1;
    in property <float> committed-value;
    in property <bool> enabled: true;
    in property <string> control-label;
    callback released(float);
    private property <bool> pointer-armed: false;

    min-width: 80px;
    min-height: 20px;
    background: transparent;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: slider;
    accessible-enabled: root.enabled;
    accessible-label: root.control-label;
    accessible-orientation: Orientation.horizontal;
    accessible-value: root.committed-value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-set-value(value) => {
        if root.enabled && value.is-float() {
            root.submit(value.to-float());
        }
    }
    accessible-action-increment => {
        if root.enabled {
            root.submit(root.committed-value + root.step);
        }
    }
    accessible-action-decrement => {
        if root.enabled {
            root.submit(root.committed-value - root.step);
        }
    }
    forward-focus: keyboard;

    rail := Rectangle {
        x: thumb.width / 2;
        y: (parent.height - self.height) / 2;
        width: parent.width - thumb.width;
        height: 4px;
        background: #3a4558;
        border-radius: 2px;
    }
    Rectangle {
        x: rail.x;
        y: rail.y;
        width: max(0px, thumb.x + thumb.width / 2 - rail.x);
        height: rail.height;
        background: #2788e8;
        border-radius: rail.border-radius;
    }
    thumb := Rectangle {
        x: clamp(
            (parent.width - self.width) * (root.committed-value - root.minimum) / (root.maximum - root.minimum),
            0px,
            parent.width - self.width,
        );
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        border-width: keyboard.has-focus ? 2px : 1px;
        border-color: #6db6ff;
        background: #edf2f8;
    }
    TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.kind == PointerEventKind.cancel {
                root.pointer-armed = false;
                return;
            }
            if event.button != PointerEventButton.left {
                return;
            }
            if event.kind == PointerEventKind.down {
                root.pointer-armed = true;
                keyboard.focus();
                return;
            }
            if event.kind == PointerEventKind.up {
                if root.pointer-armed {
                    root.submit(root.value-at(self.mouse-x));
                }
                root.pointer-armed = false;
            }
        }
    }
    keyboard := FocusScope {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
        enabled: root.enabled;
        key-pressed(event) => {
            if !self.enabled || root.step <= 0 {
                return reject;
            }
            if event.text == Key.LeftArrow || event.text == Key.RightArrow
                || event.text == Key.Home || event.text == Key.End {
                return accept;
            }
            reject
        }
        key-released(event) => {
            if !self.enabled {
                return reject;
            }
            if event.text == Key.LeftArrow {
                root.submit(root.committed-value - root.step);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.submit(root.committed-value + root.step);
                return accept;
            }
            if event.text == Key.Home {
                root.submit(root.minimum);
                return accept;
            }
            if event.text == Key.End {
                root.submit(root.maximum);
                return accept;
            }
            reject
        }
    }

    pure function value-at(x: length) -> float {
        root.minimum
            + clamp(
                (x - thumb.width / 2) / max(1px, root.width - thumb.width),
                0,
                1,
            ) * (root.maximum - root.minimum)
    }

    public function submit(value: float) {
        root.released(max(root.minimum, min(root.maximum, value)));
    }
}

component MixerChannelRow inherits Rectangle {
    in property <string> name;
    in property <float> gain-percent;
    in property <float> pan-percent;
    in property <bool> muted;
    in property <bool> soloed;
    in property <bool> controls-enabled;
    in property <bool> solo-available;
    callback mute-requested();
    callback solo-requested();
    callback gain-requested(float);
    callback pan-requested(float);
    min-height: 74px;
    background: #111620;
    border-color: #2c3445;
    border-width: 1px;
    border-radius: 5px;

    VerticalLayout {
        padding: 6px;
        spacing: 5px;
        HorizontalLayout {
            spacing: 7px;
            Text { text: root.name; color: #edf2f8; font-size: 11px; font-weight: 700; overflow: elide; }
            Button {
                text: root.muted ? "Unmute" : "Mute";
                accessible-label: (root.muted ? "Unmute " : "Mute ") + root.name;
                enabled: root.controls-enabled;
                clicked => { root.mute-requested(); }
            }
            Button {
                text: root.soloed ? "Unsolo" : "Solo";
                accessible-label: root.solo-available
                    ? (root.soloed ? "Unsolo " : "Solo ") + root.name
                    : "Solo unavailable for " + root.name;
                enabled: root.controls-enabled && root.solo-available;
                clicked => { root.solo-requested(); }
            }
        }
        HorizontalLayout {
            spacing: 7px;
            Text { text: "GAIN " + Math.round(root.gain-percent) + "%"; color: #8d99ad; font-size: 9px; width: 68px; }
            CommittedSlider {
                minimum: 0;
                maximum: 200;
                committed-value: root.gain-percent;
                enabled: root.controls-enabled;
                control-label: root.name + " live gain";
                released(value) => { root.gain-requested(value); }
            }
            Text { text: "PAN " + Math.round(root.pan-percent); color: #8d99ad; font-size: 9px; width: 58px; }
            CommittedSlider {
                minimum: -100;
                maximum: 100;
                committed-value: root.pan-percent;
                enabled: root.controls-enabled;
                control-label: root.name + " live pan";
                released(value) => { root.pan-requested(value); }
            }
        }
    }
}

component MixerSendRow inherits Rectangle {
    in property <string> source-name;
    in property <string> target-name;
    in property <string> tap;
    in property <float> gain-percent;
    in property <float> pan-percent;
    in property <bool> send-enabled;
    in property <bool> controls-enabled;
    callback toggle-requested();
    callback gain-requested(float);
    callback pan-requested(float);
    min-height: 74px;
    background: #111620;
    border-color: #2c3445;
    border-width: 1px;
    border-radius: 5px;

    VerticalLayout {
        padding: 6px;
        spacing: 5px;
        HorizontalLayout {
            spacing: 7px;
            Text { text: root.source-name + " → " + root.target-name; color: #edf2f8; font-size: 11px; font-weight: 700; overflow: elide; }
            Text { text: root.tap; color: #8d99ad; font-size: 9px; }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            send-toggle := Button {
                text: root.send-enabled ? "Disable" : "Enable";
                accessible-label: self.text + " send " + root.source-name + " to " + root.target-name;
                enabled: root.controls-enabled;
                clicked => { root.toggle-requested(); }
            }
        }
        HorizontalLayout {
            spacing: 7px;
            Text { text: "GAIN " + Math.round(root.gain-percent) + "%"; color: #8d99ad; font-size: 9px; width: 68px; }
            CommittedSlider {
                minimum: 0;
                maximum: 200;
                committed-value: root.gain-percent;
                enabled: root.controls-enabled;
                control-label: root.source-name + " to " + root.target-name + " send gain";
                released(value) => { root.gain-requested(value); }
            }
            Text { text: "PAN " + Math.round(root.pan-percent); color: #8d99ad; font-size: 9px; width: 58px; }
            CommittedSlider {
                minimum: -100;
                maximum: 100;
                committed-value: root.pan-percent;
                enabled: root.controls-enabled;
                control-label: root.source-name + " to " + root.target-name + " send pan";
                released(value) => { root.pan-requested(value); }
            }
        }
    }
}

export component OperatorWindow inherits Window {
    title: "Hyper Runtime";
    width: 880px;
    height: 948px;
    background: #0d1016;

    in property <string> project-name;
    in property <string> project-identity;
    in property <string> project-revision;
    in property <string> deployment-generation;
    in property <string> bundle-identity;
    in property <string> recovery-state;
    in property <string> transport-state;
    in property <string> transport-time;
    in property <string> transport-frame;
    in property <string> transport-musical-position;
    in property <float> transport-position-percent: 0;
    in property <string> transport-seek-state: "Seek unavailable";
    in property <bool> transport-seek-enabled: false;
    in property <string> loop-state;
    in property <string> loop-range;
    in property <string> loop-toggle-label;
    in property <bool> loop-toggle-enabled;
    in property <bool> loop-in-enabled;
    in property <bool> loop-out-enabled;
    in property <bool> loop-clear-enabled;
    in property <string> stream-state;
    in property <string> callback-count;
    in property <string> stream-failures;
    in property <string> native-xruns;
    in property <string> panel-state;
    in property <float> left-output-level;
    in property <string> left-output-reading;
    in property <string> left-output-peak-reading;
    in property <float> right-output-level;
    in property <string> right-output-reading;
    in property <string> right-output-peak-reading;
    in property <bool> output-overload-latched;
    in property <string> output-meter-state;
    in property <string> output-meter-telemetry;
    in property <string> loudness-state: "UNAVAILABLE";
    in property <string> loudness-momentary: "— LUFS";
    in property <string> loudness-short-term: "— LUFS";
    in property <string> loudness-integrated: "— LUFS";
    in property <string> loudness-range: "— LU";
    in property <string> loudness-maximum-true-peak: "— dBTP";
    in property <string> loudness-programme-time: "00:00:00.000";
    in property <string> loudness-lra-status: "Waiting for final-output evidence";
    in property <bool> loudness-run-enabled: false;
    in property <bool> loudness-standby-enabled: false;
    in property <bool> loudness-reset-enabled: false;
    in-out property <bool> loudness-reset-confirming: false;
    in property <[OperatorSceneRow]> scenes;
    in property <string> scene-feedback;
    in property <bool> stop-interactive-scenes-enabled: false;
    in property <[OperatorMixerRow]> mixer-channels;
    in property <[OperatorMixerSendRow]> mixer-sends;
    in property <float> main-gain-percent: 0;
    in property <bool> main-muted: false;
    in property <bool> main-mute-enabled: false;
    in property <string> mixer-state: "Mixer state unavailable";
    in property <string> diagnostic;

    callback start-requested();
    callback stop-requested();
    callback return-to-start-requested();
    callback locate-percent-requested(float);
    callback toggle-loop-requested();
    callback set-loop-in-requested();
    callback set-loop-out-requested();
    callback clear-loop-range-requested();
    callback reset-output-peak-requested();
    callback loudness-run-requested();
    callback loudness-standby-requested();
    callback loudness-reset-requested();
    callback begin-loudness-reset();
    callback cancel-loudness-reset();
    callback confirm-loudness-reset();
    callback toggle-mixer-channel-mute-requested(int);
    callback toggle-mixer-channel-solo-requested(int);
    callback set-mixer-channel-gain-requested(int, float);
    callback set-mixer-channel-pan-requested(int, float);
    callback toggle-mixer-send-requested(int);
    callback set-mixer-send-gain-requested(int, float);
    callback set-mixer-send-pan-requested(int, float);
    callback set-main-gain-requested(float);
    callback toggle-main-mute-requested();
    callback launch-scene-requested(int);
    callback stop-interactive-scenes-requested();
    callback quit-requested();

    begin-loudness-reset => {
        if root.loudness-reset-enabled {
            root.loudness-reset-confirming = true;
        }
    }
    cancel-loudness-reset => {
        root.loudness-reset-confirming = false;
    }
    confirm-loudness-reset => {
        if root.loudness-reset-enabled {
            root.loudness-reset-confirming = false;
            root.loudness-reset-requested();
        }
    }

    ScrollView {
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        VerticalLayout {
            padding: 24px;
            spacing: 18px;

        VerticalLayout {
            spacing: 4px;
            Text { text: "HYPER RUNTIME"; color: #6fd6bd; font-size: 13px; font-weight: 700; }
            Text { text: root.project-name; color: #f7f9fc; font-size: 28px; font-weight: 700; overflow: elide; }
            Text { text: root.project-identity + "  ·  revision " + root.project-revision; color: #8d99ad; font-size: 12px; overflow: elide; }
        }

        HorizontalLayout {
            spacing: 12px;
            FactCard {
                label: "TRANSPORT";
                value: root.transport-state + "  ·  " + root.transport-time;
                detail: "BBT " + root.transport-musical-position + "  ·  frame " + root.transport-frame;
            }
            FactCard { label: "SESSION LOOP"; value: root.loop-state; detail: root.loop-range; }
            FactCard { label: "AUDIO OWNER"; value: root.stream-state; }
            FactCard { label: "PANEL LINK"; value: root.panel-state; }
        }

        HorizontalLayout {
            spacing: 10px;
            Text {
                text: root.transport-seek-state;
                color: #8d99ad;
                font-size: 10px;
                vertical-alignment: center;
            }
            CommittedSlider {
                horizontal-stretch: 1;
                minimum: 0;
                maximum: 100;
                step: 0.1;
                committed-value: root.transport-position-percent;
                enabled: root.transport-seek-enabled;
                control-label: "Committed transport position percent";
                released(value) => { root.locate-percent-requested(value); }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            Button { text: "Start"; clicked => { root.start-requested(); } }
            Button { text: "Stop"; clicked => { root.stop-requested(); } }
            Button { text: "Return to start"; clicked => { root.return-to-start-requested(); } }
            Button {
                text: root.loop-toggle-label;
                enabled: root.loop-toggle-enabled;
                clicked => { root.toggle-loop-requested(); }
            }
            Button { text: "Loop In"; enabled: root.loop-in-enabled; clicked => { root.set-loop-in-requested(); } }
            Button { text: "Loop Out"; enabled: root.loop-out-enabled; clicked => { root.set-loop-out-requested(); } }
            Button { text: "Clear loop"; enabled: root.loop-clear-enabled; clicked => { root.clear-loop-range-requested(); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Shut down Runtime"; clicked => { root.quit-requested(); } }
        }

        HorizontalLayout {
            spacing: 12px;
            FactCard { label: "DEPLOYMENT"; value: "generation " + root.deployment-generation; }
            FactCard { label: "CALLBACKS"; value: root.callback-count; }
            FactCard { label: "STREAM FAILURES / XRUNS"; value: root.stream-failures + " / " + root.native-xruns; }
        }

        Rectangle {
            background: #171b24;
            border-color: #2c3445;
            border-width: 1px;
            border-radius: 8px;
            min-height: 124px;
            VerticalLayout {
                padding: 12px;
                spacing: 6px;
                HorizontalLayout {
                    Text { text: "FINAL OUTPUT · SAMPLE PEAK"; color: #8d99ad; font-size: 11px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: root.output-meter-state; color: #8d99ad; font-size: 11px; overflow: elide; }
                    Rectangle {
                        width: 104px;
                        background: root.output-overload-latched ? #7f2428 : #202836;
                        border-radius: 4px;
                        Text {
                            text: root.output-overload-latched ? "OVERLOAD" : "PEAK CLEAR";
                            color: root.output-overload-latched ? #fff1f1 : #8d99ad;
                            font-size: 10px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Button { text: "Reset peak"; clicked => { root.reset-output-peak-requested(); } }
                }
                OutputMeterBar {
                    channel: "L";
                    level: root.left-output-level;
                    reading: root.left-output-reading;
                    peak-reading: root.left-output-peak-reading;
                }
                OutputMeterBar {
                    channel: "R";
                    level: root.right-output-level;
                    reading: root.right-output-reading;
                    peak-reading: root.right-output-peak-reading;
                }
                Text { text: root.output-meter-telemetry; color: #69778c; font-size: 10px; overflow: elide; }
            }
        }

        Rectangle {
            background: #171b24;
            border-color: #2c3445;
            border-width: 1px;
            border-radius: 8px;
            min-height: 124px;
            VerticalLayout {
                padding: 12px;
                spacing: 7px;
                HorizontalLayout {
                    Text { text: "PROGRAMME LOUDNESS · EBU +9"; color: #8d99ad; font-size: 11px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: root.loudness-state; color: root.loudness-state == "RUNNING" ? #3ddc97 : root.loudness-state == "STANDBY" ? #f5b83d : #8d99ad; font-size: 10px; font-weight: 700; }
                    if !root.loudness-reset-confirming : HorizontalLayout {
                        spacing: 5px;
                        Button { text: "Run"; enabled: root.loudness-run-enabled; clicked => { root.loudness-run-requested(); } }
                        Button { text: "Standby"; enabled: root.loudness-standby-enabled; clicked => { root.loudness-standby-requested(); } }
                        Button { text: "Reset programme"; enabled: root.loudness-reset-enabled; clicked => { root.begin-loudness-reset(); } }
                    }
                    if root.loudness-reset-confirming : HorizontalLayout {
                        spacing: 5px;
                        Text { text: "Clear programme history?"; color: #f5b83d; font-size: 10px; vertical-alignment: center; }
                        Button { text: "Cancel"; clicked => { root.cancel-loudness-reset(); } }
                        Button { text: "Confirm reset"; enabled: root.loudness-reset-enabled; clicked => { root.confirm-loudness-reset(); } }
                    }
                }
                HorizontalLayout {
                    spacing: 7px;
                    LoudnessValue { label: "M · 400 MS"; value: root.loudness-momentary; }
                    LoudnessValue { label: "S · 3 S"; value: root.loudness-short-term; }
                    LoudnessValue { label: "I · GATED"; value: root.loudness-integrated; }
                    LoudnessValue { label: "LOUDNESS RANGE"; value: root.loudness-range; }
                    LoudnessValue { label: "MAX TRUE PEAK"; value: root.loudness-maximum-true-peak; }
                }
                Text { text: "Programme " + root.loudness-programme-time + " · " + root.loudness-lra-status; color: #69778c; font-size: 10px; overflow: elide; }
            }
        }

        Rectangle {
            background: #171b24;
            border-color: #2c3445;
            border-width: 1px;
            border-radius: 8px;
            min-height: 278px;
            VerticalLayout {
                padding: 12px;
                spacing: 7px;
                HorizontalLayout {
                    Text { text: "LIVE MIXER · SESSION ONLY"; color: #8d99ad; font-size: 11px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: root.mixer-state; color: #8d99ad; font-size: 10px; overflow: elide; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: "MAIN " + Math.round(root.main-gain-percent) + "%"; color: #8d99ad; font-size: 9px; }
                    CommittedSlider {
                        width: 128px;
                        minimum: 0;
                        maximum: 200;
                        committed-value: root.main-gain-percent;
                        enabled: root.main-mute-enabled;
                        control-label: "Main live gain";
                        released(value) => { root.set-main-gain-requested(value); }
                    }
                    Button {
                        text: root.main-muted ? "Unmute main" : "Mute main";
                        accessible-label: self.text;
                        enabled: root.main-mute-enabled;
                        clicked => { root.toggle-main-mute-requested(); }
                    }
                }
                ListView {
                    height: 192px;
                    for channel[index] in root.mixer-channels : MixerChannelRow {
                        name: (index + 1) + " · " + channel.name;
                        gain-percent: channel.gain-percent;
                        pan-percent: channel.pan-percent;
                        muted: channel.muted;
                        soloed: channel.soloed;
                        controls-enabled: channel.controls-enabled;
                        solo-available: channel.solo-available;
                        mute-requested => { root.toggle-mixer-channel-mute-requested(index); }
                        solo-requested => { root.toggle-mixer-channel-solo-requested(index); }
                        gain-requested(value) => { root.set-mixer-channel-gain-requested(index, value); }
                        pan-requested(value) => { root.set-mixer-channel-pan-requested(index, value); }
                    }
                }
            }
        }


        if root.mixer-sends.length > 0 : Rectangle {
            background: #171b24;
            border-color: #2c3445;
            border-width: 1px;
            border-radius: 8px;
            min-height: 196px;
            VerticalLayout {
                padding: 12px;
                spacing: 7px;
                Text { text: "LIVE SENDS · SESSION ONLY"; color: #8d99ad; font-size: 11px; font-weight: 700; }
                ListView {
                    height: 160px;
                    for send[index] in root.mixer-sends : MixerSendRow {
                        source-name: (index + 1) + " · " + send.source-name;
                        target-name: send.target-name;
                        tap: send.tap;
                        gain-percent: send.gain-percent;
                        pan-percent: send.pan-percent;
                        send-enabled: send.enabled;
                        controls-enabled: send.controls-enabled;
                        toggle-requested => { root.toggle-mixer-send-requested(index); }
                        gain-requested(value) => { root.set-mixer-send-gain-requested(index, value); }
                        pan-requested(value) => { root.set-mixer-send-pan-requested(index, value); }
                    }
                }
            }
        }

        if root.scenes.length > 0 : Rectangle {
            background: #171b24;
            border-color: #2c3445;
            border-width: 1px;
            border-radius: 8px;
            min-height: 90px;
            VerticalLayout {
                padding: 12px;
                spacing: 7px;
                HorizontalLayout {
                    Text { text: "SCENES"; color: #8d99ad; font-size: 11px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: root.scene-feedback; color: #8d99ad; font-size: 10px; overflow: elide; }
                    Button {
                        text: "Stop interactive scenes";
                        enabled: root.stop-interactive-scenes-enabled;
                        clicked => { root.stop-interactive-scenes-requested(); }
                    }
                }
                HorizontalLayout {
                    spacing: 7px;
                    for scene[index] in root.scenes : SceneLaunchTile {
                        name: (index + 1) + " · " + scene.name;
                        status: scene.status;
                        available: scene.available;
                        queued: scene.queued;
                        last-launched: scene.last-launched;
                        launch-requested => { root.launch-scene-requested(index); }
                    }
                }
            }
        }

        Rectangle {
            background: #111620;
            border-color: #2c3445;
            border-width: 1px;
            border-radius: 8px;
            min-height: 92px;
            VerticalLayout {
                padding: 12px;
                spacing: 5px;
                Text { text: "VERIFIED BUNDLE"; color: #8d99ad; font-size: 11px; }
                Text { text: root.bundle-identity; color: #dce4ef; font-family: "monospace"; font-size: 12px; overflow: elide; }
                Text { text: root.recovery-state; color: #8d99ad; font-size: 12px; }
            }
        }

        Rectangle {
            background: #171b24;
            border-radius: 8px;
            min-height: 54px;
            Text {
                x: 12px; width: parent.width - 24px;
                vertical-alignment: center;
                text: root.diagnostic;
                color: #c8d1df;
                overflow: elide;
            }
        }

        }
    }
}
