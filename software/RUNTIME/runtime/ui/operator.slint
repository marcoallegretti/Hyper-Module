import { Button, ComboBox, HorizontalBox, LineEdit, ListView, ScrollView, VerticalBox } from "std-widgets.slint";

export struct OperatorSceneRow {
    name: string,
    status: string,
    available: bool,
    controls-enabled: bool,
    selected: bool,
    queued: bool,
    last-launched: bool,
}

export struct OperatorTimelineMarkerRow {
    id: string,
    name: string,
    tick: string,
    musical-position: string,
    available: bool,
    controls-enabled: bool,
}

export struct OperatorMixerRow {
    index: int,
    name: string,
    gain-percent: float,
    pan-percent: float,
    muted: bool,
    soloed: bool,
    meter-left-level: float,
    meter-right-level: float,
    meter-left-reading: string,
    meter-right-reading: string,
    controls-enabled: bool,
    solo-available: bool,
}

export struct OperatorMixerSendRow {
    source-name: string,
    target-name: string,
    tap: string,
    gain-percent: float,
    pan-percent: float,
    enabled: bool,
    controls-enabled: bool,
}

export struct OperatorNativeDeviceRow {
    track-name: string,
    kind: string,
    kind-index: int,
    enabled: bool,
    controls-enabled: bool,
    filter-mode-index: int,
    filter-cutoff-hz: float,
    filter-resonance: float,
    compressor-threshold-decibels: float,
    compressor-ratio: float,
    compressor-attack-milliseconds: float,
    compressor-release-milliseconds: float,
    compressor-makeup-decibels: float,
}

export struct OperatorNativeDeviceChainRow {
    track-label: string,
    device-count: int,
}

component ShortcutReferenceRow inherits Rectangle {
    in property <string> chord;
    in property <string> action;
    height: 32px;
    background: #111620;
    border-radius: 5px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Text { width: 112px; text: root.chord; color: #6fd6bd; font-size: 10px; font-weight: 700; vertical-alignment: center; }
        Text { text: root.action; accessible-label: root.chord + ": " + root.action; color: #dce4ef; font-size: 10px; overflow: elide; vertical-alignment: center; }
    }
}

component FactCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> detail;
    background: #171b24;
    border-color: #2c3445;
    border-width: 1px;
    border-radius: 8px;
    min-height: 72px;

    VerticalLayout {
        padding: 12px;
        spacing: 5px;
        Text { text: root.label; color: #8d99ad; font-size: 11px; }
        Text { text: root.value; color: #edf2f8; font-size: 15px; overflow: elide; }
        if root.detail != "" : Text { text: root.detail; color: #8d99ad; font-size: 11px; overflow: elide; }
    }
}

component ControlMappingFactCard inherits Rectangle {
    in property <string> state;
    in property <string> detail;
    in property <bool> warning-state;
    background: #171b24;
    border-color: root.warning-state ? #7a5830 : #2c3445;
    border-width: 1px;
    border-radius: 8px;
    min-height: 68px;

    VerticalLayout {
        padding: 12px;
        spacing: 5px;
        HorizontalLayout {
            Text { text: "CONTROL MAPPING"; color: #8d99ad; font-size: 11px; font-weight: 700; }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text {
                text: root.state;
                accessible-label: "Control mapping " + root.state + ": " + root.detail;
                color: root.warning-state ? #f0b35b : #6fd6bd;
                font-size: 11px;
                font-weight: 700;
            }
        }
        Text { text: root.detail; color: #8d99ad; font-size: 10px; wrap: word-wrap; }
    }
}

component LoopFactCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> detail;
    in property <string> update-state;
    in property <bool> export-enabled;
    callback export-requested();
    background: #171b24;
    border-color: #2c3445;
    border-width: 1px;
    border-radius: 8px;
    min-height: 72px;

    Text {
        x: 12px;
        y: 12px;
        width: root.width - 24px;
        text: root.label;
        color: #8d99ad;
        font-size: 11px;
    }
    Text {
        x: 12px;
        y: 28px;
        width: root.width - 24px;
        text: root.value;
        color: #edf2f8;
        font-size: 15px;
        overflow: elide;
    }
    Text {
        x: 12px;
        y: 50px;
        width: root.width - 92px;
        text: root.detail;
        color: #8d99ad;
        font-size: 11px;
        overflow: elide;
    }
    Button {
        x: root.width - 68px;
        y: 45px;
        width: 56px;
        height: 20px;
        text: "Export";
        accessible-label: "Export the committed session loop as an external update for manual IDE import. " + root.update-state;
        enabled: root.export-enabled;
        clicked => { root.export-requested(); }
    }
}

component OutputMeterBar inherits Rectangle {
    in property <string> channel;
    in property <float> level;
    in property <string> reading;
    in property <string> peak-reading;
    background: #0c1118;
    border-radius: 5px;
    min-height: 30px;

    HorizontalLayout {
        padding: 7px;
        spacing: 10px;
        Text { text: root.channel; color: #8d99ad; font-size: 10px; font-weight: 700; width: 16px; }
        Rectangle {
            background: #202836;
            border-radius: 3px;
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width * root.level;
                height: parent.height;
                border-radius: 3px;
                background: root.level >= 1 ? #ff5a55 : root.level > 0.76 ? #f5b83d : #3ddc97;
            }
        }
        Text { text: root.reading; color: #edf2f8; font-size: 11px; width: 76px; horizontal-alignment: right; }
        Text { text: root.peak-reading; color: #8d99ad; font-size: 10px; width: 84px; horizontal-alignment: right; }
    }
}

component InputMeterBar inherits Rectangle {
    in property <string> channel;
    in property <float> level;
    in property <string> reading;
    background: #0c1118;
    border-radius: 5px;
    min-height: 30px;

    HorizontalLayout {
        padding: 7px;
        spacing: 10px;
        Text { text: root.channel; color: #8d99ad; font-size: 10px; font-weight: 700; width: 16px; }
        Rectangle {
            background: #202836;
            border-radius: 3px;
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width * root.level;
                height: parent.height;
                border-radius: 3px;
                background: root.level >= 1 ? #ff5a55 : root.level > 0.76 ? #f5b83d : #49a6ff;
            }
        }
        Text { text: root.reading; color: #edf2f8; font-size: 11px; width: 76px; horizontal-alignment: right; }
    }
}

component StripPeakBar inherits Rectangle {
    in property <string> channel;
    in property <float> level;
    in property <string> reading;
    background: #0c1118;
    border-radius: 3px;
    min-height: 17px;

    HorizontalLayout {
        padding: 4px;
        spacing: 4px;
        Text { text: root.channel; color: #8d99ad; font-size: 8px; font-weight: 700; width: 8px; }
        Rectangle {
            background: #202836;
            border-radius: 2px;
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width * root.level;
                height: parent.height;
                border-radius: 2px;
                background: root.level >= 1 ? #ff5a55 : root.level > 0.76 ? #f5b83d : #3ddc97;
            }
        }
        Text { text: root.reading; color: #dce5ef; font-size: 9px; width: 72px; horizontal-alignment: right; }
    }
}

component LoudnessValue inherits Rectangle {
    in property <string> label;
    in property <string> value;
    background: #111620;
    border-color: #2c3445;
    border-width: 1px;
    border-radius: 5px;
    min-height: 48px;

    VerticalLayout {
        padding: 7px;
        spacing: 3px;
        Text { text: root.label; color: #69778c; font-size: 9px; font-weight: 700; }
        Text { text: root.value; color: #edf2f8; font-size: 12px; overflow: elide; }
    }
}

component SceneLaunchTile inherits Rectangle {
    in property <string> name;
    in property <string> status;
    in property <bool> available;
    in property <bool> controls-enabled;
    in property <bool> selected;
    in property <bool> queued;
    in property <bool> last-launched;
    callback launch-requested();
    callback selected-requested();
    width: 94px;
    min-height: 62px;
    background: root.queued ? #44306f : root.last-launched ? #174c42 : root.available ? #202836 : #141923;
    border-color: root.queued ? #a88cff : root.last-launched ? #3ddc97 : root.selected ? #7dcfff : #2c3445;
    border-width: 1px;
    border-radius: 5px;
    opacity: root.available && root.controls-enabled ? 1 : 0.72;

    VerticalLayout {
        padding: 7px;
        spacing: 4px;
        Text { text: root.name; color: #edf2f8; font-size: 11px; font-weight: 700; overflow: elide; }
        Text { text: root.status; color: #8d99ad; font-size: 9px; overflow: elide; }
    }
    accessible-role: button;
    accessible-enabled: root.available && root.controls-enabled;
    accessible-label: "Launch scene " + root.name;

    TouchArea {
        enabled: root.available && root.controls-enabled;
        clicked => { root.selected-requested(); root.launch-requested(); }
    }
}

component CommittedSlider inherits Rectangle {
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step: 1;
    in property <float> committed-value;
    in property <bool> enabled: true;
    in property <string> control-label;
    callback released(float);
    private property <bool> pointer-armed: false;

    min-width: 80px;
    min-height: 20px;
    background: transparent;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: slider;
    accessible-enabled: root.enabled;
    accessible-label: root.control-label;
    accessible-orientation: Orientation.horizontal;
    accessible-value: root.committed-value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-set-value(value) => {
        if root.enabled && value.is-float() {
            root.submit(value.to-float());
        }
    }
    accessible-action-increment => {
        if root.enabled {
            root.submit(root.committed-value + root.step);
        }
    }
    accessible-action-decrement => {
        if root.enabled {
            root.submit(root.committed-value - root.step);
        }
    }
    forward-focus: keyboard;

    rail := Rectangle {
        x: thumb.width / 2;
        y: (parent.height - self.height) / 2;
        width: parent.width - thumb.width;
        height: 4px;
        background: #3a4558;
        border-radius: 2px;
    }
    Rectangle {
        x: rail.x;
        y: rail.y;
        width: max(0px, thumb.x + thumb.width / 2 - rail.x);
        height: rail.height;
        background: #2788e8;
        border-radius: rail.border-radius;
    }
    thumb := Rectangle {
        x: clamp(
            (parent.width - self.width) * (root.committed-value - root.minimum) / (root.maximum - root.minimum),
            0px,
            parent.width - self.width,
        );
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        border-width: keyboard.has-focus ? 2px : 1px;
        border-color: #6db6ff;
        background: #edf2f8;
    }
    TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.kind == PointerEventKind.cancel {
                root.pointer-armed = false;
                return;
            }
            if event.button != PointerEventButton.left {
                return;
            }
            if event.kind == PointerEventKind.down {
                root.pointer-armed = true;
                keyboard.focus();
                return;
            }
            if event.kind == PointerEventKind.up {
                if root.pointer-armed {
                    root.submit(root.value-at(self.mouse-x));
                }
                root.pointer-armed = false;
            }
        }
    }
    keyboard := FocusScope {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
        enabled: root.enabled;
        key-pressed(event) => {
            if !self.enabled || root.step <= 0 {
                return reject;
            }
            if event.text == Key.LeftArrow || event.text == Key.RightArrow
                || event.text == Key.Home || event.text == Key.End {
                return accept;
            }
            reject
        }
        key-released(event) => {
            if !self.enabled {
                return reject;
            }
            if event.text == Key.LeftArrow {
                root.submit(root.committed-value - root.step);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.submit(root.committed-value + root.step);
                return accept;
            }
            if event.text == Key.Home {
                root.submit(root.minimum);
                return accept;
            }
            if event.text == Key.End {
                root.submit(root.maximum);
                return accept;
            }
            reject
        }
    }

    pure function value-at(x: length) -> float {
        root.minimum
            + clamp(
                (x - thumb.width / 2) / max(1px, root.width - thumb.width),
                0,
                1,
            ) * (root.maximum - root.minimum)
    }

    public function submit(value: float) {
        root.released(max(root.minimum, min(root.maximum, value)));
    }
}

component MixerChannelRow inherits Rectangle {
    in property <string> name;
    in property <float> gain-percent;
    in property <float> pan-percent;
    in property <bool> muted;
    in property <bool> soloed;
    in property <float> meter-left-level;
    in property <float> meter-right-level;
    in property <string> meter-left-reading;
    in property <string> meter-right-reading;
    in property <bool> controls-enabled;
    in property <bool> solo-available;
    callback mute-requested();
    callback solo-requested();
    callback gain-requested(float);
    callback pan-requested(float);
    min-height: 96px;
    background: #111620;
    border-color: #2c3445;
    border-width: 1px;
    border-radius: 5px;

    VerticalLayout {
        padding: 6px;
        spacing: 5px;
        HorizontalLayout {
            spacing: 7px;
            Text { text: root.name; color: #edf2f8; font-size: 11px; font-weight: 700; overflow: elide; }
            Button {
                text: root.muted ? "Unmute" : "Mute";
                accessible-label: (root.muted ? "Unmute " : "Mute ") + root.name;
                enabled: root.controls-enabled;
                clicked => { root.mute-requested(); }
            }
            Button {
                text: root.soloed ? "Unsolo" : "Solo";
                accessible-label: root.solo-available
                    ? (root.soloed ? "Unsolo " : "Solo ") + root.name
                    : "Solo unavailable for " + root.name;
                enabled: root.controls-enabled && root.solo-available;
                clicked => { root.solo-requested(); }
            }
        }
        HorizontalLayout {
            spacing: 5px;
            Text { text: "POST"; color: #69778c; font-size: 8px; font-weight: 700; width: 27px; vertical-alignment: center; }
            StripPeakBar {
                channel: "L";
                level: root.meter-left-level;
                reading: root.meter-left-reading;
            }
            StripPeakBar {
                channel: "R";
                level: root.meter-right-level;
                reading: root.meter-right-reading;
            }
        }
        HorizontalLayout {
            spacing: 7px;
            Text { text: "GAIN " + Math.round(root.gain-percent) + "%"; color: #8d99ad; font-size: 9px; width: 68px; }
            CommittedSlider {
                minimum: 0;
                maximum: 200;
                committed-value: root.gain-percent;
                enabled: root.controls-enabled;
                control-label: root.name + " live gain";
                released(value) => { root.gain-requested(value); }
            }
            Text { text: "PAN " + Math.round(root.pan-percent); color: #8d99ad; font-size: 9px; width: 58px; }
            CommittedSlider {
                minimum: -100;
                maximum: 100;
                committed-value: root.pan-percent;
                enabled: root.controls-enabled;
                control-label: root.name + " live pan";
                released(value) => { root.pan-requested(value); }
            }
        }
    }
}

component MixerSendRow inherits Rectangle {
    in property <string> source-name;
    in property <string> target-name;
    in property <string> tap;
    in property <float> gain-percent;
    in property <float> pan-percent;
    in property <bool> send-enabled;
    in property <bool> controls-enabled;
    callback toggle-requested();
    callback gain-requested(float);
    callback pan-requested(float);
    min-height: 74px;
    background: #111620;
    border-color: #2c3445;
    border-width: 1px;
    border-radius: 5px;

    VerticalLayout {
        padding: 6px;
        spacing: 5px;
        HorizontalLayout {
            spacing: 7px;
            Text { text: root.source-name + " → " + root.target-name; color: #edf2f8; font-size: 11px; font-weight: 700; overflow: elide; }
            Text { text: root.tap; color: #8d99ad; font-size: 9px; }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            send-toggle := Button {
                text: root.send-enabled ? "Disable" : "Enable";
                accessible-label: self.text + " send " + root.source-name + " to " + root.target-name;
                enabled: root.controls-enabled;
                clicked => { root.toggle-requested(); }
            }
        }
        HorizontalLayout {
            spacing: 7px;
            Text { text: "GAIN " + Math.round(root.gain-percent) + "%"; color: #8d99ad; font-size: 9px; width: 68px; }
            CommittedSlider {
                minimum: 0;
                maximum: 200;
                committed-value: root.gain-percent;
                enabled: root.controls-enabled;
                control-label: root.source-name + " to " + root.target-name + " send gain";
                released(value) => { root.gain-requested(value); }
            }
            Text { text: "PAN " + Math.round(root.pan-percent); color: #8d99ad; font-size: 9px; width: 58px; }
            CommittedSlider {
                minimum: -100;
                maximum: 100;
                committed-value: root.pan-percent;
                enabled: root.controls-enabled;
                control-label: root.source-name + " to " + root.target-name + " send pan";
                released(value) => { root.pan-requested(value); }
            }
        }
    }
}

export component OperatorWindow inherits Window {
    title: "Hyper Runtime";
    width: 880px;
    height: 948px;
    background: #0d1016;
    forward-focus: keyboard;

    property <bool> shortcut-help-visible: false;

    in property <string> project-name;
    in property <string> project-identity;
    in property <string> project-revision;
    in property <string> deployment-generation;
    in property <string> bundle-identity;
    in property <string> recovery-state;
    in property <string> transport-state;
    in property <string> transport-time;
    in property <string> transport-frame;
    in property <string> transport-musical-position;
    in property <float> transport-position-percent: 0;
    in property <string> transport-seek-state: "Seek unavailable";
    in property <bool> transport-seek-enabled: false;
    in property <[OperatorTimelineMarkerRow]> timeline-markers;
    in property <string> timeline-marker-navigation-state: "Waiting for verified output recovery";
    in property <bool> transport-start-enabled: false;
    in property <bool> transport-stop-enabled: false;
    in property <bool> transport-return-to-start-enabled: false;
    in property <string> loop-state;
    in property <string> loop-range;
    in property <string> loop-toggle-label;
    in property <bool> loop-toggle-enabled;
    in property <bool> loop-in-enabled;
    in property <bool> loop-out-enabled;
    in property <bool> loop-clear-enabled;
    in property <string> metronome-state: "Metronome unavailable";
    in property <string> metronome-toggle-label: "Metronome unavailable";
    in property <bool> metronome-toggle-enabled: false;
    in property <float> metronome-gain-percent: 0;
    in property <bool> metronome-gain-enabled: false;
    in property <string> output-route: "System default";
    in property <string> input-route: "Disabled";
    in property <bool> input-monitor-configured: false;
    in property <string> input-monitor-state: "DISABLED";
    in property <string> input-callback-count: "—";
    in property <string> input-captured-frame-count: "—";
    in property <string> input-dropped-frame-count: "—";
    in property <float> input-monitor-gain-percent: 0;
    in property <bool> input-monitor-muted: true;
    in property <bool> input-monitor-controls-enabled: false;
    in property <bool> input-meter-live: false;
    in property <string> input-meter-state: "No input monitoring requested";
    in property <string> input-meter-telemetry: "—";
    in property <float> left-input-level;
    in property <string> left-input-reading: "— dBFS";
    in property <float> right-input-level;
    in property <string> right-input-reading: "— dBFS";
    in property <string> stream-state;
    in property <string> callback-count;
    in property <string> stream-failures;
    in property <string> native-xruns;
    in property <string> panel-state;
    in property <string> control-mapping-state: "Waiting for verified playback owner";
    in property <string> control-mapping-detail: "";
    in property <bool> control-mapping-warning: false;
    in property <float> left-output-level;
    in property <string> left-output-reading;
    in property <string> left-output-peak-reading;
    in property <float> right-output-level;
    in property <string> right-output-reading;
    in property <string> right-output-peak-reading;
    in property <bool> output-overload-latched;
    in property <string> output-meter-state;
    in property <string> output-meter-telemetry;
    in property <string> loudness-state: "UNAVAILABLE";
    in property <string> loudness-momentary: "— LUFS";
    in property <string> loudness-short-term: "— LUFS";
    in property <string> loudness-integrated: "— LUFS";
    in property <string> loudness-range: "— LU";
    in property <string> loudness-maximum-true-peak: "— dBTP";
    in property <string> loudness-programme-time: "00:00:00.000";
    in property <string> loudness-lra-status: "Waiting for final-output evidence";
    in property <bool> loudness-run-enabled: false;
    in property <bool> loudness-standby-enabled: false;
    in property <bool> loudness-reset-enabled: false;
    in-out property <bool> loudness-reset-confirming: false;
    in property <[OperatorSceneRow]> scenes;
    in property <string> scene-feedback;
    in property <bool> scene-selection-enabled: false;
    in property <bool> stop-interactive-scenes-enabled: false;
    in property <string> scene-performance-state: "Waiting for committed Runtime transport recovery";
    in property <bool> scene-performance-start-enabled: false;
    in property <bool> scene-performance-stop-enabled: false;
    in property <[string]> recording-target-names;
    in-out property <int> selected-recording-target-index: -1;
    in property <string> recording-state: "Recording unavailable";
    in property <bool> recording-start-enabled: false;
    in property <bool> recording-stop-enabled: false;
    in property <[string]> automation-target-names;
    in-out property <int> selected-automation-target-index: -1;
    in-out property <string> automation-capture-name: "Runtime automation";
    in property <string> automation-capture-state: "Waiting for committed Runtime transport recovery";
    in property <bool> automation-capture-start-enabled: false;
    in property <bool> automation-capture-stop-enabled: false;
    in property <[OperatorMixerRow]> mixer-channels;
    in property <[OperatorMixerSendRow]> mixer-sends;
    in property <[OperatorNativeDeviceRow]> native-devices;
    in property <[OperatorNativeDeviceChainRow]> native-device-chains;
    in property <string> native-device-state: "No prepared native devices";
    in property <string> native-device-update-state: "Native-device update unavailable";
    in property <bool> native-device-update-export-enabled: false;
    in property <float> main-gain-percent: 0;
    in property <bool> main-muted: false;
    in property <bool> main-mute-enabled: false;
    in property <string> mixer-state: "Mixer state unavailable";
    in property <string> mixer-update-state: "Mixer update unavailable";
    in property <bool> mixer-update-export-enabled: false;
    in property <string> loop-update-state: "Loop update unavailable";
    in property <bool> loop-update-export-enabled: false;
    in property <string> diagnostic;

    callback start-requested();
    callback stop-requested();
    callback toggle-transport-requested();
    callback return-to-start-requested();
    callback locate-percent-requested(float);
    callback locate-timeline-marker-requested(string);
    callback play-timeline-marker-requested(string);
    callback toggle-loop-requested();
    callback set-loop-in-requested();
    callback set-loop-out-requested();
    callback clear-loop-range-requested();
    callback toggle-metronome-requested();
    callback set-metronome-gain-requested(float);
    callback set-input-monitor-gain-requested(float);
    callback toggle-input-monitor-mute-requested();
    callback reset-output-peak-requested();
    callback loudness-run-requested();
    callback loudness-standby-requested();
    callback loudness-reset-requested();
    callback begin-loudness-reset();
    callback cancel-loudness-reset();
    callback confirm-loudness-reset();
    callback toggle-mixer-channel-mute-requested(int);
    callback toggle-mixer-channel-solo-requested(int);
    callback set-mixer-channel-gain-requested(int, float);
    callback set-mixer-channel-pan-requested(int, float);
    callback toggle-mixer-send-requested(int);
    callback toggle-native-device-requested(int);
    callback toggle-native-filter-mode-requested(int);
    callback set-native-filter-cutoff-requested(int, float);
    callback set-native-filter-resonance-requested(int, float);
    callback set-native-compressor-threshold-requested(int, float);
    callback set-native-compressor-ratio-requested(int, float);
    callback set-native-compressor-attack-requested(int, float);
    callback set-native-compressor-release-requested(int, float);
    callback set-native-compressor-makeup-requested(int, float);
    callback export-native-device-update-requested(int);
    callback set-mixer-send-gain-requested(int, float);
    callback set-mixer-send-pan-requested(int, float);
    callback set-main-gain-requested(float);
    callback toggle-main-mute-requested();
    callback export-mixer-update-requested();
    callback export-loop-update-requested();
    callback launch-scene-requested(int);
    callback select-scene-requested(int);
    callback move-scene-selection-requested(int);
    callback launch-selected-scene-requested();
    callback stop-interactive-scenes-requested();
    callback start-scene-performance-capture-requested();
    callback stop-scene-performance-capture-requested();
    callback start-recording-requested(int);
    callback stop-recording-requested();
    callback start-automation-capture-requested(int, string);
    callback stop-automation-capture-requested();
    callback quit-requested();

    begin-loudness-reset => {
        if root.loudness-reset-enabled {
            root.loudness-reset-confirming = true;
        }
    }
    cancel-loudness-reset => {
        root.loudness-reset-confirming = false;
    }
    confirm-loudness-reset => {
        if root.loudness-reset-enabled {
            root.loudness-reset-confirming = false;
            root.loudness-reset-requested();
        }
    }

    keyboard := FocusScope {
        width: parent.width;
        height: parent.height;

        capture-key-pressed(event) => {
            if root.shortcut-help-visible
                && !event.repeat
                && !event.modifiers.control
                && !event.modifiers.shift
                && !event.modifiers.alt
                && !event.modifiers.meta
                && event.text == Key.Escape {
                root.shortcut-help-visible = false;
                keyboard.focus();
                return accept;
            }
            reject
        }

        key-pressed(event) => {
            if root.shortcut-help-visible {
                return accept;
            }
            if event.text == Key.Space {
                if !event.repeat
                    && !event.modifiers.control
                    && !event.modifiers.alt
                    && !event.modifiers.meta {
                    if event.modifiers.shift {
                        if root.stop-interactive-scenes-enabled {
                            root.stop-interactive-scenes-requested();
                        }
                    } else if root.transport-start-enabled || root.transport-stop-enabled {
                        root.toggle-transport-requested();
                    }
                }
                return accept;
            }
            if event.text == Key.Home {
                if !event.repeat
                    && !event.modifiers.control
                    && !event.modifiers.shift
                    && !event.modifiers.alt
                    && !event.modifiers.meta
                    && root.transport-return-to-start-enabled {
                    root.return-to-start-requested();
                }
                return accept;
            }
            if event.text == Key.End {
                if !event.repeat
                    && !event.modifiers.control
                    && !event.modifiers.shift
                    && !event.modifiers.alt
                    && !event.modifiers.meta
                    && root.transport-seek-enabled {
                    root.locate-percent-requested(100);
                }
                return accept;
            }
            if event.modifiers.control
                && !event.modifiers.shift
                && !event.modifiers.alt
                && !event.modifiers.meta
                && !event.repeat
                && (event.text == "r" || event.text == "R") {
                if root.recording-stop-enabled {
                    root.stop-recording-requested();
                } else if root.recording-start-enabled
                    && root.selected-recording-target-index >= 0
                    && root.selected-recording-target-index < root.recording-target-names.length {
                    root.start-recording-requested(root.selected-recording-target-index);
                }
                return accept;
            }
            if !event.modifiers.control
                && !event.modifiers.shift
                && !event.modifiers.alt
                && !event.modifiers.meta
                && !event.repeat
                && (event.text == "l" || event.text == "L") {
                if root.loop-toggle-enabled {
                    root.toggle-loop-requested();
                }
                return accept;
            }
            if !event.modifiers.control
                && !event.modifiers.shift
                && !event.modifiers.alt
                && !event.modifiers.meta
                && !event.repeat
                && event.text == "`" {
                if root.metronome-toggle-enabled {
                    root.toggle-metronome-requested();
                }
                return accept;
            }
            if event.text == Key.UpArrow {
                if !event.modifiers.control
                    && !event.modifiers.shift
                    && !event.modifiers.alt
                    && !event.modifiers.meta
                    && root.scene-selection-enabled {
                    root.move-scene-selection-requested(-1);
                }
                return accept;
            }
            if event.text == Key.DownArrow {
                if !event.modifiers.control
                    && !event.modifiers.shift
                    && !event.modifiers.alt
                    && !event.modifiers.meta
                    && root.scene-selection-enabled {
                    root.move-scene-selection-requested(1);
                }
                return accept;
            }
            if event.text == Key.Return {
                if !event.repeat
                    && !event.modifiers.control
                    && !event.modifiers.shift
                    && !event.modifiers.alt
                    && !event.modifiers.meta
                    && root.scene-selection-enabled {
                    root.launch-selected-scene-requested();
                }
                return accept;
            }
            reject
        }

        ScrollView {
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            VerticalLayout {
            padding: 24px;
            spacing: 18px;

        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                height: 28px;
                Text { text: "HYPER RUNTIME"; color: #6fd6bd; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Button {
                    width: 68px;
                    text: "Keys";
                    accessible-label: "Show Runtime keyboard shortcuts";
                    clicked => {
                        root.shortcut-help-visible = true;
                        shortcut-help-keyboard.focus();
                    }
                }
            }
            Text { text: root.project-name; color: #f7f9fc; font-size: 28px; font-weight: 700; overflow: elide; }
            Text { text: root.project-identity + "  ·  revision " + root.project-revision; color: #8d99ad; font-size: 12px; overflow: elide; }
        }

        HorizontalLayout {
            spacing: 12px;
            FactCard {
                width: 156px;
                label: "TRANSPORT";
                value: root.transport-state + "  ·  " + root.transport-time;
                detail: "BBT " + root.transport-musical-position + "  ·  frame " + root.transport-frame;
            }
            LoopFactCard {
                width: 156px;
                label: "SESSION LOOP";
                value: root.loop-state;
                detail: root.loop-range;
                update-state: root.loop-update-state;
                export-enabled: root.loop-update-export-enabled;
                export-requested => { root.export-loop-update-requested(); }
            }
            FactCard { width: 156px; label: "METRONOME"; value: root.metronome-state; }
            FactCard { width: 156px; label: "AUDIO OWNER"; value: root.stream-state; detail: root.output-route; }
            FactCard { width: 156px; label: "PANEL LINK"; value: root.panel-state; }
        }

        ControlMappingFactCard {
            width: root.width - 48px;
            state: root.control-mapping-state;
            detail: root.control-mapping-detail;
            warning-state: root.control-mapping-warning;
        }

        HorizontalLayout {
            spacing: 10px;
            Text {
                text: root.transport-seek-state;
                color: #8d99ad;
                font-size: 10px;
                vertical-alignment: center;
            }
            CommittedSlider {
                horizontal-stretch: 1;
                minimum: 0;
                maximum: 100;
                step: 0.1;
                committed-value: root.transport-position-percent;
                enabled: root.transport-seek-enabled;
                control-label: "Committed transport position percent";
                released(value) => { root.locate-percent-requested(value); }
            }
        }

        if root.timeline-markers.length > 0 : Rectangle {
            width: root.width - 48px;
            background: #171b24;
            border-color: #2c3445;
            border-width: 1px;
            border-radius: 8px;
            min-height: 150px;
            VerticalLayout {
                padding: 12px;
                spacing: 6px;
                Text { text: "TIMELINE MARKERS"; color: #8d99ad; font-size: 11px; font-weight: 700; }
                Text { text: root.timeline-marker-navigation-state; color: #8d99ad; font-size: 10px; overflow: elide; }
                ListView {
                    height: 84px;
                    for marker in root.timeline-markers : Rectangle {
                        min-height: 28px;
                        background: transparent;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: marker.name; color: #edf2f8; font-size: 11px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                            Text { text: "BBT " + marker.musical-position + " · tick " + marker.tick; color: #8d99ad; font-size: 10px; width: 150px; overflow: elide; vertical-alignment: center; }
                            Button {
                                width: 72px;
                                text: marker.available ? "Locate" : "Unavailable";
                                accessible-label: marker.available ? "Locate " + marker.name + " at " + marker.musical-position : marker.name + " is unavailable";
                                enabled: marker.controls-enabled;
                                clicked => { root.locate-timeline-marker-requested(marker.id); }
                            }
                            if marker.available : Button {
                                width: 56px;
                                text: "Play";
                                accessible-label: "Play from " + marker.name + " at " + marker.musical-position;
                                enabled: marker.controls-enabled;
                                clicked => { root.play-timeline-marker-requested(marker.id); }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            Button {
                text: "Start";
                enabled: root.transport-start-enabled;
                clicked => { root.start-requested(); }
            }
            Button {
                text: "Stop";
                enabled: root.transport-stop-enabled;
                clicked => { root.stop-requested(); }
            }
            Button {
                text: "Return to start";
                enabled: root.transport-return-to-start-enabled;
                clicked => { root.return-to-start-requested(); }
            }
            Button {
                text: root.loop-toggle-label;
                enabled: root.loop-toggle-enabled;
                clicked => { root.toggle-loop-requested(); }
            }
            Button { text: "Loop In"; enabled: root.loop-in-enabled; clicked => { root.set-loop-in-requested(); } }
            Button { text: "Loop Out"; enabled: root.loop-out-enabled; clicked => { root.set-loop-out-requested(); } }
            Button { text: "Clear loop"; enabled: root.loop-clear-enabled; clicked => { root.clear-loop-range-requested(); } }
            Button {
                text: root.metronome-toggle-label;
                enabled: root.metronome-toggle-enabled;
                accessible-label: root.metronome-toggle-label;
                clicked => { root.toggle-metronome-requested(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "Shut down";
                accessible-label: "Shut down Runtime";
                clicked => { root.quit-requested(); }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            Text {
                text: "METRONOME LEVEL " + Math.round(root.metronome-gain-percent) + "%";
                color: #8d99ad;
                font-size: 10px;
                vertical-alignment: center;
            }
            CommittedSlider {
                horizontal-stretch: 1;
                minimum: 0;
                maximum: 100;
                step: 0.1;
                committed-value: root.metronome-gain-percent;
                enabled: root.metronome-gain-enabled;
                control-label: "Committed session metronome click level";
                released(value) => { root.set-metronome-gain-requested(value); }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            FactCard { label: "DEPLOYMENT"; value: "generation " + root.deployment-generation; }
            FactCard { label: "CALLBACKS"; value: root.callback-count; }
            FactCard { label: "STREAM FAILURES / XRUNS"; value: root.stream-failures + " / " + root.native-xruns; }
        }

        Rectangle {
            background: #171b24;
            border-color: #2c3445;
            border-width: 1px;
            border-radius: 8px;
            min-height: 104px;
            VerticalLayout {
                padding: 12px;
                spacing: 7px;
                HorizontalLayout {
                    Text { text: "RUNTIME AUDIO RECORDING · EXTERNAL HANDOFF"; color: #8d99ad; font-size: 11px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: root.recording-state; color: #8d99ad; font-size: 10px; overflow: elide; width: 300px; vertical-alignment: center; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "TRACK"; color: #69778c; font-size: 9px; font-weight: 700; width: 48px; vertical-alignment: center; }
                    ComboBox {
                        horizontal-stretch: 1;
                        model: root.recording-target-names;
                        current-index <=> root.selected-recording-target-index;
                        enabled: root.recording-start-enabled && root.recording-target-names.length > 0;
                        accessible-label: "Runtime audio recording target";
                    }
                    Text {
                        text: "Records the selected monitored input to an external WAV. The verified project is never changed by Runtime.";
                        color: #69778c;
                        font-size: 9px;
                        overflow: elide;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Button {
                        text: "Record";
                        enabled: root.recording-start-enabled;
                        accessible-label: "Start Runtime audio recording";
                        clicked => { root.start-recording-requested(root.selected-recording-target-index); }
                    }
                    Button {
                        text: "Stop recording";
                        enabled: root.recording-stop-enabled;
                        accessible-label: "Stop and publish Runtime audio recording";
                        clicked => { root.stop-recording-requested(); }
                    }
                }
            }
        }

        Rectangle {
            background: #171b24;
            border-color: #2c3445;
            border-width: 1px;
            border-radius: 8px;
            min-height: 124px;
            VerticalLayout {
                padding: 12px;
                spacing: 6px;
                HorizontalLayout {
                    Text { text: "FINAL OUTPUT · SAMPLE PEAK"; color: #8d99ad; font-size: 11px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: root.output-meter-state; color: #8d99ad; font-size: 11px; overflow: elide; }
                    Rectangle {
                        width: 104px;
                        background: root.output-overload-latched ? #7f2428 : #202836;
                        border-radius: 4px;
                        Text {
                            text: root.output-overload-latched ? "OVERLOAD" : "PEAK CLEAR";
                            color: root.output-overload-latched ? #fff1f1 : #8d99ad;
                            font-size: 10px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Button { text: "Reset peak"; clicked => { root.reset-output-peak-requested(); } }
                }
                OutputMeterBar {
                    channel: "L";
                    level: root.left-output-level;
                    reading: root.left-output-reading;
                    peak-reading: root.left-output-peak-reading;
                }
                OutputMeterBar {
                    channel: "R";
                    level: root.right-output-level;
                    reading: root.right-output-reading;
                    peak-reading: root.right-output-peak-reading;
                }
                Text { text: root.output-meter-telemetry; color: #69778c; font-size: 10px; overflow: elide; }
            }
        }

        Rectangle {
            background: #171b24;
            border-color: #2c3445;
            border-width: 1px;
            border-radius: 8px;
            min-height: root.input-monitor-configured ? 340px : 94px;
            VerticalLayout {
                padding: 12px;
                spacing: 7px;
                HorizontalLayout {
                    Text { text: "INPUT MONITOR · LIVE ONLY"; color: #8d99ad; font-size: 11px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text {
                        text: root.input-monitor-state;
                        color: root.input-monitor-state == "RUNNING" ? #49a6ff : root.input-monitor-state == "FAILED" ? #ff5a55 : #8d99ad;
                        font-size: 10px;
                        font-weight: 700;
                    }
                }
                Text {
                    text: "ROUTE · " + root.input-route;
                    color: #dce5ef;
                    font-size: 11px;
                    overflow: elide;
                }
                if !root.input-monitor-configured : Text {
                    text: "No desktop input was requested for this Runtime launch.";
                    color: #69778c;
                    font-size: 10px;
                    overflow: elide;
                }
                if root.input-monitor-configured : VerticalLayout {
                    spacing: 7px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: root.input-monitor-muted ? "MONITOR MUTED" : "MONITOR LIVE";
                            color: root.input-monitor-muted ? #f5b83d : #3ddc97;
                            font-size: 10px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Button {
                            text: root.input-monitor-muted ? "Unmute monitor" : "Mute monitor";
                            enabled: root.input-monitor-controls-enabled;
                            accessible-label: root.input-monitor-muted ? "Unmute the live input monitor" : "Mute the live input monitor";
                            clicked => { root.toggle-input-monitor-mute-requested(); }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Text {
                            text: "LEVEL " + Math.round(root.input-monitor-gain-percent) + "%";
                            color: #8d99ad;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }
                    CommittedSlider {
                        minimum: 0;
                        maximum: 100;
                        step: 0.1;
                        committed-value: root.input-monitor-gain-percent;
                        enabled: root.input-monitor-controls-enabled;
                        control-label: "Accepted live input monitor gain";
                        released(value) => { root.set-input-monitor-gain-requested(value); }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        FactCard { label: "CAPTURE CALLBACKS"; value: root.input-callback-count; }
                        FactCard { label: "ACCEPTED FRAMES"; value: root.input-captured-frame-count; }
                        FactCard { label: "DROPPED FRAMES"; value: root.input-dropped-frame-count; }
                    }
                    if root.input-meter-live : VerticalLayout {
                        spacing: 5px;
                        Text {
                            text: "RAW ACCEPTED INPUT · PRE-CUE · NOT AUDIBILITY";
                            color: #8d99ad;
                            font-size: 10px;
                            font-weight: 700;
                        }
                        InputMeterBar {
                            channel: "L";
                            level: root.left-input-level;
                            reading: root.left-input-reading;
                        }
                        InputMeterBar {
                            channel: "R";
                            level: root.right-input-level;
                            reading: root.right-input-reading;
                        }
                        Text { text: root.input-meter-telemetry; color: #69778c; font-size: 10px; overflow: elide; }
                    }
                    if !root.input-meter-live : Text {
                        text: root.input-meter-state;
                        color: #69778c;
                        font-size: 10px;
                        overflow: elide;
                    }
                }
            }
        }

        Rectangle {
            background: #171b24;
            border-color: #2c3445;
            border-width: 1px;
            border-radius: 8px;
            min-height: 124px;
            VerticalLayout {
                padding: 12px;
                spacing: 7px;
                HorizontalLayout {
                    Text { text: "PROGRAMME LOUDNESS · EBU +9"; color: #8d99ad; font-size: 11px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: root.loudness-state; color: root.loudness-state == "RUNNING" ? #3ddc97 : root.loudness-state == "STANDBY" ? #f5b83d : #8d99ad; font-size: 10px; font-weight: 700; }
                    if !root.loudness-reset-confirming : HorizontalLayout {
                        spacing: 5px;
                        Button { text: "Run"; enabled: root.loudness-run-enabled; clicked => { root.loudness-run-requested(); } }
                        Button { text: "Standby"; enabled: root.loudness-standby-enabled; clicked => { root.loudness-standby-requested(); } }
                        Button { text: "Reset programme"; enabled: root.loudness-reset-enabled; clicked => { root.begin-loudness-reset(); } }
                    }
                    if root.loudness-reset-confirming : HorizontalLayout {
                        spacing: 5px;
                        Text { text: "Clear programme history?"; color: #f5b83d; font-size: 10px; vertical-alignment: center; }
                        Button { text: "Cancel"; clicked => { root.cancel-loudness-reset(); } }
                        Button { text: "Confirm reset"; enabled: root.loudness-reset-enabled; clicked => { root.confirm-loudness-reset(); } }
                    }
                }
                HorizontalLayout {
                    spacing: 7px;
                    LoudnessValue { label: "M · 400 MS"; value: root.loudness-momentary; }
                    LoudnessValue { label: "S · 3 S"; value: root.loudness-short-term; }
                    LoudnessValue { label: "I · GATED"; value: root.loudness-integrated; }
                    LoudnessValue { label: "LOUDNESS RANGE"; value: root.loudness-range; }
                    LoudnessValue { label: "MAX TRUE PEAK"; value: root.loudness-maximum-true-peak; }
                }
                Text { text: "Programme " + root.loudness-programme-time + " · " + root.loudness-lra-status; color: #69778c; font-size: 10px; overflow: elide; }
            }
        }

        Rectangle {
            background: #171b24;
            border-color: #2c3445;
            border-width: 1px;
            border-radius: 8px;
            min-height: 278px;
            VerticalLayout {
                padding: 12px;
                spacing: 7px;
                HorizontalLayout {
                    Text { text: "LIVE MIXER · POST-FADER PEAK"; color: #8d99ad; font-size: 11px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: root.mixer-state; color: #8d99ad; font-size: 10px; overflow: elide; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.mixer-update-state;
                        color: #8d99ad;
                        font-size: 10px;
                        overflow: elide;
                        width: 180px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: "MAIN " + Math.round(root.main-gain-percent) + "%"; color: #8d99ad; font-size: 9px; }
                    CommittedSlider {
                        width: 128px;
                        minimum: 0;
                        maximum: 200;
                        committed-value: root.main-gain-percent;
                        enabled: root.main-mute-enabled;
                        control-label: "Main live gain";
                        released(value) => { root.set-main-gain-requested(value); }
                    }
                    Button {
                        text: root.main-muted ? "Unmute main" : "Mute main";
                        accessible-label: self.text;
                        enabled: root.main-mute-enabled;
                        clicked => { root.toggle-main-mute-requested(); }
                    }
                    Button {
                        text: "Export mixer update";
                        accessible-label: "Export the committed mixer state as an external update";
                        enabled: root.mixer-update-export-enabled;
                        clicked => { root.export-mixer-update-requested(); }
                    }
                }
                ListView {
                    height: 192px;
                    for channel[index] in root.mixer-channels : MixerChannelRow {
                        name: (index + 1) + " · " + channel.name;
                        gain-percent: channel.gain-percent;
                        pan-percent: channel.pan-percent;
                        muted: channel.muted;
                        soloed: channel.soloed;
                        meter-left-level: channel.meter-left-level;
                        meter-right-level: channel.meter-right-level;
                        meter-left-reading: channel.meter-left-reading;
                        meter-right-reading: channel.meter-right-reading;
                        controls-enabled: channel.controls-enabled;
                        solo-available: channel.solo-available;
                        mute-requested => { root.toggle-mixer-channel-mute-requested(index); }
                        solo-requested => { root.toggle-mixer-channel-solo-requested(index); }
                        gain-requested(value) => { root.set-mixer-channel-gain-requested(index, value); }
                        pan-requested(value) => { root.set-mixer-channel-pan-requested(index, value); }
                    }
                }
            }
        }


        if root.mixer-sends.length > 0 : Rectangle {
            background: #171b24;
            border-color: #2c3445;
            border-width: 1px;
            border-radius: 8px;
            min-height: 196px;
            VerticalLayout {
                padding: 12px;
                spacing: 7px;
                Text { text: "LIVE SENDS · SESSION ONLY"; color: #8d99ad; font-size: 11px; font-weight: 700; }
                ListView {
                    height: 160px;
                    for send[index] in root.mixer-sends : MixerSendRow {
                        source-name: (index + 1) + " · " + send.source-name;
                        target-name: send.target-name;
                        tap: send.tap;
                        gain-percent: send.gain-percent;
                        pan-percent: send.pan-percent;
                        send-enabled: send.enabled;
                        controls-enabled: send.controls-enabled;
                        toggle-requested => { root.toggle-mixer-send-requested(index); }
                        gain-requested(value) => { root.set-mixer-send-gain-requested(index, value); }
                        pan-requested(value) => { root.set-mixer-send-pan-requested(index, value); }
                    }
                }
            }
        }

        if root.native-devices.length > 0 : Rectangle {
            background: #171b24;
            border-color: #2c3445;
            border-width: 1px;
            border-radius: 8px;
            min-height: 266px;
            VerticalLayout {
                padding: 12px;
                spacing: 7px;
                HorizontalLayout {
                    Text { text: "NATIVE DEVICES · SESSION ONLY"; color: #8d99ad; font-size: 11px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: root.native-device-state; color: #8d99ad; font-size: 10px; overflow: elide; }
                }
                ListView {
                    height: 224px;
                    for device[index] in root.native-devices : Rectangle {
                        min-height: device.kind-index == 0 ? 82px : 112px;
                        background: transparent;
                        VerticalLayout {
                            spacing: 5px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: device.track-name + " · " + device.kind; color: #edf2f8; font-size: 11px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                Button {
                                    text: device.enabled ? "Bypass" : "Enable";
                                    accessible-label: self.text + " " + device.track-name + " " + device.kind;
                                    enabled: device.controls-enabled;
                                    clicked => { root.toggle-native-device-requested(index); }
                                }
                            }
                            if device.kind-index == 0 : HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: device.filter-mode-index == 0 ? "Low-pass" : "High-pass";
                                    accessible-label: "Toggle " + device.track-name + " filter mode";
                                    enabled: device.controls-enabled;
                                    clicked => { root.toggle-native-filter-mode-requested(index); }
                                }
                                Text { text: "CUTOFF " + Math.round(device.filter-cutoff-hz) + " Hz"; color: #8d99ad; font-size: 9px; vertical-alignment: center; }
                                CommittedSlider {
                                    width: 150px;
                                    minimum: 20;
                                    maximum: 20000;
                                    step: 1;
                                    committed-value: device.filter-cutoff-hz;
                                    enabled: device.controls-enabled;
                                    control-label: device.track-name + " filter cutoff hertz";
                                    released(value) => { root.set-native-filter-cutoff-requested(index, value); }
                                }
                                Text { text: "Q " + Math.round(device.filter-resonance * 100) / 100; color: #8d99ad; font-size: 9px; vertical-alignment: center; }
                                CommittedSlider {
                                    width: 110px;
                                    minimum: 0.1;
                                    maximum: 20;
                                    step: 0.01;
                                    committed-value: device.filter-resonance;
                                    enabled: device.controls-enabled;
                                    control-label: device.track-name + " filter resonance";
                                    released(value) => { root.set-native-filter-resonance-requested(index, value); }
                                }
                            }
                            if device.kind-index == 1 : VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "THRESHOLD " + Math.round(device.compressor-threshold-decibels) + " dB"; color: #8d99ad; font-size: 9px; width: 110px; vertical-alignment: center; }
                                    CommittedSlider { horizontal-stretch: 1; minimum: -80; maximum: 0; step: 0.1; committed-value: device.compressor-threshold-decibels; enabled: device.controls-enabled; control-label: device.track-name + " compressor threshold decibels"; released(value) => { root.set-native-compressor-threshold-requested(index, value); } }
                                    Text { text: "RATIO " + Math.round(device.compressor-ratio * 100) / 100 + ":1"; color: #8d99ad; font-size: 9px; width: 88px; vertical-alignment: center; }
                                    CommittedSlider { width: 110px; minimum: 1; maximum: 100; step: 0.01; committed-value: device.compressor-ratio; enabled: device.controls-enabled; control-label: device.track-name + " compressor ratio"; released(value) => { root.set-native-compressor-ratio-requested(index, value); } }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "ATTACK " + Math.round(device.compressor-attack-milliseconds * 10) / 10 + " ms"; color: #8d99ad; font-size: 9px; width: 110px; vertical-alignment: center; }
                                    CommittedSlider { horizontal-stretch: 1; minimum: 0.1; maximum: 500; step: 0.1; committed-value: device.compressor-attack-milliseconds; enabled: device.controls-enabled; control-label: device.track-name + " compressor attack milliseconds"; released(value) => { root.set-native-compressor-attack-requested(index, value); } }
                                    Text { text: "RELEASE " + Math.round(device.compressor-release-milliseconds * 10) / 10 + " ms"; color: #8d99ad; font-size: 9px; width: 88px; vertical-alignment: center; }
                                    CommittedSlider { width: 110px; minimum: 0.1; maximum: 2000; step: 0.1; committed-value: device.compressor-release-milliseconds; enabled: device.controls-enabled; control-label: device.track-name + " compressor release milliseconds"; released(value) => { root.set-native-compressor-release-requested(index, value); } }
                                    Text { text: "MAKEUP " + Math.round(device.compressor-makeup-decibels * 10) / 10 + " dB"; color: #8d99ad; font-size: 9px; width: 94px; vertical-alignment: center; }
                                    CommittedSlider { width: 110px; minimum: -24; maximum: 24; step: 0.1; committed-value: device.compressor-makeup-decibels; enabled: device.controls-enabled; control-label: device.track-name + " compressor makeup decibels"; released(value) => { root.set-native-compressor-makeup-requested(index, value); } }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.native-device-chains.length > 0 : Rectangle {
            background: #171b24;
            border-color: #2c3445;
            border-width: 1px;
            border-radius: 8px;
            min-height: 118px;
            VerticalLayout {
                padding: 12px;
                spacing: 7px;
                HorizontalLayout {
                    Text { text: "NATIVE-DEVICE UPDATE · COMMITTED STATE"; color: #8d99ad; font-size: 11px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: root.native-device-update-state; color: #8d99ad; font-size: 10px; overflow: elide; }
                }
                ListView {
                    height: 72px;
                    for chain[index] in root.native-device-chains : Rectangle {
                        min-height: 32px;
                        background: transparent;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: chain.track-label;
                                color: #edf2f8;
                                font-size: 11px;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Text {
                                text: chain.device-count + " device" + (chain.device-count == 1 ? "" : "s");
                                color: #8d99ad;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                            Button {
                                text: "Export update";
                                accessible-label: "Export committed native-device state for " + chain.track-label;
                                enabled: root.native-device-update-export-enabled;
                                clicked => { root.export-native-device-update-requested(index); }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            background: #171b24;
            border-color: #2c3445;
            border-width: 1px;
            border-radius: 8px;
            min-height: 136px;
            VerticalLayout {
                padding: 12px;
                spacing: 7px;
                HorizontalLayout {
                    Text { text: "RUNTIME AUTOMATION TAKE · EXTERNAL HANDOFF"; color: #8d99ad; font-size: 11px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: root.automation-capture-state; color: #8d99ad; font-size: 10px; overflow: elide; width: 240px; vertical-alignment: center; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "TARGET"; color: #69778c; font-size: 9px; font-weight: 700; width: 48px; vertical-alignment: center; }
                    ComboBox {
                        horizontal-stretch: 1;
                        model: root.automation-target-names;
                        current-index <=> root.selected-automation-target-index;
                        enabled: root.automation-capture-start-enabled && root.automation-target-names.length > 0;
                        accessible-label: "Runtime automation capture target";
                    }
                    Text { text: "TAKE"; color: #69778c; font-size: 9px; font-weight: 700; width: 36px; vertical-alignment: center; }
                    LineEdit {
                        width: 180px;
                        text <=> root.automation-capture-name;
                        placeholder-text: "Runtime automation";
                        enabled: root.automation-capture-start-enabled;
                        accessible-label: "Runtime automation take name";
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Captures committed mixer changes only. The loaded project is not changed until the IDE verifies and imports the update.";
                        color: #69778c;
                        font-size: 9px;
                        overflow: elide;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Button {
                        text: "Start capture";
                        enabled: root.automation-capture-start-enabled;
                        accessible-label: "Start Runtime automation capture";
                        clicked => { root.start-automation-capture-requested(root.selected-automation-target-index, root.automation-capture-name); }
                    }
                    Button {
                        text: "Stop capture";
                        enabled: root.automation-capture-stop-enabled;
                        accessible-label: "Stop Runtime automation capture at the next committed transport boundary";
                        clicked => { root.stop-automation-capture-requested(); }
                    }
                }
            }
        }

        if root.scenes.length > 0 : Rectangle {
            background: #171b24;
            border-color: #2c3445;
            border-width: 1px;
            border-radius: 8px;
            min-height: 90px;
            VerticalLayout {
                padding: 12px;
                spacing: 7px;
                HorizontalLayout {
                    Text { text: "SCENES"; color: #8d99ad; font-size: 11px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: root.scene-feedback; color: #8d99ad; font-size: 10px; overflow: elide; }
                    Button {
                        text: "Stop interactive scenes";
                        enabled: root.stop-interactive-scenes-enabled;
                        clicked => { root.stop-interactive-scenes-requested(); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.scene-performance-state;
                        color: #8d99ad;
                        font-size: 10px;
                        overflow: elide;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Button {
                        text: "Capture performance";
                        enabled: root.scene-performance-start-enabled;
                        accessible-label: "Capture committed grid scene performance";
                        clicked => { root.start-scene-performance-capture-requested(); }
                    }
                    Button {
                        text: "Stop capture";
                        enabled: root.scene-performance-stop-enabled;
                        accessible-label: "Stop scene performance capture at the next committed transport boundary";
                        clicked => { root.stop-scene-performance-capture-requested(); }
                    }
                }
                HorizontalLayout {
                    spacing: 7px;
                    for scene[index] in root.scenes : SceneLaunchTile {
                        name: (index + 1) + " · " + scene.name;
                        status: scene.status;
                        available: scene.available;
                        controls-enabled: scene.controls-enabled;
                        selected: scene.selected;
                        queued: scene.queued;
                        last-launched: scene.last-launched;
                        selected-requested => { root.select-scene-requested(index); }
                        launch-requested => { root.launch-scene-requested(index); }
                    }
                }
            }
        }

        Rectangle {
            background: #111620;
            border-color: #2c3445;
            border-width: 1px;
            border-radius: 8px;
            min-height: 92px;
            VerticalLayout {
                padding: 12px;
                spacing: 5px;
                Text { text: "VERIFIED BUNDLE"; color: #8d99ad; font-size: 11px; }
                Text { text: root.bundle-identity; color: #dce4ef; font-family: "monospace"; font-size: 12px; overflow: elide; }
                Text { text: root.recovery-state; color: #8d99ad; font-size: 12px; }
            }
        }

        Rectangle {
            background: #171b24;
            border-radius: 8px;
            min-height: 54px;
            Text {
                x: 12px; width: parent.width - 24px;
                vertical-alignment: center;
                text: root.diagnostic;
                color: #c8d1df;
                overflow: elide;
            }
        }

        }
        }

        shortcut-help-layer := Rectangle {
            visible: root.shortcut-help-visible;
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: #05080ddd;

            TouchArea {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                clicked => {
                    root.shortcut-help-visible = false;
                    keyboard.focus();
                }
            }

            Rectangle {
                width: 620px;
                height: 506px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: #151a24;
                border-color: #405066;
                border-width: 1px;
                border-radius: 10px;

                TouchArea { width: parent.width; height: parent.height; }

                shortcut-help-keyboard := FocusScope {
                    width: parent.width;
                    height: parent.height;

                    key-pressed(event) => { accept }

                    VerticalLayout {
                        padding: 24px;
                        spacing: 14px;

                        HorizontalLayout {
                            height: 34px;
                            VerticalLayout {
                                Text { text: "KEYBOARD SHORTCUTS"; color: #f7f9fc; font-size: 18px; font-weight: 700; }
                                Text { text: "Fixed exact chords · actions remain available only when their controls are enabled"; color: #8d99ad; font-size: 10px; }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Close";
                                accessible-label: "Close Runtime keyboard shortcuts";
                                clicked => {
                                    root.shortcut-help-visible = false;
                                    keyboard.focus();
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #2c3445; }

                        VerticalLayout {
                            spacing: 7px;
                            Text { text: "TRANSPORT · SCENES"; color: #8d99ad; font-size: 9px; font-weight: 700; letter-spacing: 1px; }
                            ShortcutReferenceRow { chord: "Space"; action: "Start or stop transport"; }
                            ShortcutReferenceRow { chord: "Home"; action: "Return transport to start"; }
                            ShortcutReferenceRow { chord: "End"; action: "Seek exact playback end"; }
                            ShortcutReferenceRow { chord: "Ctrl+R"; action: "Start or stop recording"; }
                            ShortcutReferenceRow { chord: "L"; action: "Enable or disable the armed loop"; }
                            ShortcutReferenceRow { chord: "Grave"; action: "Enable or disable the session metronome"; }
                            ShortcutReferenceRow { chord: "Up / Down"; action: "Select previous or next ready scene"; }
                            ShortcutReferenceRow { chord: "Return"; action: "Launch selected ready scene"; }
                            ShortcutReferenceRow { chord: "Shift+Space"; action: "Stop interactive scenes"; }
                        }

                        Text {
                            text: "Focused sliders keep arrows, Home, and End. Shortcuts never bypass unavailable or pending actions.";
                            color: #8d99ad;
                            font-size: 10px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
