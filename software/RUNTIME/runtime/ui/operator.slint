import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";

export struct OperatorSceneRow {
    name: string,
    status: string,
    available: bool,
    queued: bool,
    last-launched: bool,
}

component FactCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> detail;
    background: #171b24;
    border-color: #2c3445;
    border-width: 1px;
    border-radius: 8px;
    min-height: 72px;

    VerticalLayout {
        padding: 12px;
        spacing: 5px;
        Text { text: root.label; color: #8d99ad; font-size: 11px; }
        Text { text: root.value; color: #edf2f8; font-size: 15px; overflow: elide; }
        if root.detail != "" : Text { text: root.detail; color: #8d99ad; font-size: 11px; overflow: elide; }
    }
}

component OutputMeterBar inherits Rectangle {
    in property <string> channel;
    in property <float> level;
    in property <string> reading;
    in property <string> peak-reading;
    background: #0c1118;
    border-radius: 5px;
    min-height: 30px;

    HorizontalLayout {
        padding: 7px;
        spacing: 10px;
        Text { text: root.channel; color: #8d99ad; font-size: 10px; font-weight: 700; width: 16px; }
        Rectangle {
            background: #202836;
            border-radius: 3px;
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width * root.level;
                height: parent.height;
                border-radius: 3px;
                background: root.level >= 1 ? #ff5a55 : root.level > 0.76 ? #f5b83d : #3ddc97;
            }
        }
        Text { text: root.reading; color: #edf2f8; font-size: 11px; width: 76px; horizontal-alignment: right; }
        Text { text: root.peak-reading; color: #8d99ad; font-size: 10px; width: 84px; horizontal-alignment: right; }
    }
}

component SceneLaunchTile inherits Rectangle {
    in property <string> name;
    in property <string> status;
    in property <bool> available;
    in property <bool> queued;
    in property <bool> last-launched;
    callback launch-requested();
    width: 94px;
    min-height: 62px;
    background: root.queued ? #44306f : root.last-launched ? #174c42 : root.available ? #202836 : #141923;
    border-color: root.queued ? #a88cff : root.last-launched ? #3ddc97 : #2c3445;
    border-width: 1px;
    border-radius: 5px;
    opacity: root.available ? 1 : 0.72;

    VerticalLayout {
        padding: 7px;
        spacing: 4px;
        Text { text: root.name; color: #edf2f8; font-size: 11px; font-weight: 700; overflow: elide; }
        Text { text: root.status; color: #8d99ad; font-size: 9px; overflow: elide; }
    }
    TouchArea {
        enabled: root.available;
        clicked => { root.launch-requested(); }
    }
}

export component OperatorWindow inherits Window {
    title: "Hyper Runtime";
    width: 880px;
    height: 806px;
    background: #0d1016;

    in property <string> project-name;
    in property <string> project-identity;
    in property <string> project-revision;
    in property <string> deployment-generation;
    in property <string> bundle-identity;
    in property <string> recovery-state;
    in property <string> transport-state;
    in property <string> transport-time;
    in property <string> transport-frame;
    in property <string> loop-state;
    in property <string> loop-range;
    in property <string> loop-toggle-label;
    in property <bool> loop-toggle-enabled;
    in property <string> stream-state;
    in property <string> callback-count;
    in property <string> stream-failures;
    in property <string> native-xruns;
    in property <string> panel-state;
    in property <float> left-output-level;
    in property <string> left-output-reading;
    in property <string> left-output-peak-reading;
    in property <float> right-output-level;
    in property <string> right-output-reading;
    in property <string> right-output-peak-reading;
    in property <bool> output-overload-latched;
    in property <string> output-meter-state;
    in property <string> output-meter-telemetry;
    in property <[OperatorSceneRow]> scenes;
    in property <string> scene-feedback;
    in property <string> diagnostic;

    callback start-requested();
    callback stop-requested();
    callback return-to-start-requested();
    callback toggle-loop-requested();
    callback reset-output-peak-requested();
    callback launch-scene-requested(int);
    callback quit-requested();

    VerticalLayout {
        padding: 24px;
        spacing: 18px;

        VerticalLayout {
            spacing: 4px;
            Text { text: "HYPER RUNTIME"; color: #6fd6bd; font-size: 13px; font-weight: 700; }
            Text { text: root.project-name; color: #f7f9fc; font-size: 28px; font-weight: 700; overflow: elide; }
            Text { text: root.project-identity + "  ·  revision " + root.project-revision; color: #8d99ad; font-size: 12px; overflow: elide; }
        }

        HorizontalLayout {
            spacing: 12px;
            FactCard {
                label: "TRANSPORT";
                value: root.transport-state + "  ·  " + root.transport-time;
                detail: "frame " + root.transport-frame;
            }
            FactCard { label: "PROJECT LOOP"; value: root.loop-state; detail: root.loop-range; }
            FactCard { label: "AUDIO OWNER"; value: root.stream-state; }
            FactCard { label: "PANEL LINK"; value: root.panel-state; }
        }

        HorizontalLayout {
            spacing: 12px;
            FactCard { label: "DEPLOYMENT"; value: "generation " + root.deployment-generation; }
            FactCard { label: "CALLBACKS"; value: root.callback-count; }
            FactCard { label: "STREAM FAILURES / XRUNS"; value: root.stream-failures + " / " + root.native-xruns; }
        }

        Rectangle {
            background: #171b24;
            border-color: #2c3445;
            border-width: 1px;
            border-radius: 8px;
            min-height: 124px;
            VerticalLayout {
                padding: 12px;
                spacing: 6px;
                HorizontalLayout {
                    Text { text: "FINAL OUTPUT · SAMPLE PEAK"; color: #8d99ad; font-size: 11px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: root.output-meter-state; color: #8d99ad; font-size: 11px; overflow: elide; }
                    Rectangle {
                        width: 104px;
                        background: root.output-overload-latched ? #7f2428 : #202836;
                        border-radius: 4px;
                        Text {
                            text: root.output-overload-latched ? "OVERLOAD" : "PEAK CLEAR";
                            color: root.output-overload-latched ? #fff1f1 : #8d99ad;
                            font-size: 10px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Button { text: "Reset peak"; clicked => { root.reset-output-peak-requested(); } }
                }
                OutputMeterBar {
                    channel: "L";
                    level: root.left-output-level;
                    reading: root.left-output-reading;
                    peak-reading: root.left-output-peak-reading;
                }
                OutputMeterBar {
                    channel: "R";
                    level: root.right-output-level;
                    reading: root.right-output-reading;
                    peak-reading: root.right-output-peak-reading;
                }
                Text { text: root.output-meter-telemetry; color: #69778c; font-size: 10px; overflow: elide; }
            }
        }

        if root.scenes.length > 0 : Rectangle {
            background: #171b24;
            border-color: #2c3445;
            border-width: 1px;
            border-radius: 8px;
            min-height: 90px;
            VerticalLayout {
                padding: 12px;
                spacing: 7px;
                HorizontalLayout {
                    Text { text: "SCENES"; color: #8d99ad; font-size: 11px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: root.scene-feedback; color: #8d99ad; font-size: 10px; overflow: elide; }
                }
                HorizontalLayout {
                    spacing: 7px;
                    for scene[index] in root.scenes : SceneLaunchTile {
                        name: (index + 1) + " · " + scene.name;
                        status: scene.status;
                        available: scene.available;
                        queued: scene.queued;
                        last-launched: scene.last-launched;
                        launch-requested => { root.launch-scene-requested(index); }
                    }
                }
            }
        }

        Rectangle {
            background: #111620;
            border-color: #2c3445;
            border-width: 1px;
            border-radius: 8px;
            min-height: 92px;
            VerticalLayout {
                padding: 12px;
                spacing: 5px;
                Text { text: "VERIFIED BUNDLE"; color: #8d99ad; font-size: 11px; }
                Text { text: root.bundle-identity; color: #dce4ef; font-family: "monospace"; font-size: 12px; overflow: elide; }
                Text { text: root.recovery-state; color: #8d99ad; font-size: 12px; }
            }
        }

        Rectangle {
            background: #171b24;
            border-radius: 8px;
            min-height: 54px;
            Text {
                x: 12px; width: parent.width - 24px;
                vertical-alignment: center;
                text: root.diagnostic;
                color: #c8d1df;
                overflow: elide;
            }
        }

        HorizontalLayout {
            spacing: 10px;
            Button { text: "Start"; clicked => { root.start-requested(); } }
            Button { text: "Stop"; clicked => { root.stop-requested(); } }
            Button { text: "Return to start"; clicked => { root.return-to-start-requested(); } }
            Button {
                text: root.loop-toggle-label;
                enabled: root.loop-toggle-enabled;
                clicked => { root.toggle-loop-requested(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Shut down Runtime"; clicked => { root.quit-requested(); } }
        }
    }
}
