{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyper-module.invalid/schemas/v1/recording-metadata.schema.json",
  "title": "Hyper Module finalized recording metadata version 1",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "id",
    "project_id",
    "asset_id",
    "track_id",
    "capture_kind",
    "captured_at_utc",
    "timeline_start_tick",
    "source_input_indices",
    "sample_rate_hz",
    "channels",
    "frame_count",
    "extensions"
  ],
  "properties": {
    "format": {
      "const": "hyper-recording-metadata"
    },
    "format_version": {
      "const": 1
    },
    "id": {
      "$ref": "common.schema.json#/$defs/entity_id"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/entity_id"
    },
    "asset_id": {
      "$ref": "common.schema.json#/$defs/entity_id"
    },
    "track_id": {
      "$ref": "common.schema.json#/$defs/entity_id"
    },
    "capture_kind": {
      "enum": ["new", "overdub"]
    },
    "captured_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "timeline_start_tick": {
      "$ref": "common.schema.json#/$defs/safe_nonnegative_integer"
    },
    "source_input_indices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1
      }
    },
    "sample_rate_hz": {
      "const": 48000
    },
    "channels": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "frame_count": {
      "$ref": "common.schema.json#/$defs/safe_positive_integer"
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "additionalProperties": false
}
